{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://effortlessmetrics.dev/schemas/cargo-allow/receipt.v1.schema.json",
  "title": "cargo-allow receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema_id",
    "tool",
    "command",
    "status",
    "failed",
    "claim_boundary",
    "scanner_limitations",
    "inventory",
    "counts",
    "advisory"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "schema_id": {
      "const": "cargo-allow.receipt.v1"
    },
    "tool": {
      "const": "cargo-allow"
    },
    "command": {
      "enum": ["check", "diff"],
      "description": "Receipts are emitted by cargo-allow check or diff."
    },
    "status": {
      "enum": ["passed", "failed", "error"]
    },
    "failed": {
      "type": "boolean"
    },
    "claim_boundary": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim_boundary_flag"
      },
      "examples": [
        [
          "source_tree_inventory",
          "source_syntax_only",
          "cargo_metadata_not_invoked",
          "cargo_commands_not_invoked",
          "repository_code_not_executed"
        ]
      ],
      "contains": {
        "const": "source_tree_inventory"
      }
    },
    "scanner_limitations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scanner_limitation"
      },
      "examples": [
        [
          "cargo_metadata_not_invoked",
          "cargo_commands_not_invoked",
          "rustc_not_invoked",
          "clippy_not_invoked",
          "build_scripts_not_executed",
          "proc_macros_not_executed",
          "macro_expansion_not_analyzed",
          "macro_token_tree_contents_not_analyzed"
        ]
      ],
      "allOf": [
        {
          "contains": {
            "const": "macro_expansion_not_analyzed"
          }
        },
        {
          "contains": {
            "const": "macro_token_tree_contents_not_analyzed"
          }
        }
      ]
    },
    "inventory": {
      "$ref": "#/$defs/inventory"
    },
    "mode": {
      "type": "string",
      "description": "Effective check mode that governed this run."
    },
    "enforcement": {
      "enum": ["advisory", "enforcing"],
      "description": "Whether the effective mode treated findings as advisory or enforcing."
    },
    "policy_config": {
      "type": "string",
      "minLength": 1,
      "description": "Policy file path loaded for this run, when known."
    },
    "tool_version": {
      "type": "string",
      "minLength": 1,
      "description": "cargo-allow version that produced this receipt."
    },
    "lane_posture": {
      "type": ["object", "null"],
      "description": "Per-lane enforcement posture map when a policy declares lanes.",
      "additionalProperties": {
        "type": "string",
        "enum": ["advisory", "shadow", "blocking"]
      }
    },
    "git_sha": {
      "type": ["string", "null"],
      "description": "Git commit SHA at scan time, for receipt provenance binding."
    },
    "policy_digest": {
      "type": ["string", "null"],
      "description": "SHA-256 hex digest of the policy file content at scan time."
    },
    "started_at": {
      "type": ["string", "null"],
      "description": "RFC 3339 UTC timestamp of when the run started. Receipts with timestamps are NOT byte-stable across runs."
    },
    "run_id": {
      "type": ["string", "null"],
      "description": "Unique run identifier for correlating a receipt to a specific CI run/invocation."
    },
    "federation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "federation_version": { "type": "string" },
        "precedence_applied": { "type": "string" },
        "ledger_contributors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "path", "role", "dialect", "mode", "priority", "lanes"],
            "properties": {
              "id": { "type": "string" },
              "path": { "type": "string" },
              "role": { "type": "string" },
              "dialect": { "type": "string" },
              "mode": { "type": "string" },
              "priority": { "type": "integer", "minimum": 0 },
              "lanes": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        },
        "divergence_summary": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "counts_by_kind": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "count"],
                "properties": {
                  "kind": { "type": "string" },
                  "count": { "type": "integer", "minimum": 0 }
                }
              }
            },
            "records": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "message",
                  "canonical_ledger_id",
                  "mirror_ledger_id",
                  "canonical_path",
                  "mirror_path",
                  "sample_entry_ids",
                  "recommended_action"
                ],
                "properties": {
                  "kind": { "type": "string" },
                  "message": { "type": "string" },
                  "canonical_ledger_id": { "type": "string" },
                  "mirror_ledger_id": { "type": "string" },
                  "canonical_path": { "type": "string" },
                  "mirror_path": { "type": "string" },
                  "sample_entry_ids": {
                    "type": "array",
                    "items": { "type": "string" }
                  },
                  "canonical_fingerprint": { "type": "string" },
                  "mirror_fingerprint": { "type": "string" },
                  "recommended_action": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    "diagnostic": {
      "type": "string",
      "description": "Machine-readable validation or configuration error for status=error receipts."
    },
    "counts": {
      "$ref": "#/$defs/counts"
    },
    "advisory": {
      "$ref": "#/$defs/advisory"
    },
    "evidence_repair_queues": {
      "type": "array",
      "description": "Optional evidence-health repair queues emitted when check or diff receipts include broken local evidence links, missing evidence, or weak evidence references.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["signal", "count", "command"],
        "properties": {
          "signal": {
            "enum": [
              "broken_evidence_links",
              "missing_evidence",
              "weak_evidence_references",
              "occurrence_headroom"
            ],
            "description": "Evidence-health signal routed by this queue."
          },
          "label": {
            "type": "string",
            "description": "Human-friendly queue label for display and agent logs."
          },
          "route_kind": {
            "enum": [
              "worklist_item_kind",
              "worklist_filter"
            ],
            "description": "Machine routing mode for the follow-up command."
          },
          "item_kind": {
            "enum": [
              "broken_evidence_link",
              "missing_evidence",
              "weak_evidence_reference",
              "occurrence_headroom"
            ],
            "description": "Stable cargo-allow worklist item kind routed by this queue when available."
          },
          "worklist_filter": {
            "enum": [
              "broken_evidence",
              "missing_evidence",
              "weak_evidence"
            ],
            "description": "Named worklist filter used by this row when route_kind is worklist_filter."
          },
          "count": {
            "type": "integer",
            "minimum": 0,
            "description": "Number of receipt evidence-health items routed by this queue."
          },
          "command": {
            "type": "string",
            "description": "Suggested cargo-allow worklist command for this queue."
          }
        }
      }
    },
    "source_inventory": {
      "$ref": "#/$defs/source_inventory",
      "description": "Optional source exception inventory grouped by governed exception kind and kind.family for check or diff receipts that include scanned findings."
    }
  },
  "$defs": {
    "claim_boundary_flag": {
      "type": "string",
      "enum": [
        "source_tree_inventory",
        "source_syntax_only",
        "cargo_metadata_not_invoked",
        "cargo_commands_not_invoked",
        "rustc_not_invoked",
        "clippy_not_invoked",
        "build_scripts_not_executed",
        "proc_macros_not_executed",
        "macro_expansion_not_analyzed",
        "macro_token_tree_contents_not_analyzed",
        "type_information_not_analyzed",
        "mir_not_analyzed",
        "build_output_not_analyzed",
        "control_flow_not_analyzed",
        "data_flow_not_analyzed",
        "external_evidence_tools_not_invoked",
        "repository_code_not_executed",
        "source_text_in_identity_fields"
      ]
    },
    "scanner_limitation": {
      "type": "string",
      "enum": [
        "cargo_metadata_not_invoked",
        "cargo_commands_not_invoked",
        "rustc_not_invoked",
        "clippy_not_invoked",
        "build_scripts_not_executed",
        "proc_macros_not_executed",
        "macro_expansion_not_analyzed",
        "macro_token_tree_contents_not_analyzed",
        "type_information_not_analyzed",
        "mir_not_analyzed",
        "build_output_not_analyzed",
        "control_flow_not_analyzed",
        "data_flow_not_analyzed",
        "external_evidence_tools_not_invoked",
        "repository_code_not_executed"
      ]
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "scanner", "source"],
      "properties": {
        "scope": {
          "const": "source_tree"
        },
        "scanner": {
          "const": "source_syntax"
        },
        "source": {
          "enum": [
            "unknown",
            "git_tracked",
            "git_index_staged_candidate",
            "filesystem_fallback",
            "filesystem_include_untracked"
          ]
        },
        "root": {
          "type": "string",
          "minLength": 1,
          "description": "Local source-tree root used for this scan. This may be an absolute path in local artifacts."
        },
        "files_scanned": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of source-tree inventory files considered before scanner filtering, when a full inventory was collected."
        },
        "empty_git_tracked": {
          "type": "boolean",
          "description": "True when git inventory succeeded but reported no tracked files, such as a freshly initialized repo before git add."
        },
        "completeness": {
          "type": "string",
          "enum": ["complete", "scoped", "fallback", "partial"],
          "description": "Authoritative inventory coverage classification for this artifact."
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "matched",
        "new",
        "expired",
        "review_due",
        "location_drift",
        "stale",
        "ambiguous",
        "invalid_selector",
        "missing_required_field",
        "evidence_missing",
        "baseline_debt"
      ],
      "properties": {
        "matched": {
          "type": "integer",
          "minimum": 0
        },
        "new": {
          "type": "integer",
          "minimum": 0
        },
        "expired": {
          "type": "integer",
          "minimum": 0
        },
        "review_due": {
          "type": "integer",
          "minimum": 0
        },
        "location_drift": {
          "type": "integer",
          "minimum": 0
        },
        "stale": {
          "type": "integer",
          "minimum": 0
        },
        "ambiguous": {
          "type": "integer",
          "minimum": 0
        },
        "invalid_selector": {
          "type": "integer",
          "minimum": 0
        },
        "missing_required_field": {
          "type": "integer",
          "minimum": 0
        },
        "evidence_missing": {
          "type": "integer",
          "minimum": 0
        },
        "baseline_debt": {
          "type": "integer",
          "minimum": 0
        },
        "policy_baseline_debt": {
          "type": "integer",
          "minimum": 0,
          "description": "Policy-level baseline_debt entries retained in the scanned policy. This is distinct from outcome-level baseline_debt status and is present when retained generated debt would otherwise be hidden by matched outcomes."
        },
        "policy_missing_evidence": {
          "type": "integer",
          "minimum": 0,
          "description": "Policy-level allow entries with no evidence references. This is distinct from outcome-level evidence_missing status and is present when retained evidence gaps would otherwise be hidden by matched outcomes."
        },
        "broken_evidence_links": {
          "type": "integer",
          "minimum": 0,
          "description": "Optional count of missing or invalid local evidence or link references found while auditing policy evidence."
        },
        "weak_evidence_references": {
          "type": "integer",
          "minimum": 0,
          "description": "Optional count of unstructured or unknown-prefix evidence or link references. These strings are retained as traceability but are not recognized as typed evidence by cargo-allow."
        }
      }
    },
    "advisory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_items",
        "new",
        "expired",
        "review_due",
        "location_drift",
        "stale",
        "ambiguous",
        "invalid_selector",
        "missing_required_field",
        "evidence_missing",
        "baseline_debt"
      ],
      "properties": {
        "review_items": {
          "type": "integer",
          "minimum": 0,
          "description": "Total review-oriented items for ratcheting, including policy-level baseline debt inventory when available."
        },
        "new": {
          "type": "integer",
          "minimum": 0
        },
        "expired": {
          "type": "integer",
          "minimum": 0
        },
        "review_due": {
          "type": "integer",
          "minimum": 0
        },
        "location_drift": {
          "type": "integer",
          "minimum": 0
        },
        "stale": {
          "type": "integer",
          "minimum": 0
        },
        "ambiguous": {
          "type": "integer",
          "minimum": 0
        },
        "invalid_selector": {
          "type": "integer",
          "minimum": 0
        },
        "missing_required_field": {
          "type": "integer",
          "minimum": 0
        },
        "evidence_missing": {
          "type": "integer",
          "minimum": 0
        },
        "baseline_debt": {
          "type": "integer",
          "minimum": 0,
          "description": "Policy-level count of generated baseline_debt entries when available; otherwise the baseline_debt outcome count."
        },
        "policy_missing_evidence": {
          "type": "integer",
          "minimum": 0,
          "description": "Optional policy-level count of allow entries with no evidence references included in review item totals when available."
        },
        "broken_evidence_links": {
          "type": "integer",
          "minimum": 0,
          "description": "Optional count of missing or invalid local evidence or link references included in review item totals when available."
        },
        "weak_evidence_references": {
          "type": "integer",
          "minimum": 0,
          "description": "Optional count of unstructured or unknown-prefix evidence or link references included in review item totals when available."
        },
        "mirror_divergence": {
          "type": "integer",
          "minimum": 0,
          "description": "Optional advisory count of canonical versus mirror ledger divergences during active drain windows (mirror_divergence / mirror_stale)."
        },
        "blocking_divergence": {
          "type": "integer",
          "minimum": 0,
          "description": "Optional count of blocking federation divergences (drain_expired) that fail the run; emitted only when non-zero so a blocking divergence is not hidden behind a zero advisory count."
        }
      }
    },
    "source_inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["findings", "by_kind", "by_family"],
      "properties": {
        "findings": {
          "type": "integer",
          "minimum": 0,
          "description": "Total number of syntax-visible source exception findings included in this report."
        },
        "by_kind": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_inventory_kind_row"
          }
        },
        "by_family": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_inventory_family_row"
          }
        }
      }
    },
    "source_inventory_kind_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "total", "matched", "new", "review_items"],
      "properties": {
        "kind": {
          "$ref": "#/$defs/governed_source_exception_kind"
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "matched": {
          "type": "integer",
          "minimum": 0
        },
        "new": {
          "type": "integer",
          "minimum": 0
        },
        "review_items": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "source_inventory_family_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "family",
        "label",
        "total",
        "matched",
        "new",
        "review_items"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/governed_source_exception_kind"
        },
        "family": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "description": "Human-friendly kind.family label used by text and Markdown reports."
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "matched": {
          "type": "integer",
          "minimum": 0
        },
        "new": {
          "type": "integer",
          "minimum": 0
        },
        "review_items": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "governed_source_exception_kind": {
      "type": "string",
      "enum": [
        "panic",
        "unsafe",
        "lint_exception",
        "non_rust_file",
        "generated_code",
        "policy_exception"
      ]
    }
  }
}

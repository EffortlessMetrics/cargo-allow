{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://effortlessmetrics.dev/schemas/cargo-allow/receipt.v1.schema.json",
  "title": "cargo-allow receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema_id",
    "tool",
    "command",
    "status",
    "failed",
    "claim_boundary",
    "scanner_limitations",
    "inventory",
    "counts"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "schema_id": {
      "const": "cargo-allow.receipt.v1"
    },
    "tool": {
      "const": "cargo-allow"
    },
    "command": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": ["passed", "failed"]
    },
    "failed": {
      "type": "boolean"
    },
    "claim_boundary": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim_boundary_flag"
      },
      "examples": [
        [
          "source_tree_inventory",
          "source_syntax_only",
          "cargo_metadata_not_invoked",
          "cargo_commands_not_invoked",
          "repository_code_not_executed"
        ]
      ],
      "contains": {
        "const": "source_tree_inventory"
      }
    },
    "scanner_limitations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scanner_limitation"
      },
      "examples": [
        [
          "cargo_metadata_not_invoked",
          "cargo_commands_not_invoked",
          "rustc_not_invoked",
          "clippy_not_invoked",
          "build_scripts_not_executed",
          "proc_macros_not_executed",
          "macro_expansion_not_analyzed",
          "macro_token_tree_contents_not_analyzed"
        ]
      ],
      "allOf": [
        {
          "contains": {
            "const": "macro_expansion_not_analyzed"
          }
        },
        {
          "contains": {
            "const": "macro_token_tree_contents_not_analyzed"
          }
        }
      ]
    },
    "inventory": {
      "$ref": "#/$defs/inventory"
    },
    "counts": {
      "$ref": "#/$defs/counts"
    }
  },
  "$defs": {
    "claim_boundary_flag": {
      "type": "string",
      "enum": [
        "source_tree_inventory",
        "source_syntax_only",
        "cargo_metadata_not_invoked",
        "cargo_commands_not_invoked",
        "rustc_not_invoked",
        "clippy_not_invoked",
        "build_scripts_not_executed",
        "proc_macros_not_executed",
        "macro_expansion_not_analyzed",
        "macro_token_tree_contents_not_analyzed",
        "type_information_not_analyzed",
        "mir_not_analyzed",
        "build_output_not_analyzed",
        "control_flow_not_analyzed",
        "data_flow_not_analyzed",
        "repository_code_not_executed"
      ]
    },
    "scanner_limitation": {
      "type": "string",
      "enum": [
        "cargo_metadata_not_invoked",
        "cargo_commands_not_invoked",
        "rustc_not_invoked",
        "clippy_not_invoked",
        "build_scripts_not_executed",
        "proc_macros_not_executed",
        "macro_expansion_not_analyzed",
        "macro_token_tree_contents_not_analyzed",
        "type_information_not_analyzed",
        "mir_not_analyzed",
        "build_output_not_analyzed",
        "control_flow_not_analyzed",
        "data_flow_not_analyzed",
        "repository_code_not_executed"
      ]
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "scanner", "source"],
      "properties": {
        "scope": {
          "const": "source_tree"
        },
        "scanner": {
          "const": "source_syntax"
        },
        "source": {
          "enum": [
            "unknown",
            "git_tracked",
            "filesystem_fallback",
            "filesystem_include_untracked"
          ]
        },
        "root": {
          "type": "string",
          "minLength": 1,
          "description": "Local source-tree root used for this scan. This may be an absolute path in local artifacts."
        },
        "files_scanned": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of source-tree inventory files considered before scanner filtering, when a full inventory was collected."
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "matched",
        "new",
        "expired",
        "review_due",
        "stale",
        "ambiguous",
        "invalid_selector",
        "missing_required_field",
        "evidence_missing",
        "baseline_debt"
      ],
      "properties": {
        "matched": {
          "type": "integer",
          "minimum": 0
        },
        "new": {
          "type": "integer",
          "minimum": 0
        },
        "expired": {
          "type": "integer",
          "minimum": 0
        },
        "review_due": {
          "type": "integer",
          "minimum": 0
        },
        "stale": {
          "type": "integer",
          "minimum": 0
        },
        "ambiguous": {
          "type": "integer",
          "minimum": 0
        },
        "invalid_selector": {
          "type": "integer",
          "minimum": 0
        },
        "missing_required_field": {
          "type": "integer",
          "minimum": 0
        },
        "evidence_missing": {
          "type": "integer",
          "minimum": 0
        },
        "baseline_debt": {
          "type": "integer",
          "minimum": 0
        },
        "policy_baseline_debt": {
          "type": "integer",
          "minimum": 0,
          "description": "Policy-level baseline_debt entries retained in the scanned policy. This is distinct from outcome-level baseline_debt status and is present when retained generated debt would otherwise be hidden by matched outcomes."
        },
        "policy_missing_evidence": {
          "type": "integer",
          "minimum": 0,
          "description": "Policy-level allow entries with no evidence references. This is distinct from outcome-level evidence_missing status and is present when retained evidence gaps would otherwise be hidden by matched outcomes."
        },
        "broken_evidence_links": {
          "type": "integer",
          "minimum": 0,
          "description": "Optional count of missing or invalid local evidence references found while auditing policy evidence."
        },
        "weak_evidence_references": {
          "type": "integer",
          "minimum": 0,
          "description": "Optional count of unstructured or unknown-prefix evidence references. These evidence strings are retained as traceability but are not recognized as typed evidence by cargo-allow."
        }
      }
    }
  }
}

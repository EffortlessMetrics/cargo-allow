{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://effortlessmetrics.dev/schemas/cargo-allow/add.v1.schema.json",
  "title": "cargo-allow add v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema_id",
    "tool",
    "command",
    "claim_boundary",
    "scanner_limitations",
    "inventory",
    "mutation_receipt",
    "options",
    "summary",
    "allow_entry",
    "selected_finding"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "schema_id": {
      "const": "cargo-allow.add.v1"
    },
    "tool": {
      "const": "cargo-allow"
    },
    "command": {
      "const": "add"
    },
    "claim_boundary": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim_boundary_flag"
      }
    },
    "scanner_limitations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scanner_limitation"
      }
    },
    "inventory": {
      "$ref": "#/$defs/inventory"
    },
    "mutation_receipt": {
      "$ref": "#/$defs/mutation_receipt"
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "policy_output": {
          "type": [
            "string",
            "null"
          ],
          "description": "Path where proposed TOML policy was written, or null when policy output went to stdout."
        },
        "force": {
          "type": "boolean"
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_id",
        "selected_finding",
        "human_review_required"
      ],
      "properties": {
        "entry_id": {
          "type": "string"
        },
        "selected_finding": {
          "type": "string"
        },
        "human_review_required": {
          "const": true
        }
      }
    },
    "allow_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "family",
        "path",
        "glob",
        "owner",
        "classification",
        "reason",
        "review_after",
        "expires",
        "evidence_count",
        "selector",
        "last_seen"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "panic",
            "unsafe",
            "lint_exception",
            "non_rust_file",
            "generated_code",
            "policy_exception"
          ]
        },
        "family": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "glob": {
          "type": [
            "string",
            "null"
          ]
        },
        "owner": {
          "type": "string"
        },
        "classification": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "review_after": {
          "type": [
            "string",
            "null"
          ]
        },
        "expires": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_count": {
          "type": "integer",
          "minimum": 0
        },
        "selector": {
          "$ref": "#/$defs/selector"
        },
        "last_seen": {
          "anyOf": [
            {
              "$ref": "#/$defs/span"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "selected_finding": {
      "$ref": "#/$defs/finding"
    }
  },
  "$defs": {
    "mutation_receipt": {
      "type": "object",
      "additionalProperties": false,
      "description": "Shared provenance envelope for mutation commands (CARGO-ALLOW-SPEC-0008 \"Mutation Receipt Envelope\", GOAL-0004 PR 5). Provenance and changed-entry metadata only; does not itself validate entry correctness or authorize merge.",
      "required": [
        "schema_id",
        "operation",
        "tool_version",
        "repo_root",
        "config_source",
        "ledger_ids",
        "changed_allow_ids",
        "before_fingerprints",
        "after_fingerprints",
        "result",
        "next_commands",
        "claim_boundary"
      ],
      "properties": {
        "schema_id": {
          "const": "cargo-allow.mutation-receipt.v1"
        },
        "operation": {
          "type": "string"
        },
        "tool_version": {
          "type": "string"
        },
        "repo_root": {
          "type": ["string", "null"]
        },
        "config_source": {
          "type": ["string", "null"]
        },
        "ledger_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "changed_allow_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "before_fingerprints": {
          "type": "array",
          "items": {
            "type": ["string", "null"],
            "pattern": "^sha256:v1:[0-9a-f]{64}$"
          },
          "description": "Parallel to changed_allow_ids. null for an entry with no prior state; otherwise a sha256:v1 fingerprint over the canonical AllowEntry serialization."
        },
        "after_fingerprints": {
          "type": "array",
          "items": {
            "type": ["string", "null"],
            "pattern": "^sha256:v1:[0-9a-f]{64}$"
          },
          "description": "Parallel to changed_allow_ids; non-null values are sha256:v1 fingerprints over the canonical AllowEntry serialization."
        },
        "result": {
          "type": "string"
        },
        "next_commands": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "claim_boundary": {
          "type": "string"
        }
      }
    },
    "claim_boundary_flag": {
      "type": "string",
      "enum": [
        "source_tree_inventory",
        "source_syntax_only",
        "cargo_metadata_not_invoked",
        "cargo_commands_not_invoked",
        "rustc_not_invoked",
        "clippy_not_invoked",
        "build_scripts_not_executed",
        "proc_macros_not_executed",
        "macro_expansion_not_analyzed",
        "macro_token_tree_contents_not_analyzed",
        "type_information_not_analyzed",
        "mir_not_analyzed",
        "build_output_not_analyzed",
        "control_flow_not_analyzed",
        "data_flow_not_analyzed",
        "external_evidence_tools_not_invoked",
        "repository_code_not_executed",
        "source_text_in_identity_fields"
      ]
    },
    "scanner_limitation": {
      "type": "string",
      "enum": [
        "cargo_metadata_not_invoked",
        "cargo_commands_not_invoked",
        "rustc_not_invoked",
        "clippy_not_invoked",
        "build_scripts_not_executed",
        "proc_macros_not_executed",
        "macro_expansion_not_analyzed",
        "macro_token_tree_contents_not_analyzed",
        "type_information_not_analyzed",
        "mir_not_analyzed",
        "build_output_not_analyzed",
        "control_flow_not_analyzed",
        "data_flow_not_analyzed",
        "external_evidence_tools_not_invoked",
        "repository_code_not_executed"
      ]
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "scanner",
        "source"
      ],
      "properties": {
        "scope": {
          "const": "source_tree"
        },
        "scanner": {
          "const": "source_syntax"
        },
        "source": {
          "enum": [
            "git_tracked",
            "git_index_staged_candidate",
            "filesystem_fallback",
            "filesystem_include_untracked",
            "unknown"
          ]
        },
        "root": {
          "type": "string",
          "minLength": 1,
          "description": "Local source-tree root used for this add summary. This may be an absolute path."
        },
        "files_scanned": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of source-tree inventory files considered before scanner filtering, when collected."
        },
        "empty_git_tracked": {
          "type": "boolean",
          "description": "True when git inventory succeeded but reported no tracked files, such as a freshly initialized repo before git add."
        },
        "completeness": {
          "type": "string",
          "enum": ["complete", "scoped", "fallback", "partial"],
          "description": "Authoritative inventory coverage classification for this artifact."
        }
      }
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ast_kind",
        "container",
        "callee",
        "macro_name",
        "lint",
        "symbol",
        "receiver_fingerprint",
        "target_fingerprint",
        "normalized_snippet_hash",
        "line_hint",
        "glob"
      ],
      "properties": {
        "ast_kind": {
          "type": [
            "string",
            "null"
          ]
        },
        "container": {
          "type": [
            "string",
            "null"
          ]
        },
        "callee": {
          "type": [
            "string",
            "null"
          ]
        },
        "macro_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "lint": {
          "type": [
            "string",
            "null"
          ]
        },
        "symbol": {
          "type": [
            "string",
            "null"
          ]
        },
        "receiver_fingerprint": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_fingerprint": {
          "type": [
            "string",
            "null"
          ]
        },
        "normalized_snippet_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "line_hint": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "description": "Optional one-based source line hint for review only; structural selector fields remain the durable identity."
        },
        "glob": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "line",
        "column"
      ],
      "properties": {
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "kind",
        "path",
        "line",
        "column",
        "identity",
        "message"
      ],
      "properties": {
        "status": {
          "const": "selected"
        },
        "kind": {
          "enum": [
            "panic",
            "unsafe",
            "lint_exception",
            "non_rust_file",
            "generated_code",
            "policy_exception"
          ]
        },
        "family": {
          "type": "string",
          "description": "Scanner-provided finding family; omitted when unavailable."
        },
        "path": {
          "type": "string"
        },
        "line": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "description": "One-based source line for review/navigation when available."
        },
        "column": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "description": "One-based source character column for review/navigation when available."
        },
        "source_package": {
          "type": "string",
          "description": "Scanner-provided source package context; omitted when unavailable and not Cargo metadata or build proof."
        },
        "identity": {
          "$ref": "#/$defs/structural_identity"
        },
        "message": {
          "type": "string"
        },
        "ledger_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "ledger_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "lane": {
          "type": [
            "string",
            "null"
          ]
        },
        "mode": {
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "structural_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language",
        "crate_name",
        "module",
        "container",
        "ast_kind",
        "symbol",
        "callee",
        "macro_name",
        "lint",
        "receiver_fingerprint",
        "target_fingerprint",
        "normalized_snippet_hash",
        "line_hint",
        "column_hint"
      ],
      "properties": {
        "language": {
          "type": "string"
        },
        "crate_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "module": {
          "type": [
            "string",
            "null"
          ]
        },
        "container": {
          "type": [
            "string",
            "null"
          ]
        },
        "ast_kind": {
          "type": "string"
        },
        "symbol": {
          "type": [
            "string",
            "null"
          ]
        },
        "callee": {
          "type": [
            "string",
            "null"
          ]
        },
        "macro_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "lint": {
          "type": [
            "string",
            "null"
          ]
        },
        "receiver_fingerprint": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_fingerprint": {
          "type": [
            "string",
            "null"
          ]
        },
        "normalized_snippet_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "line_hint": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "description": "Optional one-based source line hint for review/navigation only; excluded from stable identity."
        },
        "column_hint": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "description": "Optional one-based source character-column hint for review/navigation only; excluded from stable identity."
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://effortlessmetrics.dev/schemas/cargo-allow/explain.v1.schema.json",
  "title": "cargo-allow explain v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema_id",
    "tool",
    "command",
    "claim_boundary",
    "scanner_limitations",
    "inventory",
    "allow_entry",
    "summary",
    "evidence_references",
    "current_findings",
    "match_outcomes",
    "next"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "schema_id": {
      "const": "cargo-allow.explain.v1"
    },
    "tool": {
      "const": "cargo-allow"
    },
    "command": {
      "const": "explain"
    },
    "claim_boundary": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim_boundary_flag"
      }
    },
    "scanner_limitations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scanner_limitation"
      }
    },
    "inventory": {
      "$ref": "#/$defs/inventory"
    },
    "allow_entry": {
      "$ref": "#/$defs/allow_entry"
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current_status",
        "current_matches",
        "match_outcomes",
        "selector_precision",
        "broad_scope"
      ],
      "properties": {
        "current_status": {
          "$ref": "#/$defs/match_status"
        },
        "current_matches": {
          "type": "integer",
          "minimum": 0
        },
        "match_outcomes": {
          "type": "integer",
          "minimum": 0
        },
        "selector_precision": {
          "type": "integer",
          "minimum": 0,
          "description": "Relative selector precision score for the explained allow entry. Higher values indicate a more specific source-tree selector; line and column hints do not increase this score."
        },
        "broad_scope": {
          "type": "boolean",
          "description": "Whether the explained allow entry uses wildcard source-tree scope in path, glob, or selector glob."
        }
      }
    },
    "evidence_references": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence_reference"
      }
    },
    "link_references": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence_reference"
      },
      "description": "Optional diagnostics for policy links that use evidence-style typed references. Local-file links are checked against the source-tree inventory; traceability-only links are not executed or resolved."
    },
    "current_findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/current_finding"
      }
    },
    "match_outcomes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/match_outcome"
      }
    },
    "next": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "suggested_actions",
        "proof_commands"
      ],
      "properties": {
        "suggested_actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "proof_commands": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^cargo-allow ",
            "description": "Suggested follow-up command. cargo-allow emits standalone cargo-allow commands here; it does not execute them."
          }
        }
      }
    }
  },
  "$defs": {
    "claim_boundary_flag": {
      "type": "string",
      "enum": [
        "source_tree_inventory",
        "source_syntax_only",
        "cargo_metadata_not_invoked",
        "cargo_commands_not_invoked",
        "rustc_not_invoked",
        "clippy_not_invoked",
        "build_scripts_not_executed",
        "proc_macros_not_executed",
        "macro_expansion_not_analyzed",
        "macro_token_tree_contents_not_analyzed",
        "type_information_not_analyzed",
        "mir_not_analyzed",
        "build_output_not_analyzed",
        "control_flow_not_analyzed",
        "data_flow_not_analyzed",
        "external_evidence_tools_not_invoked",
        "repository_code_not_executed",
        "source_text_in_identity_fields"
      ]
    },
    "scanner_limitation": {
      "type": "string",
      "enum": [
        "cargo_metadata_not_invoked",
        "cargo_commands_not_invoked",
        "rustc_not_invoked",
        "clippy_not_invoked",
        "build_scripts_not_executed",
        "proc_macros_not_executed",
        "macro_expansion_not_analyzed",
        "macro_token_tree_contents_not_analyzed",
        "type_information_not_analyzed",
        "mir_not_analyzed",
        "build_output_not_analyzed",
        "control_flow_not_analyzed",
        "data_flow_not_analyzed",
        "external_evidence_tools_not_invoked",
        "repository_code_not_executed"
      ]
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "scanner",
        "source"
      ],
      "properties": {
        "scope": {
          "const": "source_tree"
        },
        "scanner": {
          "const": "source_syntax"
        },
        "source": {
          "enum": [
            "git_tracked",
            "git_index_staged_candidate",
            "filesystem_fallback",
            "filesystem_include_untracked",
            "unknown"
          ]
        },
        "root": {
          "type": "string",
          "minLength": 1,
          "description": "Local source-tree root used for this explanation. This may be an absolute path."
        },
        "files_scanned": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of source-tree inventory files considered before scanner filtering, when collected."
        },
        "empty_git_tracked": {
          "type": "boolean",
          "description": "True when git inventory succeeded but reported no tracked files, such as a freshly initialized repo before git add."
        },
        "completeness": {
          "type": "string",
          "enum": ["complete", "scoped", "fallback", "partial"],
          "description": "Authoritative inventory coverage classification for this artifact."
        }
      }
    },
    "allow_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "scope",
        "path",
        "glob",
        "owner",
        "classification",
        "reason",
        "evidence",
        "links",
        "occurrence_limit",
        "lifecycle",
        "selector",
        "last_seen"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "panic",
            "unsafe",
            "lint_exception",
            "non_rust_file",
            "generated_code",
            "policy_exception"
          ]
        },
        "family": {
          "type": "string",
          "description": "Policy family; omitted when unavailable."
        },
        "scope": {
          "type": "string"
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "glob": {
          "type": [
            "string",
            "null"
          ]
        },
        "owner": {
          "type": "string"
        },
        "classification": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "links": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "occurrence_limit": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 10000,
          "description": "Optional matched-finding count cap for counted baselines. Runtime rejects 0 and values above OCCURRENCE_LIMIT_MAX (10000)."
        },
        "lifecycle": {
          "$ref": "#/$defs/lifecycle"
        },
        "selector": {
          "$ref": "#/$defs/selector"
        },
        "last_seen": {
          "anyOf": [
            {
              "$ref": "#/$defs/span"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "created": {
          "type": "string",
          "description": "Creation date; omitted when unavailable."
        },
        "review_after": {
          "type": "string",
          "description": "Review date; omitted when unavailable."
        },
        "expires": {
          "type": "string",
          "description": "Expiry date; omitted when unavailable."
        }
      }
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ast_kind",
        "container",
        "callee",
        "macro_name",
        "lint",
        "symbol",
        "receiver_fingerprint",
        "target_fingerprint",
        "normalized_snippet_hash",
        "line_hint",
        "glob"
      ],
      "properties": {
        "ast_kind": {
          "type": [
            "string",
            "null"
          ]
        },
        "container": {
          "type": [
            "string",
            "null"
          ]
        },
        "callee": {
          "type": [
            "string",
            "null"
          ]
        },
        "macro_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "lint": {
          "type": [
            "string",
            "null"
          ]
        },
        "symbol": {
          "type": [
            "string",
            "null"
          ]
        },
        "receiver_fingerprint": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_fingerprint": {
          "type": [
            "string",
            "null"
          ]
        },
        "normalized_snippet_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "line_hint": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "description": "Optional one-based source line hint for review only; structural selector fields remain the durable identity."
        },
        "glob": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "evidence_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw",
        "prefix",
        "target",
        "status",
        "message"
      ],
      "properties": {
        "raw": {
          "type": "string",
          "minLength": 1
        },
        "prefix": {
          "type": [
            "string",
            "null"
          ]
        },
        "target": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "$ref": "#/$defs/evidence_reference_status"
        },
        "category": {
          "$ref": "#/$defs/evidence_reference_category",
          "description": "Optional structured diagnostic category. Current producers emit it; it remains optional for v1 compatibility with older artifacts. Human renderers may map this machine vocabulary to friendlier labels."
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidence_reference_category": {
      "type": "string",
      "enum": [
        "present",
        "missing",
        "invalid_local_path",
        "not_local",
        "unknown_prefix",
        "untyped"
      ],
      "description": "Structured diagnostic category for evidence references. This preserves the stable status field while distinguishing weak evidence causes such as unknown prefixes and untyped strings. Human renderers may map these values to friendlier labels."
    },
    "evidence_reference_status": {
      "type": "string",
      "enum": [
        "local_file_present",
        "local_file_missing",
        "invalid_local_path",
        "traceability_only",
        "unstructured"
      ]
    },
    "current_finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "kind",
        "path",
        "line",
        "column",
        "identity",
        "message"
      ],
      "properties": {
        "status": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "panic",
            "unsafe",
            "lint_exception",
            "non_rust_file",
            "generated_code",
            "policy_exception"
          ]
        },
        "family": {
          "type": "string",
          "description": "Scanner-provided finding family; omitted when unavailable."
        },
        "path": {
          "type": "string"
        },
        "line": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "description": "One-based source line for review/navigation when available."
        },
        "column": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "description": "One-based source character column for review/navigation when available."
        },
        "source_package": {
          "type": "string",
          "description": "Scanner-provided source package context; omitted when unavailable and not Cargo metadata or build proof."
        },
        "identity": {
          "$ref": "#/$defs/structural_identity"
        },
        "message": {
          "type": "string"
        },
        "ledger_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "ledger_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "lane": {
          "type": [
            "string",
            "null"
          ]
        },
        "mode": {
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "structural_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language",
        "crate_name",
        "module",
        "container",
        "ast_kind",
        "symbol",
        "callee",
        "macro_name",
        "lint",
        "receiver_fingerprint",
        "target_fingerprint",
        "normalized_snippet_hash",
        "line_hint",
        "column_hint"
      ],
      "properties": {
        "language": {
          "type": "string"
        },
        "crate_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "module": {
          "type": [
            "string",
            "null"
          ]
        },
        "container": {
          "type": [
            "string",
            "null"
          ]
        },
        "ast_kind": {
          "type": "string"
        },
        "symbol": {
          "type": [
            "string",
            "null"
          ]
        },
        "callee": {
          "type": [
            "string",
            "null"
          ]
        },
        "macro_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "lint": {
          "type": [
            "string",
            "null"
          ]
        },
        "receiver_fingerprint": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_fingerprint": {
          "type": [
            "string",
            "null"
          ]
        },
        "normalized_snippet_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "line_hint": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "description": "Optional one-based source line hint for review/navigation only; excluded from stable identity."
        },
        "column_hint": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "description": "Optional one-based source character-column hint for review/navigation only; excluded from stable identity."
        }
      }
    },
    "match_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "allow_id",
        "finding_index",
        "score",
        "message"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/match_status"
        },
        "allow_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "candidate_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Structured candidate allow-entry IDs considered while resolving the finding. Ambiguous rows contain all tied candidates; an empty array means no policy candidates were considered."
        },
        "finding_index": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "score": {
          "type": "integer",
          "minimum": 0
        },
        "message": {
          "type": "string"
        }
      }
    },
    "match_status": {
      "enum": [
        "matched",
        "new",
        "stale",
        "expired",
        "review_due",
        "location_drift",
        "ambiguous",
        "invalid_selector",
        "missing_required_field",
        "evidence_missing",
        "baseline_debt"
      ]
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "line",
        "column"
      ],
      "properties": {
        "line": {
          "type": "integer",
          "minimum": 1,
          "description": "One-based source line for review/navigation."
        },
        "column": {
          "type": "integer",
          "minimum": 1,
          "description": "One-based source character column for review/navigation."
        }
      }
    }
  }
}

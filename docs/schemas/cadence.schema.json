{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://effortlessmetrics.dev/schemas/cargo-allow/cadence.v1.schema.json",
  "title": "cargo-allow cadence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema_id",
    "tool",
    "command",
    "as_of",
    "as_of_source",
    "horizons",
    "policy_path",
    "inventory",
    "rows",
    "summary",
    "claim_boundary",
    "scanner_limitations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "schema_id": {
      "const": "cargo-allow.cadence.v1"
    },
    "tool": {
      "const": "cargo-allow"
    },
    "command": {
      "const": "cadence"
    },
    "as_of": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "The single classification date every row was evaluated at."
    },
    "as_of_source": {
      "enum": [
        "explicit",
        "ambient_utc_day"
      ],
      "description": "Whether the as-of date came from an explicit --as-of value or from the documented approximate-UTC ambient day default."
    },
    "horizons": {
      "$ref": "#/$defs/horizons"
    },
    "policy_path": {
      "type": "string",
      "minLength": 1,
      "description": "Policy file the cadence classification read. Local artifacts may carry an absolute path."
    },
    "inventory": {
      "$ref": "#/$defs/inventory"
    },
    "rows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/row"
      }
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "claim_boundary": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim_boundary_flag"
      },
      "contains": {
        "const": "source_tree_inventory"
      }
    },
    "scanner_limitations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scanner_limitation"
      },
      "description": "Explicit scanner and execution limitations for this source-tree cadence artifact.",
      "contains": {
        "const": "cargo_metadata_not_invoked"
      }
    }
  },
  "$defs": {
    "claim_boundary_flag": {
      "type": "string",
      "enum": [
        "source_tree_inventory",
        "source_syntax_only",
        "cargo_metadata_not_invoked",
        "cargo_commands_not_invoked",
        "rustc_not_invoked",
        "clippy_not_invoked",
        "build_scripts_not_executed",
        "proc_macros_not_executed",
        "macro_expansion_not_analyzed",
        "macro_token_tree_contents_not_analyzed",
        "type_information_not_analyzed",
        "mir_not_analyzed",
        "build_output_not_analyzed",
        "control_flow_not_analyzed",
        "data_flow_not_analyzed",
        "external_evidence_tools_not_invoked",
        "repository_code_not_executed",
        "source_text_in_identity_fields"
      ]
    },
    "scanner_limitation": {
      "type": "string",
      "enum": [
        "cargo_metadata_not_invoked",
        "cargo_commands_not_invoked",
        "rustc_not_invoked",
        "clippy_not_invoked",
        "build_scripts_not_executed",
        "proc_macros_not_executed",
        "macro_expansion_not_analyzed",
        "macro_token_tree_contents_not_analyzed",
        "type_information_not_analyzed",
        "mir_not_analyzed",
        "build_output_not_analyzed",
        "control_flow_not_analyzed",
        "data_flow_not_analyzed",
        "external_evidence_tools_not_invoked",
        "repository_code_not_executed"
      ]
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "scanner",
        "source"
      ],
      "properties": {
        "scope": {
          "const": "source_tree"
        },
        "scanner": {
          "const": "source_syntax"
        },
        "source": {
          "enum": [
            "unknown",
            "git_tracked",
            "git_index_staged_candidate",
            "filesystem_fallback",
            "filesystem_include_untracked"
          ]
        },
        "root": {
          "type": "string",
          "minLength": 1,
          "description": "Local source-tree root used for this cadence run. This may be an absolute path in local artifacts."
        },
        "files_scanned": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of source-tree inventory files considered, when a full inventory was collected."
        },
        "empty_git_tracked": {
          "type": "boolean",
          "description": "True when git inventory succeeded but reported no tracked files."
        },
        "completeness": {
          "type": "string",
          "enum": ["complete", "scoped", "fallback", "partial"],
          "description": "Authoritative inventory coverage classification for this artifact."
        }
      }
    },
    "horizons": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_due_soon_days",
        "expiring_soon_days"
      ],
      "properties": {
        "review_due_soon_days": {
          "type": "integer",
          "minimum": 0,
          "description": "review_after within this many days after as_of classifies review_due_soon."
        },
        "expiring_soon_days": {
          "type": "integer",
          "minimum": 0,
          "description": "expires within this many days after as_of classifies expiring."
        }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allow_id",
        "class",
        "owner",
        "classification",
        "source_path",
        "source_glob",
        "selector_summary",
        "evidence_refs",
        "review_after",
        "expires",
        "days_remaining",
        "driving_date",
        "required_disposition"
      ],
      "properties": {
        "allow_id": {
          "type": "string",
          "minLength": 1,
          "description": "Durable allow entry id this row classifies."
        },
        "class": {
          "enum": [
            "current",
            "review_due_soon",
            "review_overdue",
            "expiring",
            "expired",
            "invalid"
          ],
          "description": "Exactly one lifecycle class per entry. invalid is fail-closed and unreachable for policies the loader accepted; loaded policies reject malformed and descending lifecycle dates at parse."
        },
        "owner": {
          "type": "string",
          "description": "Policy owner responsible for the entry's disposition."
        },
        "classification": {
          "type": "string",
          "description": "Policy classification, carrying the baseline_debt identity when present."
        },
        "source_path": {
          "type": [
            "string",
            "null"
          ],
          "description": "Entry source path identity, or null when the entry selects by glob instead."
        },
        "source_glob": {
          "type": [
            "string",
            "null"
          ],
          "description": "Entry glob identity, or null when the entry selects by exact path."
        },
        "selector_summary": {
          "type": "string",
          "description": "Deterministic selector identity summary: governed kind, optional family, then selector identity fields in fixed order."
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Evidence reference strings retained on the entry; the traceability identity the disposition points at."
        },
        "review_after": {
          "type": [
            "string",
            "null"
          ],
          "description": "Raw review_after date, or null when absent."
        },
        "expires": {
          "type": [
            "string",
            "null"
          ],
          "description": "Raw expires date, or null when absent. The documented immortal form never is retained verbatim and never expires."
        },
        "days_remaining": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Signed days from as_of to the driving date; negative means overdue. Null when no date drove the classification."
        },
        "driving_date": {
          "enum": [
            "expires",
            "review_after",
            "none"
          ],
          "description": "Which lifecycle date produced the class, or none for current and invalid rows."
        },
        "required_disposition": {
          "type": "string",
          "minLength": 1,
          "description": "The required operator disposition for the class. Scheduling guidance only; never a gate verdict."
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_entries",
        "current",
        "review_due_soon",
        "review_overdue",
        "expiring",
        "expired",
        "invalid"
      ],
      "properties": {
        "total_entries": {
          "type": "integer",
          "minimum": 0
        },
        "current": {
          "type": "integer",
          "minimum": 0
        },
        "review_due_soon": {
          "type": "integer",
          "minimum": 0
        },
        "review_overdue": {
          "type": "integer",
          "minimum": 0
        },
        "expiring": {
          "type": "integer",
          "minimum": 0
        },
        "expired": {
          "type": "integer",
          "minimum": 0
        },
        "invalid": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}

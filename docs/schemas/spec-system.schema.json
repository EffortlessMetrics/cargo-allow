{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://effortlessmetrics.dev/schemas/cargo-allow/spec-system.v1.schema.json",
  "title": "cargo-allow spec-system v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema_id",
    "tool",
    "command",
    "profile",
    "mode",
    "status",
    "failed",
    "claim_boundary",
    "scanner_limitations",
    "inventory",
    "source_tree_root",
    "config_source",
    "config_provenance",
    "summary",
    "artifacts",
    "links",
    "findings",
    "work_items"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "schema_id": {
      "const": "cargo-allow.spec-system.v1"
    },
    "tool": {
      "const": "cargo-allow"
    },
    "command": {
      "enum": [
        "check",
        "audit",
        "worklist",
        "doctor",
        "explain"
      ],
      "description": "Profile command that produced this source-of-truth graph artifact."
    },
    "profile": {
      "const": "spec-system"
    },
    "mode": {
      "enum": [
        "advisory",
        "shadow",
        "blocking"
      ],
      "description": "Profile posture loaded from policy/spec-system.toml or the built-in advisory default."
    },
    "status": {
      "enum": [
        "passed",
        "failed"
      ],
      "description": "Artifact posture. Advisory findings leave status passed; shadow findings are reported as failed posture without changing default cargo-allow behavior."
    },
    "failed": {
      "type": "boolean",
      "description": "Machine-readable mirror of status = failed for consumers that route shadow or blocking posture."
    },
    "claim_boundary": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim_boundary_flag"
      },
      "contains": {
        "const": "source_tree_graph_validation"
      },
      "description": "Profile-specific claim boundary for structural source-tree graph validation only."
    },
    "scanner_limitations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scanner_limitation"
      },
      "contains": {
        "const": "proof_commands_not_executed"
      },
      "description": "Execution and analyzer limitations for the spec-system graph scan."
    },
    "inventory": {
      "$ref": "#/$defs/inventory"
    },
    "source_tree_root": {
      "type": "string",
      "minLength": 1,
      "description": "Local source-tree root used for this graph scan. This may be an absolute path in local artifacts."
    },
    "config_source": {
      "type": "string",
      "minLength": 1,
      "description": "Profile configuration source, either a repo path or the built-in default root set."
    },
    "config_provenance": {
      "type": "string",
      "enum": [
        "explicit_config",
        "allow_profiles",
        "allow_config",
        "legacy_policy",
        "built_in_default"
      ],
      "description": "How the profile configuration path was selected."
    },
    "explained_artifact_id": {
      "type": "string",
      "minLength": 1,
      "description": "Artifact ID explained by explain <artifact-id> --profile spec-system."
    },
    "proof_commands": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^cargo-allow ",
        "description": "Suggested standalone cargo-allow follow-up command. cargo-allow records it but does not execute it."
      },
      "description": "Explain-only follow-up commands for rechecking the artifact view. These commands are not executed by cargo-allow."
    },
    "readiness": {
      "$ref": "#/$defs/readiness",
      "description": "Optional setup readiness emitted by doctor --profile spec-system."
    },
    "federation": {
      "$ref": "#/$defs/federation",
      "description": "Optional federation ledger summary when `.allow/config.toml` is configured."
    },
    "import_graph": {
      "$ref": "#/$defs/import_graph",
      "description": "Optional normalized import-root graph from configured import roots."
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "links": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/link"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "work_items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/work_item"
      },
      "description": "Reserved for profile repair items. PR 15 emits this array empty; PR 16 fills it."
    }
  },
  "$defs": {
    "claim_boundary_flag": {
      "type": "string",
      "enum": [
        "source_tree_inventory",
        "source_tree_graph_validation",
        "proof_commands_not_executed",
        "cargo_metadata_not_invoked",
        "cargo_commands_not_invoked",
        "rustc_not_invoked",
        "clippy_not_invoked",
        "build_scripts_not_executed",
        "proc_macros_not_executed",
        "macro_expansion_not_analyzed",
        "macro_token_tree_contents_not_analyzed",
        "type_information_not_analyzed",
        "mir_not_analyzed",
        "build_output_not_analyzed",
        "control_flow_not_analyzed",
        "data_flow_not_analyzed",
        "external_evidence_tools_not_invoked",
        "repository_code_not_executed",
        "network_not_used",
        "github_api_not_used"
      ]
    },
    "scanner_limitation": {
      "type": "string",
      "enum": [
        "proof_commands_not_executed",
        "cargo_metadata_not_invoked",
        "cargo_commands_not_invoked",
        "rustc_not_invoked",
        "clippy_not_invoked",
        "build_scripts_not_executed",
        "proc_macros_not_executed",
        "macro_expansion_not_analyzed",
        "macro_token_tree_contents_not_analyzed",
        "type_information_not_analyzed",
        "mir_not_analyzed",
        "build_output_not_analyzed",
        "control_flow_not_analyzed",
        "data_flow_not_analyzed",
        "external_evidence_tools_not_invoked",
        "repository_code_not_executed",
        "network_not_used",
        "github_api_not_used"
      ]
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "scanner",
        "source"
      ],
      "properties": {
        "scope": {
          "const": "source_tree"
        },
        "scanner": {
          "const": "source_tree_graph"
        },
        "source": {
          "enum": [
            "unknown",
            "git_tracked",
            "git_index_staged_candidate",
            "filesystem_fallback",
            "filesystem_include_untracked"
          ]
        },
        "root": {
          "type": "string",
          "minLength": 1,
          "description": "Local source-tree root used for this profile scan."
        },
        "files_scanned": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of source-tree files considered when a full inventory was collected."
        },
        "empty_git_tracked": {
          "type": "boolean",
          "description": "True when git inventory succeeded but reported no tracked files, such as a freshly initialized repo before git add."
        },
        "completeness": {
          "type": "string",
          "enum": ["complete", "scoped", "fallback", "partial"],
          "description": "Authoritative inventory coverage classification for this artifact."
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifacts",
        "links",
        "support_tier_rows",
        "findings",
        "work_items"
      ],
      "properties": {
        "artifacts": {
          "type": "integer",
          "minimum": 0
        },
        "links": {
          "type": "integer",
          "minimum": 0
        },
        "support_tier_rows": {
          "type": "integer",
          "minimum": 0
        },
        "findings": {
          "type": "integer",
          "minimum": 0
        },
        "blocking_eligible_findings": {
          "type": "integer",
          "minimum": 0,
          "description": "Findings from objective structural classes that blocking mode may fail on."
        },
        "advisory_findings": {
          "type": "integer",
          "minimum": 0,
          "description": "Findings that remain advisory even when this profile is configured for blocking mode."
        },
        "work_items": {
          "type": "integer",
          "minimum": 0
        },
        "blocking_eligible_work_items": {
          "type": "integer",
          "minimum": 0,
          "description": "Work items associated with objective structural findings that blocking mode may fail on."
        },
        "advisory_work_items": {
          "type": "integer",
          "minimum": 0,
          "description": "Work items associated with lifecycle or judgment-heavy checks that remain advisory."
        }
      }
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ready",
        "mode",
        "checks"
      ],
      "properties": {
        "ready": {
          "type": "boolean"
        },
        "mode": {
          "enum": [
            "advisory",
            "shadow",
            "blocking"
          ]
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/readiness_check"
          }
        }
      }
    },
    "readiness_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "found",
        "valid",
        "status",
        "message"
      ],
      "properties": {
        "kind": {
          "enum": [
            "profile_config",
            "artifact_root",
            "artifact_ledger",
            "support_tiers",
            "active_goal",
            "templates"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "found": {
          "type": "boolean"
        },
        "valid": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "status": {
          "enum": [
            "ready",
            "missing",
            "invalid"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "path",
        "status",
        "owner",
        "created"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "$ref": "#/$defs/artifact_kind"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "$ref": "#/$defs/artifact_status"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "created": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "field",
        "target"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "field": {
          "$ref": "#/$defs/link_field"
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "target_kind": {
          "$ref": "#/$defs/artifact_kind"
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "message",
        "blocking_eligible"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/finding_kind"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "blocking_eligible": {
          "type": "boolean",
          "description": "True when this finding is one of the objective structural classes that blocking mode may fail on."
        },
        "blocking_reason": {
          "$ref": "#/$defs/blocking_reason"
        }
      }
    },
    "work_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "message",
        "suggested_actions",
        "proof_commands"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/work_item_kind"
        },
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "blocking_eligible": {
          "type": "boolean",
          "description": "True when this repair item corresponds to an objective structural class that blocking mode may fail on."
        },
        "blocking_reason": {
          "$ref": "#/$defs/blocking_reason"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "suggested_actions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "proof_commands": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^cargo-allow ",
            "description": "Suggested standalone cargo-allow follow-up command. cargo-allow records it but does not execute it."
          }
        }
      }
    },
    "artifact_kind": {
      "enum": [
        "proposal",
        "spec",
        "adr",
        "implementation_plan",
        "plan_item",
        "active_goal",
        "legacy_active_goal_present",
        "support_tier",
        "policy_ledger",
        "closeout",
        "release_record"
      ]
    },
    "artifact_status": {
      "enum": [
        "draft",
        "proposed",
        "accepted",
        "active",
        "done",
        "superseded"
      ]
    },
    "link_field": {
      "enum": [
        "linked_proposal",
        "linked_spec",
        "linked_adr",
        "linked_plan",
        "linked_goal",
        "linked_support_tier",
        "linked_closeout",
        "supersedes",
        "superseded_by",
        "replaces"
      ]
    },
    "finding_kind": {
      "enum": [
        "profile_config",
        "doc_artifact_ledger",
        "artifact_file",
        "artifact_link",
        "active_goal",
        "support_tier",
        "federation_config",
        "import_graph"
      ]
    },
    "blocking_reason": {
      "enum": [
        "profile_config_parse_failure",
        "federation_config_invalid",
        "dialect_conflict",
        "federation_config_parse_failure",
        "doc_artifact_ledger_missing",
        "doc_artifact_ledger_parse_failure",
        "duplicate_id",
        "invalid_artifact_kind_or_status",
        "artifact_file_missing",
        "artifact_file_unreadable",
        "artifact_id_not_in_file",
        "unknown_link_target"
      ]
    },
    "work_item_kind": {
      "enum": [
        "missing_node",
        "missing_doc_artifact",
        "artifact_file_missing",
        "artifact_file_unreadable",
        "artifact_id_not_in_file",
        "invalid_artifact_status",
        "missing_required_edge",
        "missing_linked_proposal",
        "unknown_link_target",
        "unknown_linked_artifact",
        "orphan_spec",
        "missing_support_tier",
        "missing_proof_command",
        "claim_without_support_tier",
        "stale_active_goal",
        "legacy_goal_historical_only",
        "missing_closeout",
        "superseded_target_missing",
        "broken_import",
        "missing_import_root"
      ]
    },
    "federation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "federation_version",
        "precedence_applied",
        "ledger_contributors"
      ],
      "properties": {
        "federation_version": {
          "type": "string"
        },
        "precedence_applied": {
          "type": "string"
        },
        "ledger_contributors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/federation_ledger_contributor"
          }
        }
      }
    },
    "federation_ledger_contributor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "role",
        "dialect",
        "mode",
        "priority",
        "lanes"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "dialect": {
          "type": "string"
        },
        "mode": {
          "type": "string"
        },
        "priority": {
          "type": "integer"
        },
        "lanes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "import_graph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_count",
        "edge_count",
        "diagnostic_count",
        "nodes",
        "edges",
        "diagnostics"
      ],
      "properties": {
        "node_count": {
          "type": "integer",
          "minimum": 0
        },
        "edge_count": {
          "type": "integer",
          "minimum": 0
        },
        "diagnostic_count": {
          "type": "integer",
          "minimum": 0
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/import_node"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/import_edge"
          }
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/import_diagnostic"
          }
        }
      }
    },
    "import_node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "role",
        "ecosystem",
        "provenance",
        "confidence"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "role": {
          "enum": [
            "owned",
            "imported",
            "legacy",
            "generated"
          ]
        },
        "ecosystem": {
          "type": "string"
        },
        "provenance": {
          "enum": [
            "configured",
            "discovered",
            "legacy_fallback",
            "generated_marker"
          ]
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        }
      }
    },
    "import_edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "target_id",
        "kind",
        "provenance"
      ],
      "properties": {
        "source_id": {
          "type": "string"
        },
        "target_id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "contains",
            "references",
            "promotes"
          ]
        },
        "provenance": {
          "enum": [
            "configured",
            "discovered",
            "legacy_fallback",
            "generated_marker"
          ]
        }
      }
    },
    "import_diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "message",
        "root_ids"
      ],
      "properties": {
        "kind": {
          "enum": [
            "duplicate_root_id",
            "duplicate_root_path",
            "missing_root",
            "broken_edge",
            "unknown_role"
          ]
        },
        "message": {
          "type": "string"
        },
        "root_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://effortlessmetrics.dev/schemas/cargo-allow/common.v1.json",
  "title": "cargo-allow shared v1 schema fragments",
  "$comment": "Shared source-tree fragment catalog for cargo-allow v1 artifact schemas. Current artifact schemas remain self-contained for consumer portability.",
  "$defs": {
    "claim_boundary_flag": {
      "type": "string",
      "enum": [
        "source_tree_inventory",
        "source_syntax_only",
        "cargo_metadata_not_invoked",
        "cargo_commands_not_invoked",
        "rustc_not_invoked",
        "clippy_not_invoked",
        "build_scripts_not_executed",
        "proc_macros_not_executed",
        "macro_expansion_not_analyzed",
        "macro_token_tree_contents_not_analyzed",
        "type_information_not_analyzed",
        "mir_not_analyzed",
        "build_output_not_analyzed",
        "control_flow_not_analyzed",
        "data_flow_not_analyzed",
        "repository_code_not_executed"
      ]
    },
    "scanner_limitation": {
      "type": "string",
      "enum": [
        "cargo_metadata_not_invoked",
        "cargo_commands_not_invoked",
        "rustc_not_invoked",
        "clippy_not_invoked",
        "build_scripts_not_executed",
        "proc_macros_not_executed",
        "macro_expansion_not_analyzed",
        "macro_token_tree_contents_not_analyzed",
        "type_information_not_analyzed",
        "mir_not_analyzed",
        "build_output_not_analyzed",
        "control_flow_not_analyzed",
        "data_flow_not_analyzed",
        "repository_code_not_executed"
      ]
    },
    "inventory_source": {
      "type": "string",
      "enum": [
        "git_tracked",
        "filesystem_fallback",
        "filesystem_include_untracked",
        "unknown"
      ]
    },
    "canonical_evidence_prefix": {
      "type": "string",
      "enum": [
        "doc",
        "spec",
        "adr",
        "ripr",
        "unsafe-review",
        "coverage",
        "test",
        "cargo",
        "issue",
        "pr",
        "legacy-policy"
      ],
      "description": "Canonical typed evidence prefixes shown in cargo-allow user guidance."
    },
    "recognized_evidence_prefix": {
      "type": "string",
      "enum": [
        "doc",
        "spec",
        "adr",
        "ripr",
        "unsafe-review",
        "unsafe_review",
        "coverage",
        "test",
        "cargo",
        "issue",
        "pr",
        "legacy-policy",
        "legacy_policy"
      ],
      "description": "All evidence prefixes recognized by the policy parser, including compatibility aliases."
    },
    "local_file_evidence_prefix": {
      "type": "string",
      "enum": [
        "doc",
        "spec",
        "adr",
        "ripr",
        "unsafe-review",
        "unsafe_review",
        "coverage"
      ],
      "description": "Recognized evidence prefixes that cargo-allow validates as local source-tree file references."
    },
    "traceability_evidence_prefix": {
      "type": "string",
      "enum": [
        "test",
        "cargo",
        "issue",
        "pr",
        "legacy-policy",
        "legacy_policy"
      ],
      "description": "Recognized evidence prefixes treated as traceability references; cargo-allow does not execute or resolve them."
    },
    "evidence_reference_status": {
      "type": "string",
      "enum": [
        "local_file_present",
        "local_file_missing",
        "invalid_local_path",
        "traceability_only",
        "unstructured"
      ]
    },
    "source_syntax_inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "scanner",
        "source"
      ],
      "properties": {
        "scope": {
          "const": "source_tree"
        },
        "scanner": {
          "const": "source_syntax"
        },
        "source": {
          "$ref": "#/$defs/inventory_source"
        },
        "root": {
          "type": "string",
          "minLength": 1,
          "description": "Local source-tree root used for this artifact. This may be an absolute path."
        },
        "files_scanned": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of source-tree inventory files considered before scanner filtering, when collected."
        }
      }
    },
    "policy_migration_inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "scanner",
        "source"
      ],
      "properties": {
        "scope": {
          "const": "source_tree"
        },
        "scanner": {
          "const": "policy_migration"
        },
        "source": {
          "$ref": "#/$defs/inventory_source"
        },
        "root": {
          "type": "string",
          "minLength": 1,
          "description": "Local source-tree root used for this migration artifact. This may be an absolute path."
        },
        "files_scanned": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of source-tree inventory files considered before migration output, when collected."
        }
      }
    }
  }
}

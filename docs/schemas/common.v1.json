{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://effortlessmetrics.dev/schemas/cargo-allow/common.v1.json",
  "title": "cargo-allow shared v1 schema fragments",
  "$comment": "Shared source-tree fragment catalog for cargo-allow v1 artifact schemas. Current artifact schemas remain self-contained for consumer portability.",
  "$defs": {
    "claim_boundary_flag": {
      "type": "string",
      "enum": [
        "source_tree_inventory",
        "source_syntax_only",
        "cargo_metadata_not_invoked",
        "cargo_commands_not_invoked",
        "rustc_not_invoked",
        "clippy_not_invoked",
        "build_scripts_not_executed",
        "proc_macros_not_executed",
        "macro_expansion_not_analyzed",
        "macro_token_tree_contents_not_analyzed",
        "type_information_not_analyzed",
        "mir_not_analyzed",
        "build_output_not_analyzed",
        "control_flow_not_analyzed",
        "data_flow_not_analyzed",
        "repository_code_not_executed"
      ]
    },
    "scanner_limitation": {
      "type": "string",
      "enum": [
        "cargo_metadata_not_invoked",
        "cargo_commands_not_invoked",
        "rustc_not_invoked",
        "clippy_not_invoked",
        "build_scripts_not_executed",
        "proc_macros_not_executed",
        "macro_expansion_not_analyzed",
        "macro_token_tree_contents_not_analyzed",
        "type_information_not_analyzed",
        "mir_not_analyzed",
        "build_output_not_analyzed",
        "control_flow_not_analyzed",
        "data_flow_not_analyzed",
        "repository_code_not_executed"
      ]
    },
    "inventory_source": {
      "type": "string",
      "enum": [
        "git_tracked",
        "filesystem_fallback",
        "filesystem_include_untracked",
        "unknown"
      ]
    },
    "governed_source_exception_kind": {
      "type": "string",
      "enum": [
        "panic",
        "unsafe",
        "lint_exception",
        "non_rust_file",
        "generated_code",
        "policy_exception"
      ]
    },
    "match_status": {
      "type": "string",
      "enum": [
        "matched",
        "new",
        "stale",
        "expired",
        "review_due",
        "ambiguous",
        "invalid_selector",
        "missing_required_field",
        "evidence_missing",
        "baseline_debt"
      ]
    },
    "canonical_evidence_prefix": {
      "type": "string",
      "enum": [
        "doc",
        "spec",
        "adr",
        "ripr",
        "unsafe-review",
        "coverage",
        "test",
        "cargo",
        "issue",
        "pr",
        "legacy-policy"
      ],
      "description": "Canonical typed evidence prefixes shown in cargo-allow user guidance."
    },
    "recognized_evidence_prefix": {
      "type": "string",
      "enum": [
        "doc",
        "spec",
        "adr",
        "ripr",
        "unsafe-review",
        "unsafe_review",
        "coverage",
        "test",
        "cargo",
        "issue",
        "pr",
        "legacy-policy",
        "legacy_policy"
      ],
      "description": "All evidence prefixes recognized by the policy parser, including compatibility aliases."
    },
    "local_file_evidence_prefix": {
      "type": "string",
      "enum": [
        "doc",
        "spec",
        "adr",
        "ripr",
        "unsafe-review",
        "unsafe_review",
        "coverage"
      ],
      "description": "Recognized evidence prefixes that cargo-allow validates as local source-tree file references."
    },
    "traceability_evidence_prefix": {
      "type": "string",
      "enum": [
        "test",
        "cargo",
        "issue",
        "pr",
        "legacy-policy",
        "legacy_policy"
      ],
      "description": "Recognized evidence prefixes treated as traceability references; cargo-allow does not execute or resolve them."
    },
    "evidence_reference_status": {
      "type": "string",
      "enum": [
        "local_file_present",
        "local_file_missing",
        "invalid_local_path",
        "traceability_only",
        "unstructured"
      ]
    },
    "evidence_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw",
        "prefix",
        "target",
        "status",
        "message"
      ],
      "properties": {
        "raw": {
          "type": "string",
          "minLength": 1,
          "description": "Original evidence reference string from the allow entry."
        },
        "prefix": {
          "type": [
            "string",
            "null"
          ],
          "description": "Evidence reference prefix before ':', or null for unstructured evidence strings."
        },
        "target": {
          "type": [
            "string",
            "null"
          ],
          "description": "Normalized evidence reference target when present."
        },
        "status": {
          "$ref": "#/$defs/evidence_reference_status"
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidence_change_field": {
      "enum": [
        "evidence",
        "links"
      ]
    },
    "evidence_change": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "removed",
        "added"
      ],
      "properties": {
        "field": {
          "$ref": "#/$defs/evidence_change_field",
          "description": "Policy collection that changed."
        },
        "removed": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Values removed from the policy collection."
        },
        "added": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Values added to the policy collection."
        }
      }
    },
    "finding_posture_kind": {
      "type": "string",
      "enum": [
        "new",
        "removed"
      ]
    },
    "policy_change_severity": {
      "type": "string",
      "enum": [
        "improvement",
        "review",
        "fail"
      ]
    },
    "policy_change_kind": {
      "type": "string",
      "enum": [
        "added_allow",
        "removed_allow",
        "baseline_debt_added",
        "baseline_debt_introduced",
        "baseline_debt_normalized",
        "kind_changed",
        "family_changed",
        "scope_broadened",
        "scope_changed",
        "scope_narrowed",
        "selector_changed",
        "selector_precision_decreased",
        "selector_precision_increased",
        "created_added",
        "created_changed",
        "created_removed",
        "expiry_extended",
        "expiry_shortened",
        "review_after_extended",
        "review_after_shortened",
        "evidence_added",
        "evidence_removed",
        "link_added",
        "link_removed",
        "owner_added",
        "owner_changed",
        "owner_removed",
        "owner_unassigned",
        "policy_owner_added",
        "policy_owner_changed",
        "policy_owner_removed",
        "policy_owner_unassigned",
        "policy_status_changed",
        "policy_status_weakened",
        "policy_status_tightened",
        "reason_added",
        "reason_changed",
        "reason_removed",
        "requirement_loosened",
        "requirement_tightened",
        "workspace_ignored_added",
        "workspace_ignored_removed",
        "workspace_generated_added",
        "workspace_generated_removed",
        "classification_added",
        "classification_changed",
        "classification_removed",
        "occurrence_limit_tightened",
        "occurrence_limit_loosened"
      ]
    },
    "selector_precision_field": {
      "enum": [
        "path",
        "glob",
        "family",
        "ast_kind",
        "container",
        "callee",
        "macro_name",
        "lint",
        "symbol",
        "receiver_fingerprint",
        "target_fingerprint",
        "normalized_snippet_hash",
        "occurrence_limit"
      ]
    },
    "selector_precision_change": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "before",
        "after",
        "removed_fields",
        "added_fields"
      ],
      "properties": {
        "before": {
          "type": "integer",
          "minimum": 0,
          "description": "Selector precision score before the policy change."
        },
        "after": {
          "type": "integer",
          "minimum": 0,
          "description": "Selector precision score after the policy change."
        },
        "removed_fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/selector_precision_field"
          },
          "description": "Selector fields that were present before the change and absent after it."
        },
        "added_fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/selector_precision_field"
          },
          "description": "Selector fields that were absent before the change and present after it."
        }
      }
    },
    "scope_change_field": {
      "enum": [
        "path",
        "glob",
        "selector.glob",
        "effective"
      ]
    },
    "lifecycle_change_field": {
      "enum": [
        "created",
        "expires",
        "review_after"
      ]
    },
    "lifecycle_change": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "before",
        "after"
      ],
      "properties": {
        "field": {
          "$ref": "#/$defs/lifecycle_change_field",
          "description": "Lifecycle field that changed."
        },
        "before": {
          "type": [
            "string",
            "null"
          ],
          "description": "Lifecycle value before the policy change when available."
        },
        "after": {
          "type": [
            "string",
            "null"
          ],
          "description": "Lifecycle value after the policy change when available."
        }
      }
    },
    "occurrence_limit_change": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "before",
        "after"
      ],
      "properties": {
        "before": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "Allowed occurrence count before the policy change, or null when unset."
        },
        "after": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "Allowed occurrence count after the policy change, or null when unset."
        }
      }
    },
    "scope_change": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "before",
        "after"
      ],
      "properties": {
        "field": {
          "$ref": "#/$defs/scope_change_field",
          "description": "Scope carrier that changed, or effective when the scope moved between carriers."
        },
        "before": {
          "type": [
            "string",
            "null"
          ],
          "description": "Normalized source-tree scope before the policy change when available."
        },
        "after": {
          "type": [
            "string",
            "null"
          ],
          "description": "Normalized source-tree scope after the policy change when available."
        }
      }
    },
    "source_syntax_inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "scanner",
        "source"
      ],
      "properties": {
        "scope": {
          "const": "source_tree"
        },
        "scanner": {
          "const": "source_syntax"
        },
        "source": {
          "$ref": "#/$defs/inventory_source"
        },
        "root": {
          "type": "string",
          "minLength": 1,
          "description": "Local source-tree root used for this artifact. This may be an absolute path."
        },
        "files_scanned": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of source-tree inventory files considered before scanner filtering, when collected."
        }
      }
    },
    "policy_migration_inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "scanner",
        "source"
      ],
      "properties": {
        "scope": {
          "const": "source_tree"
        },
        "scanner": {
          "const": "policy_migration"
        },
        "source": {
          "$ref": "#/$defs/inventory_source"
        },
        "root": {
          "type": "string",
          "minLength": 1,
          "description": "Local source-tree root used for this migration artifact. This may be an absolute path."
        },
        "files_scanned": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of source-tree inventory files considered before migration output, when collected."
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://effortlessmetrics.dev/schemas/cargo-allow/doctor.v1.schema.json",
  "title": "cargo-allow doctor v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema_id",
    "tool",
    "command",
    "claim_boundary",
    "scanner_limitations",
    "root",
    "config",
    "inventory",
    "federation"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "schema_id": {
      "const": "cargo-allow.doctor.v1"
    },
    "tool": {
      "const": "cargo-allow"
    },
    "command": {
      "const": "doctor"
    },
    "claim_boundary": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim_boundary_flag"
      }
    },
    "scanner_limitations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scanner_limitation"
      }
    },
    "root": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "discovery"
      ],
      "properties": {
        "path": {
          "type": "string",
          "description": "Local source-tree root used for the doctor check. This may be an absolute path."
        },
        "discovery": {
          "enum": [
            "explicit_root",
            "nearest_git_root",
            "current_directory_fallback"
          ]
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "found",
        "path",
        "valid",
        "diagnostic"
      ],
      "properties": {
        "found": {
          "type": "boolean"
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "schema_version": {
          "type": [
            "string",
            "null"
          ],
          "description": "Policy schema version loaded from the config when the policy parses successfully; null when no config is found or parsing fails before a policy model is available."
        },
        "policy": {
          "type": [
            "string",
            "null"
          ],
          "description": "Policy name loaded from the config when the policy parses successfully; null when no config is found or parsing fails before a policy model is available."
        },
        "owner": {
          "type": [
            "string",
            "null"
          ],
          "description": "Top-level policy owner loaded from the config when available; null when unset, no config is found, or parsing fails before a policy model is available."
        },
        "status": {
          "type": [
            "string",
            "null"
          ],
          "description": "Top-level policy status loaded from the config when available; null when unset, no config is found, or parsing fails before a policy model is available."
        },
        "valid": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Whether the discovered policy parsed, passed policy validation, and had locally referenced evidence files present. Null when no config file was found."
        },
        "diagnostic": {
          "type": [
            "string",
            "null"
          ],
          "description": "Validation diagnostic when config.valid is false; null when config is valid or no config was found."
        },
        "suggested_init_command": {
          "type": "string",
          "description": "Optional standalone cargo-allow command to create a policy for the diagnosed source-tree root. Emitted when no config file was found."
        },
        "broken_evidence_links": {
          "type": "integer",
          "minimum": 0,
          "description": "Optional count of missing or invalid local evidence or link references found in the policy. Emitted, including zero, when a policy model is available; omitted when no policy model is available."
        },
        "weak_evidence_references": {
          "type": "integer",
          "minimum": 0,
          "description": "Optional count of unstructured or unknown-prefix evidence or link references found in the policy. Emitted, including zero, when a policy model is available; omitted when no policy model is available."
        },
        "evidence_repair_queues": {
          "type": "array",
          "description": "Optional evidence-health repair queues emitted when doctor finds broken local evidence links or weak evidence references.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["signal", "count", "command"],
            "properties": {
              "signal": {
                "enum": [
                  "broken_evidence_links",
                  "weak_evidence_references"
                ],
                "description": "Evidence-health setup signal routed by this queue."
              },
              "label": {
                "type": "string",
                "description": "Human-friendly queue label for display and agent logs."
              },
              "route_kind": {
                "enum": [
                  "worklist_item_kind",
                  "worklist_filter"
                ],
                "description": "Machine routing mode for the follow-up command."
              },
              "item_kind": {
                "enum": [
                  "broken_evidence_link",
                  "weak_evidence_reference"
                ],
                "description": "Stable cargo-allow worklist item kind routed by this queue."
              },
              "worklist_filter": {
                "enum": [
                  "broken_evidence",
                  "weak_evidence"
                ],
                "description": "Named worklist filter used by this row when route_kind is worklist_filter."
              },
              "count": {
                "type": "integer",
                "minimum": 0,
                "description": "Number of doctor evidence-health items routed by this queue."
              },
              "command": {
                "type": "string",
                "description": "Suggested cargo-allow worklist command for this queue."
              }
            }
          }
        }
      }
    },
    "inventory": {
      "$ref": "#/$defs/inventory"
    },
    "federation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "found",
        "path",
        "valid"
      ],
      "properties": {
        "found": {
          "type": "boolean"
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "valid": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "configured_ledgers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "path",
              "dialect",
              "role",
              "mode",
              "priority"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "dialect": {
                "type": "string"
              },
              "role": {
                "enum": [
                  "canonical",
                  "mirror",
                  "imported"
                ]
              },
              "mode": {
                "enum": [
                  "advisory",
                  "shadow",
                  "blocking"
                ]
              },
              "priority": {
                "type": "integer",
                "minimum": 0
              },
              "lanes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "mirrors": {
                "type": "string"
              }
            }
          }
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "message",
              "ledger_ids"
            ],
            "properties": {
              "kind": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "ledger_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "claim_boundary_flag": {
      "type": "string",
      "enum": [
        "source_tree_inventory",
        "source_syntax_only",
        "cargo_metadata_not_invoked",
        "cargo_commands_not_invoked",
        "rustc_not_invoked",
        "clippy_not_invoked",
        "build_scripts_not_executed",
        "proc_macros_not_executed",
        "macro_expansion_not_analyzed",
        "macro_token_tree_contents_not_analyzed",
        "type_information_not_analyzed",
        "mir_not_analyzed",
        "build_output_not_analyzed",
        "control_flow_not_analyzed",
        "data_flow_not_analyzed",
        "external_evidence_tools_not_invoked",
        "repository_code_not_executed"
      ]
    },
    "scanner_limitation": {
      "type": "string",
      "enum": [
        "cargo_metadata_not_invoked",
        "cargo_commands_not_invoked",
        "rustc_not_invoked",
        "clippy_not_invoked",
        "build_scripts_not_executed",
        "proc_macros_not_executed",
        "macro_expansion_not_analyzed",
        "macro_token_tree_contents_not_analyzed",
        "type_information_not_analyzed",
        "mir_not_analyzed",
        "build_output_not_analyzed",
        "control_flow_not_analyzed",
        "data_flow_not_analyzed",
        "external_evidence_tools_not_invoked",
        "repository_code_not_executed"
      ]
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "scanner",
        "source",
        "files_scanned"
      ],
      "properties": {
        "scope": {
          "const": "source_tree"
        },
        "scanner": {
          "const": "source_syntax"
        },
        "source": {
          "enum": [
            "git_tracked",
            "filesystem_fallback",
            "filesystem_include_untracked",
            "unknown"
          ]
        },
        "root": {
          "type": "string",
          "minLength": 1,
          "description": "Local source-tree root used for the doctor inventory. This mirrors root.path for consumers that handle the shared inventory object."
        },
        "files_scanned": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of source-tree inventory files considered by the doctor command."
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://effortlessmetrics.dev/schemas/cargo-allow/doctor.v1.schema.json",
  "title": "cargo-allow doctor v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema_id",
    "tool",
    "command",
    "claim_boundary",
    "scanner_limitations",
    "root",
    "config",
    "inventory",
    "scanner",
    "file_families",
    "federation",
    "evidence_repair_queues"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "schema_id": {
      "const": "cargo-allow.doctor.v1"
    },
    "tool": {
      "const": "cargo-allow"
    },
    "command": {
      "const": "doctor"
    },
    "claim_boundary": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim_boundary_flag"
      }
    },
    "scanner_limitations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scanner_limitation"
      }
    },
    "root": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "discovery"
      ],
      "properties": {
        "path": {
          "type": "string",
          "description": "Local source-tree root used for the doctor check. This may be an absolute path."
        },
        "discovery": {
          "enum": [
            "explicit_root",
            "nearest_git_root",
            "current_directory_fallback"
          ]
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "found"
      ],
      "properties": {
        "found": {
          "type": "boolean"
        },
        "path": {
          "type": [
            "string"
          ],
          "description": "Discovered policy path; omitted when no policy config was found."
        },
        "schema_version": {
          "type": [
            "string"
          ],
          "description": "Policy schema version loaded from the config; omitted when unavailable."
        },
        "policy": {
          "type": [
            "string"
          ],
          "description": "Policy name loaded from the config; omitted when unavailable."
        },
        "owner": {
          "type": [
            "string"
          ],
          "description": "Top-level policy owner loaded from the config; omitted when unset or unavailable."
        },
        "status": {
          "type": [
            "string"
          ],
          "description": "Top-level policy status loaded from the config; omitted when unset or unavailable."
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source"
          ],
          "properties": {
            "source": {
              "type": "string",
              "enum": [
                "cli_override",
                "federation_registry",
                "package_metadata",
                "workspace_metadata",
                "conventional_path"
              ],
              "description": "Configuration source that selected the policy."
            },
            "precedence": {
              "type": "string",
              "enum": [
                "cli_override",
                "federation_registry",
                "discovery_fallback"
              ],
              "description": "Precedence tier applied by the source-exception resolver; omitted when fallback discovery could not be evaluated."
            }
          },
          "description": "Read-only configuration discovery provenance; this does not validate policy contents."
        },
        "valid": {
          "type": [
            "boolean"
          ],
          "description": "Whether the discovered policy parsed, passed policy validation, and had locally referenced evidence files present; omitted when no config file was found."
        },
        "diagnostic": {
          "type": [
            "string"
          ],
          "description": "Validation diagnostic when config.valid is false; omitted when config is valid or unavailable."
        },
        "suggested_init_command": {
          "type": "string",
          "description": "Optional standalone cargo-allow command to create a policy for the diagnosed source-tree root. Emitted when no config file was found."
        },
        "broken_evidence_links": {
          "type": "integer",
          "minimum": 0,
          "description": "Optional count of missing or invalid local evidence or link references found in the policy. Emitted, including zero, when a policy model is available; omitted when no policy model is available."
        },
        "weak_evidence_references": {
          "type": "integer",
          "minimum": 0,
          "description": "Optional count of unstructured or unknown-prefix evidence or link references found in the policy. Emitted, including zero, when a policy model is available; omitted when no policy model is available."
        }
      }
    },
    "inventory": {
      "$ref": "#/$defs/inventory"
    },
    "scanner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "completeness",
        "rust"
      ],
      "properties": {
        "completeness": {
          "enum": [
            "complete",
            "partial",
            "unknown"
          ],
          "description": "Rust scanner coverage classification. unknown means no Rust files were selected; it is not a complete scan claim."
        },
        "rust": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "files_considered",
            "files_scanned",
            "files_skipped",
            "files_with_parse_errors",
            "skipped_by_reason"
          ],
          "properties": {
            "files_considered": {
              "type": "integer",
              "minimum": 0
            },
            "files_scanned": {
              "type": "integer",
              "minimum": 0
            },
            "files_skipped": {
              "type": "integer",
              "minimum": 0
            },
            "files_with_parse_errors": {
              "type": "integer",
              "minimum": 0
            },
            "skipped_by_reason": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "read_failed_or_unsupported"
              ],
              "properties": {
                "read_failed_or_unsupported": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    },
    "file_families": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configured",
        "conflicts"
      ],
      "properties": {
        "configured": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/file_family_rule"
          }
        },
        "conflicts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/file_family_conflict"
          }
        }
      }
    },
    "federation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "found",
        "path",
        "valid"
      ],
      "properties": {
        "found": {
          "type": "boolean"
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "provenance": {
          "enum": [
            "fixed_allow_config",
            "unknown"
          ],
          "description": "Configuration source vocabulary. fixed_allow_config identifies the fixed .allow/config.toml federation path; unknown preserves provenance uncertainty for externally constructed report inputs."
        },
        "valid": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "configured_ledgers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "path",
              "dialect",
              "role",
              "mode",
              "priority"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "dialect": {
                "type": "string"
              },
              "role": {
                "enum": [
                  "canonical",
                  "mirror",
                  "imported"
                ]
              },
              "mode": {
                "enum": [
                  "advisory",
                  "shadow",
                  "blocking"
                ]
              },
              "priority": {
                "type": "integer",
                "minimum": 0
              },
              "lanes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "mirrors": {
                "type": "string"
              }
            }
          }
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "message",
              "ledger_ids"
            ],
            "properties": {
              "kind": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "ledger_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "divergences": {
          "type": "array",
          "description": "Runtime mirror divergences.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "type": "string"
              },
              "ledger_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "message": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "kind"
            ]
          }
        }
      }
    },
    "evidence_repair_queues": {
      "type": "array",
      "description": "Evidence-health repair queues. Always emitted (even when empty, #1858) so downstream consumers can distinguish feature-off from zero count without per-artifact special-casing.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "signal",
          "count",
          "command"
        ],
        "properties": {
          "signal": {
            "enum": [
              "broken_evidence_links",
              "weak_evidence_references"
            ]
          },
          "label": {
            "type": "string"
          },
          "route_kind": {
            "enum": [
              "worklist_item_kind",
              "worklist_filter"
            ]
          },
          "item_kind": {
            "enum": [
              "broken_evidence_link",
              "weak_evidence_reference"
            ]
          },
          "worklist_filter": {
            "enum": [
              "broken_evidence",
              "weak_evidence"
            ]
          },
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "command": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "claim_boundary_flag": {
      "type": "string",
      "enum": [
        "source_tree_inventory",
        "source_syntax_only",
        "cargo_metadata_not_invoked",
        "cargo_commands_not_invoked",
        "rustc_not_invoked",
        "clippy_not_invoked",
        "build_scripts_not_executed",
        "proc_macros_not_executed",
        "macro_expansion_not_analyzed",
        "macro_token_tree_contents_not_analyzed",
        "type_information_not_analyzed",
        "mir_not_analyzed",
        "build_output_not_analyzed",
        "control_flow_not_analyzed",
        "data_flow_not_analyzed",
        "external_evidence_tools_not_invoked",
        "repository_code_not_executed",
        "source_text_in_identity_fields"
      ]
    },
    "scanner_limitation": {
      "type": "string",
      "enum": [
        "cargo_metadata_not_invoked",
        "cargo_commands_not_invoked",
        "rustc_not_invoked",
        "clippy_not_invoked",
        "build_scripts_not_executed",
        "proc_macros_not_executed",
        "macro_expansion_not_analyzed",
        "macro_token_tree_contents_not_analyzed",
        "type_information_not_analyzed",
        "mir_not_analyzed",
        "build_output_not_analyzed",
        "control_flow_not_analyzed",
        "data_flow_not_analyzed",
        "external_evidence_tools_not_invoked",
        "repository_code_not_executed"
      ]
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "scanner",
        "source",
        "files_scanned"
      ],
      "properties": {
        "scope": {
          "const": "source_tree"
        },
        "scanner": {
          "const": "source_syntax"
        },
        "source": {
          "enum": [
            "git_tracked",
            "git_index_staged_candidate",
            "filesystem_fallback",
            "filesystem_include_untracked",
            "unknown"
          ]
        },
        "root": {
          "type": "string",
          "minLength": 1,
          "description": "Local source-tree root used for the doctor inventory. This mirrors root.path for consumers that handle the shared inventory object."
        },
        "files_scanned": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of source-tree inventory files considered by the doctor command."
        },
        "empty_git_tracked": {
          "type": "boolean",
          "description": "True when git inventory succeeded but reported no tracked files, such as a freshly initialized repo before git add."
        },
        "completeness": {
          "type": "string",
          "enum": [
            "complete",
            "scoped",
            "fallback",
            "partial"
          ],
          "description": "Authoritative inventory coverage classification for this artifact."
        }
      }
    },
    "file_family_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "family",
        "glob",
        "matched_files"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "family": {
          "type": "string",
          "minLength": 1
        },
        "glob": {
          "type": "string",
          "minLength": 1
        },
        "matched_files": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "file_family_conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "rule_ids",
        "families"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "rule_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "families": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "evidence_repair_queues": {
      "type": "array",
      "description": "Evidence-health repair queues. Always emitted (even when empty, #1858) so downstream consumers can distinguish feature-off from zero count without per-artifact special-casing.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "signal",
          "count",
          "command"
        ],
        "properties": {
          "signal": {
            "enum": [
              "broken_evidence_links",
              "weak_evidence_references"
            ]
          },
          "label": {
            "type": "string"
          },
          "route_kind": {
            "enum": [
              "worklist_item_kind",
              "worklist_filter"
            ]
          },
          "item_kind": {
            "enum": [
              "broken_evidence_link",
              "weak_evidence_reference"
            ]
          },
          "worklist_filter": {
            "enum": [
              "broken_evidence",
              "weak_evidence"
            ]
          },
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "command": {
            "type": "string"
          }
        }
      }
    }
  }
}

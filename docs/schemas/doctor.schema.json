{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://effortlessmetrics.dev/schemas/cargo-allow/doctor.v1.schema.json",
  "title": "cargo-allow doctor v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema_id",
    "tool",
    "command",
    "claim_boundary",
    "scanner_limitations",
    "root",
    "config",
    "inventory"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "schema_id": {
      "const": "cargo-allow.doctor.v1"
    },
    "tool": {
      "const": "cargo-allow"
    },
    "command": {
      "const": "doctor"
    },
    "claim_boundary": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim_boundary_flag"
      }
    },
    "scanner_limitations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scanner_limitation"
      }
    },
    "root": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "discovery"
      ],
      "properties": {
        "path": {
          "type": "string",
          "description": "Local source-tree root used for the doctor check. This may be an absolute path."
        },
        "discovery": {
          "enum": [
            "explicit_root",
            "nearest_git_root",
            "current_directory_fallback"
          ]
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "found",
        "path"
      ],
      "properties": {
        "found": {
          "type": "boolean"
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "inventory": {
      "$ref": "#/$defs/inventory"
    }
  },
  "$defs": {
    "claim_boundary_flag": {
      "type": "string",
      "enum": [
        "source_tree_inventory",
        "source_syntax_only",
        "cargo_metadata_not_invoked",
        "cargo_commands_not_invoked",
        "rustc_not_invoked",
        "clippy_not_invoked",
        "build_scripts_not_executed",
        "proc_macros_not_executed",
        "macro_expansion_not_analyzed",
        "macro_token_tree_contents_not_analyzed",
        "type_information_not_analyzed",
        "mir_not_analyzed",
        "build_output_not_analyzed",
        "control_flow_not_analyzed",
        "data_flow_not_analyzed",
        "repository_code_not_executed"
      ]
    },
    "scanner_limitation": {
      "type": "string",
      "enum": [
        "cargo_metadata_not_invoked",
        "cargo_commands_not_invoked",
        "rustc_not_invoked",
        "clippy_not_invoked",
        "build_scripts_not_executed",
        "proc_macros_not_executed",
        "macro_expansion_not_analyzed",
        "macro_token_tree_contents_not_analyzed",
        "type_information_not_analyzed",
        "mir_not_analyzed",
        "build_output_not_analyzed",
        "control_flow_not_analyzed",
        "data_flow_not_analyzed",
        "repository_code_not_executed"
      ]
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "scanner",
        "source",
        "files_scanned"
      ],
      "properties": {
        "scope": {
          "const": "source_tree"
        },
        "scanner": {
          "const": "source_syntax"
        },
        "source": {
          "enum": [
            "git_tracked",
            "filesystem_fallback",
            "filesystem_include_untracked"
          ]
        },
        "files_scanned": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of source-tree inventory files considered by the doctor command."
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://effortlessmetrics.dev/schemas/cargo-allow/list.v1.schema.json",
  "title": "cargo-allow list v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema_id",
    "tool",
    "command",
    "claim_boundary",
    "scanner_limitations",
    "inventory",
    "filters",
    "summary",
    "allow_entries"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "schema_id": {
      "type": "string",
      "const": "cargo-allow.list.v1"
    },
    "tool": {
      "type": "string",
      "const": "cargo-allow"
    },
    "command": {
      "type": "string",
      "const": "list"
    },
    "claim_boundary": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "source_tree_inventory",
          "source_syntax_only",
          "cargo_metadata_not_invoked",
          "cargo_commands_not_invoked",
          "rustc_not_invoked",
          "clippy_not_invoked",
          "build_scripts_not_executed",
          "proc_macros_not_executed",
          "macro_expansion_not_analyzed",
          "macro_token_tree_contents_not_analyzed",
          "type_information_not_analyzed",
          "mir_not_analyzed",
          "build_output_not_analyzed",
          "control_flow_not_analyzed",
          "data_flow_not_analyzed",
          "external_evidence_tools_not_invoked",
          "repository_code_not_executed",
          "source_text_in_identity_fields"
        ]
      },
      "contains": {
        "const": "source_tree_inventory"
      },
      "description": "Explicit source-tree claim boundary for this filtered list artifact."
    },
    "scanner_limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "cargo_metadata_not_invoked",
          "cargo_commands_not_invoked",
          "rustc_not_invoked",
          "clippy_not_invoked",
          "build_scripts_not_executed",
          "proc_macros_not_executed",
          "macro_expansion_not_analyzed",
          "macro_token_tree_contents_not_analyzed",
          "type_information_not_analyzed",
          "mir_not_analyzed",
          "build_output_not_analyzed",
          "control_flow_not_analyzed",
          "data_flow_not_analyzed",
          "external_evidence_tools_not_invoked",
          "repository_code_not_executed"
        ]
      },
      "contains": {
        "const": "cargo_metadata_not_invoked"
      },
      "description": "Explicit scanner_limitation and execution limitation values for this filtered list artifact."
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "scanner",
        "source"
      ],
      "properties": {
        "scope": {
          "type": "string",
          "const": "source_tree"
        },
        "scanner": {
          "type": "string",
          "const": "source_syntax"
        },
        "source": {
          "type": "string",
          "enum": [
            "unknown",
            "git_tracked",
            "git_index_staged_candidate",
            "filesystem_fallback",
            "filesystem_include_untracked"
          ]
        },
        "root": {
          "type": "string",
          "minLength": 1,
          "description": "Local source-tree root used for this list artifact. This may be an absolute path."
        },
        "files_scanned": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of source-tree inventory files considered before scanner filtering, when collected."
        },
        "empty_git_tracked": {
          "type": "boolean",
          "description": "True when git inventory succeeded but reported no tracked files, such as a freshly initialized repo before git add."
        },
        "completeness": {
          "type": "string",
          "enum": ["complete", "scoped", "fallback", "partial"],
          "description": "Authoritative inventory coverage classification for this artifact."
        }
      }
    },
    "filters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": [
            "string",
            "null"
          ],
          "description": "Applied --kind filter, or null when all governed kinds are included."
        },
        "family": {
          "type": [
            "string",
            "null"
          ],
          "description": "Applied --family filter, or null when all scanner or policy families are included."
        },
        "owner": {
          "type": [
            "string",
            "null"
          ],
          "description": "Applied --owner filter, or null when all policy owners are included."
        },
        "classification": {
          "type": [
            "string",
            "null"
          ],
          "description": "Applied --classification filter, or null when all policy classifications are included."
        },
        "path": {
          "type": [
            "string",
            "null"
          ],
          "description": "Applied --path source-tree path or path-prefix filter, or null when all scopes are included."
        },
        "source_package": {
          "type": [
            "string",
            "null"
          ],
          "description": "Applied --source-package filter, or null when all scanner-provided source package contexts are included."
        },
        "allow_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "Applied --allow-id filter, or null when all durable allow IDs are included."
        },
        "status": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "matched",
            "new",
            "stale",
            "expired",
            "review_due",
            "location_drift",
            "ambiguous",
            "invalid_selector",
            "missing_required_field",
            "evidence_missing",
            "baseline_debt",
            null
          ],
          "description": "Applied --status filter, or null when all current ledger statuses are included."
        },
        "expired": {
          "type": "boolean",
          "description": "Applied --expired shortcut filter."
        },
        "review_due": {
          "type": "boolean",
          "description": "Applied --review-due shortcut filter."
        },
        "stale": {
          "type": "boolean",
          "description": "Applied --stale shortcut filter."
        },
        "location_drift": {
          "type": "boolean",
          "description": "Applied --location-drift shortcut filter."
        },
        "baseline_debt": {
          "type": "boolean",
          "description": "Applied --baseline-debt shortcut filter."
        },
        "broad_scope": {
          "type": "boolean",
          "description": "Applied --broad-scope shortcut filter."
        },
        "missing_evidence": {
          "type": "boolean",
          "description": "Applied --missing-evidence shortcut filter."
        },
        "broken_evidence": {
          "type": "boolean",
          "description": "Applied --broken-evidence shortcut filter."
        },
        "weak_evidence": {
          "type": "boolean",
          "description": "Applied --weak-evidence shortcut filter."
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allow_entries"
      ],
      "properties": {
        "allow_entries": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "core_command_summary": {
      "$ref": "#/$defs/core_command_summary"
    },
    "allow_entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/allow_entry"
      }
    }
  },
  "$defs": {
    "core_command_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_version",
        "tool",
        "tool_version",
        "operation",
        "subject",
        "result_class",
        "posture",
        "completeness",
        "currentness",
        "reason",
        "additional_action_count",
        "operation_effects",
        "claim_boundary"
      ],
      "properties": {
        "schema_id": { "const": "cargo-allow.core-command-summary.v1" },
        "schema_version": { "const": 1 },
        "tool": { "const": "cargo-allow" },
        "tool_version": { "type": "string", "minLength": 1 },
        "operation": { "const": "list" },
        "mode": { "type": ["string", "null"] },
        "profile": { "type": ["string", "null"] },
        "subject": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "repository_identity", "portable_identity"],
          "properties": {
            "kind": { "enum": ["worktree", "index", "commit_tree", "committed_range", "scoped_path", "unknown"] },
            "repository_identity": { "type": "string", "minLength": 1 },
            "portable_identity": { "type": "string", "minLength": 1 },
            "base": { "type": ["string", "null"] },
            "head": { "type": ["string", "null"] },
            "paths": { "type": "array", "items": { "type": "string" } },
            "limitations": { "type": "array", "items": { "type": "string" } }
          }
        },
        "result_class": { "enum": ["completed", "findings", "not_proven", "partial_data", "stale_input", "unsupported", "malformed_input", "instrument_failure", "cancelled", "conflict"] },
        "posture": { "enum": ["satisfied", "advisory", "blocking", "decision_required", "not_applicable"] },
        "completeness": { "enum": ["complete", "partial", "unknown"] },
        "currentness": { "enum": ["current", "stale", "not_probed", "partial_or_unavailable"] },
        "reason": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string", "minLength": 1 },
            "message": { "type": "string", "minLength": 1 }
          }
        },
        "primary_action": { "$ref": "#/$defs/core_command_action" },
        "additional_action_count": { "type": "integer", "minimum": 0 },
        "additional_actions_ref": { "type": ["string", "null"] },
        "operation_effects": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reads_repository", "writes_repository", "executes_repository_code", "invokes_network"],
          "properties": {
            "reads_repository": { "type": "boolean" },
            "writes_repository": { "type": "boolean" },
            "executes_repository_code": { "type": "boolean" },
            "invokes_network": { "type": "boolean" },
            "write_paths": { "type": "array", "items": { "type": "string" } },
            "explicit_non_effects": { "type": "array", "items": { "type": "string" } }
          }
        },
        "next_proof": { "$ref": "#/$defs/core_command_action" },
        "artifacts": { "type": "array", "items": { "$ref": "#/$defs/core_command_artifact" } },
        "claim_boundary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["statement"],
          "properties": {
            "statement": { "type": "string", "minLength": 1 },
            "limitations": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "core_command_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "title", "write_posture", "reason", "expected_effect", "proof_boundary"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["command", "navigation", "decision", "external"] },
        "title": { "type": "string", "minLength": 1 },
        "program": { "type": ["string", "null"] },
        "args": { "type": "array", "items": { "type": "string" } },
        "write_posture": { "enum": ["read_only", "preview_only", "candidate_write", "live_mutation", "external"] },
        "may_write_paths": { "type": "array", "items": { "type": "string" } },
        "reason": { "type": "string", "minLength": 1 },
        "expected_effect": { "type": "string", "minLength": 1 },
        "proof_boundary": { "type": "string", "minLength": 1 }
      }
    },
    "core_command_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "schema_id", "path"],
      "properties": {
        "kind": { "type": "string" },
        "schema_id": { "type": "string" },
        "path": { "type": "string" },
        "digest": { "type": ["string", "null"] }
      }
    },
    "claim_boundary_flag": {
      "type": "string",
      "enum": [
        "source_tree_inventory",
        "source_syntax_only",
        "cargo_metadata_not_invoked",
        "cargo_commands_not_invoked",
        "rustc_not_invoked",
        "clippy_not_invoked",
        "build_scripts_not_executed",
        "proc_macros_not_executed",
        "macro_expansion_not_analyzed",
        "macro_token_tree_contents_not_analyzed",
        "type_information_not_analyzed",
        "mir_not_analyzed",
        "build_output_not_analyzed",
        "control_flow_not_analyzed",
        "data_flow_not_analyzed",
        "external_evidence_tools_not_invoked",
        "repository_code_not_executed",
        "source_text_in_identity_fields"
      ]
    },
    "scanner_limitation": {
      "type": "string",
      "enum": [
        "cargo_metadata_not_invoked",
        "cargo_commands_not_invoked",
        "rustc_not_invoked",
        "clippy_not_invoked",
        "build_scripts_not_executed",
        "proc_macros_not_executed",
        "macro_expansion_not_analyzed",
        "macro_token_tree_contents_not_analyzed",
        "type_information_not_analyzed",
        "mir_not_analyzed",
        "build_output_not_analyzed",
        "control_flow_not_analyzed",
        "data_flow_not_analyzed",
        "external_evidence_tools_not_invoked",
        "repository_code_not_executed"
      ]
    },
    "allow_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "matches",
        "kind",
        "owner",
        "classification",
        "scope",
        "evidence_count",
        "selector_precision",
        "broad_scope",
        "reason"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "matched",
            "new",
            "stale",
            "expired",
            "review_due",
            "location_drift",
            "ambiguous",
            "invalid_selector",
            "missing_required_field",
            "evidence_missing",
            "baseline_debt"
          ]
        },
        "matches": {
          "type": "integer",
          "minimum": 0
        },
        "kind": {
          "enum": [
            "panic",
            "unsafe",
            "lint_exception",
            "non_rust_file",
            "generated_code",
            "policy_exception"
          ]
        },
        "family": {
          "type": "string",
          "description": "Scanner-provided policy family; omitted when unavailable."
        },
        "owner": {
          "type": "string"
        },
        "classification": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "source_package": {
          "type": "string",
          "description": "Scanner-provided source package context; omitted when unavailable and not Cargo metadata or build proof."
        },
        "evidence_count": {
          "type": "integer",
          "minimum": 0
        },
        "broken_evidence_references": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of local evidence or link references on this allow entry that are missing or invalid. Optional for list.v1 compatibility."
        },
        "weak_evidence_references": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of evidence or link references on this allow entry that are unstructured or use an unknown prefix. Optional for list.v1 compatibility."
        },
        "selector_precision": {
          "type": "integer",
          "minimum": 0,
          "description": "Relative selector precision score for this allow entry. Higher values indicate a more specific source-tree selector; line and column hints do not increase this score."
        },
        "broad_scope": {
          "type": "boolean",
          "description": "Whether this allow entry uses wildcard source-tree scope in path, glob, or selector glob."
        },
        "review_after": {
          "type": "string",
          "description": "Review deadline; omitted when unavailable."
        },
        "expires": {
          "type": "string",
          "description": "Expiration deadline; omitted when unavailable."
        },
        "reason": {
          "type": "string"
        }
      }
    }
  }
}

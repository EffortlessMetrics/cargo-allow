{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EffortlessMetrics/cargo-allow/blob/main/docs/schemas/release-manifest-v2.schema.json",
  "title": "cargo-allow ReleaseManifestEnvelopeV2",
  "description": "A deterministic semantic release payload plus a non-semantic execution envelope. It does not authorize publication.",
  "type": "object",
  "additionalProperties": false,
  "required": ["payload", "generated_at", "workflow_path", "artifact_references", "instrument_diagnostics"],
  "properties": {
    "payload": { "$ref": "#/$defs/payload" },
    "generated_at": { "type": "string", "minLength": 1 },
    "workflow_path": { "type": "string", "minLength": 1 },
    "workflow_run_id": { "type": "integer", "minimum": 1 },
    "workflow_attempt": { "type": "integer", "minimum": 1 },
    "event": { "type": "string", "minLength": 1 },
    "github_ref": { "type": "string", "minLength": 1 },
    "artifact_references": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "authorization_reference": { "type": "string", "minLength": 1 },
    "instrument_diagnostics": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id", "schema_version", "operation", "repository", "tag_or_authorization",
        "commit", "tree", "package_rows", "authentication", "publication_posture",
        "support_posture", "limitations", "claim_boundary"
      ],
      "properties": {
        "schema_id": { "const": "cargo-allow.release-manifest.v2" },
        "schema_version": { "const": 2 },
        "operation": { "enum": ["namespace_claim", "cargo_allow_release", "recovery"] },
        "repository": { "type": "string", "minLength": 1 },
        "tag_or_authorization": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "minLength": 1 },
        "tree": { "type": "string", "minLength": 1 },
        "cargo_lock_digest": { "$ref": "#/$defs/digest" },
        "architecture_digest": { "$ref": "#/$defs/digest" },
        "candidate_digest": { "$ref": "#/$defs/digest" },
        "package_rows": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/package_row" }
        },
        "authentication": {
          "oneOf": [
            { "const": "crates_io_api_token" },
            { "type": "object", "required": ["other_explicit"], "additionalProperties": false, "properties": { "other_explicit": { "type": "string", "minLength": 1 } } },
            { "const": "missing" }
          ]
        },
        "publication_posture": { "enum": ["unpublished", "published", "partially_published", "incident"] },
        "support_posture": { "enum": ["experimental", "supported", "unsupported"] },
        "limitations": { "type": "array", "items": { "type": "string" } },
        "claim_boundary": { "type": "string", "minLength": 1 }
      }
    },
    "package_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logical_id", "package_name", "package_version", "release_order"],
      "properties": {
        "logical_id": { "type": "string", "minLength": 1 },
        "package_name": { "type": "string", "minLength": 1 },
        "package_version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-rc\\.[1-9][0-9]*)?$" },
        "release_order": { "type": "integer", "minimum": 1 },
        "crate_digest": { "$ref": "#/$defs/digest" },
        "registry_checksum": { "$ref": "#/$defs/digest" }
      }
    }
  }
}

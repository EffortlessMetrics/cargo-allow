{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cargo-allow.rc-publication-incident.v1",
  "title": "RC publication incident reconciliation record",
  "description": "Reconciles one moved-tag prerelease publication sequence against retained evidence and current registry state (#3759). Channel posture and final-candidate eligibility are fixed by the incident ruling and are not free fields.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "incident_id",
    "channel_version",
    "channel_tag",
    "attempts",
    "tag_observation",
    "row_reconciliations",
    "github_release",
    "registry_observation",
    "observation_completeness",
    "observation_limits",
    "channel_posture",
    "final_candidate_eligibility",
    "claim_boundary"
  ],
  "properties": {
    "schema": { "const": "cargo-allow.rc-publication-incident.v1" },
    "incident_id": { "type": "string", "minLength": 1 },
    "channel_version": { "type": "string" },
    "channel_tag": { "type": "string" },
    "attempts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["run_id", "commit", "tree", "conclusion", "result_class", "retained_publish_receipt_artifact_id"],
        "properties": {
          "run_id": { "type": "integer" },
          "commit": { "type": "string", "pattern": "^[0-9a-fA-F]{40,64}$" },
          "tree": { "type": "string", "pattern": "^[0-9a-fA-F]{40,64}$" },
          "conclusion": { "type": "string" },
          "result_class": { "type": "string" },
          "retained_publish_receipt_artifact_id": { "type": "integer" }
        }
      }
    },
    "tag_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current_tag_object", "current_target_commit", "events", "observation_limit"],
      "properties": {
        "current_tag_object": { "type": "string" },
        "current_target_commit": { "type": "string", "pattern": "^[0-9a-fA-F]{40,64}$" },
        "events": { "type": "array", "items": { "type": "string" } },
        "observation_limit": { "type": ["string", "null"] }
      }
    },
    "row_reconciliations": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": { "$ref": "#/$defs/rowReconciliation" }
    },
    "github_release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "draft", "prerelease", "asset_count", "observed_note"],
      "properties": {
        "name": { "type": "string" },
        "draft": { "type": "boolean" },
        "prerelease": { "type": "boolean" },
        "asset_count": { "type": "integer" },
        "observed_note": { "type": "string" }
      }
    },
    "registry_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed_at", "rows_present", "yanked_count"],
      "properties": {
        "observed_at": { "type": "string" },
        "rows_present": { "type": "integer" },
        "yanked_count": { "type": "integer" }
      }
    },
    "observation_completeness": {
      "enum": ["complete_observation", "partial_observation", "provider_unavailable", "instrument_failure"]
    },
    "observation_limits": { "type": "array", "items": { "type": "string" } },
    "channel_posture": { "const": "public_prerelease_with_incident" },
    "final_candidate_eligibility": { "const": "not_reusable" },
    "claim_boundary": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "rowReconciliation": {
      "type": "object",
      "oneOf": [
        {
          "title": "published_exact_candidate",
          "required": ["state", "package", "version", "candidate_commit", "candidate_tree", "candidate_receipt_artifact_id", "expected_checksum", "observed_checksum"],
          "properties": {
            "state": { "const": "published_exact_candidate" },
            "package": { "type": "string" },
            "version": { "type": "string" },
            "candidate_commit": { "type": "string", "pattern": "^[0-9a-fA-F]{40,64}$" },
            "candidate_tree": { "type": "string", "pattern": "^[0-9a-fA-F]{40,64}$" },
            "candidate_receipt_artifact_id": { "type": "integer" },
            "expected_checksum": { "$ref": "#/$defs/sha256" },
            "observed_checksum": { "$ref": "#/$defs/sha256" }
          }
        },
        {
          "title": "published_across_candidate_history",
          "required": ["state", "package", "version", "registry_checksum", "retained_candidate_checksums", "note"],
          "properties": {
            "state": { "const": "published_across_candidate_history" },
            "package": { "type": "string" },
            "version": { "type": "string" },
            "registry_checksum": { "$ref": "#/$defs/sha256" },
            "retained_candidate_checksums": { "type": "array", "items": { "$ref": "#/$defs/sha256" } },
            "note": { "type": "string", "minLength": 1 }
          }
        },
        {
          "title": "published_but_candidate_evidence_unavailable",
          "required": ["state", "package", "version", "registry_checksum", "note"],
          "properties": {
            "state": { "const": "published_but_candidate_evidence_unavailable" },
            "package": { "type": "string" },
            "version": { "type": "string" },
            "registry_checksum": { "$ref": "#/$defs/sha256" },
            "note": { "type": "string", "minLength": 1 }
          }
        },
        {
          "title": "missing",
          "required": ["state", "package", "version"],
          "properties": {
            "state": { "const": "missing" },
            "package": { "type": "string" },
            "version": { "type": "string" }
          }
        },
        {
          "title": "yanked",
          "required": ["state", "package", "version", "registry_checksum"],
          "properties": {
            "state": { "const": "yanked" },
            "package": { "type": "string" },
            "version": { "type": "string" },
            "registry_checksum": { "$ref": "#/$defs/sha256" }
          }
        },
        {
          "title": "checksum_conflict",
          "required": ["state", "package", "version", "expected_checksum", "observed_checksum"],
          "properties": {
            "state": { "const": "checksum_conflict" },
            "package": { "type": "string" },
            "version": { "type": "string" },
            "expected_checksum": { "$ref": "#/$defs/sha256" },
            "observed_checksum": { "$ref": "#/$defs/sha256" }
          }
        },
        {
          "title": "provider_unavailable",
          "required": ["state", "package"],
          "properties": {
            "state": { "const": "provider_unavailable" },
            "package": { "type": "string" }
          }
        },
        {
          "title": "instrument_failure",
          "required": ["state", "package", "note"],
          "properties": {
            "state": { "const": "instrument_failure" },
            "package": { "type": "string" },
            "note": { "type": "string", "minLength": 1 }
          }
        }
      ]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://effortlessmetrics.dev/schemas/cargo-allow/propose.v1.schema.json",
  "title": "cargo-allow propose v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema_id",
    "tool",
    "command",
    "claim_boundary",
    "scanner_limitations",
    "inventory",
    "options",
    "summary",
    "generated_entry_defaults"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "schema_id": {
      "const": "cargo-allow.propose.v1"
    },
    "tool": {
      "const": "cargo-allow"
    },
    "command": {
      "const": "propose"
    },
    "claim_boundary": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim_boundary_flag"
      }
    },
    "scanner_limitations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scanner_limitation"
      }
    },
    "inventory": {
      "$ref": "#/$defs/inventory"
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "expires",
        "policy_output",
        "force"
      ],
      "properties": {
        "kind": {
          "type": [
            "string",
            "null"
          ]
        },
        "expires": {
          "type": "string"
        },
        "policy_output": {
          "type": [
            "string",
            "null"
          ],
          "description": "Path where proposed TOML policy was written, or null when policy output went to stdout."
        },
        "force": {
          "type": "boolean"
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "findings_scanned",
        "baseline_debt_entries_proposed"
      ],
      "properties": {
        "findings_scanned": {
          "type": "integer",
          "minimum": 0
        },
        "baseline_debt_entries_proposed": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "generated_entry_defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "classification",
        "reason",
        "expires"
      ],
      "properties": {
        "owner": {
          "const": "unowned"
        },
        "classification": {
          "const": "baseline_debt"
        },
        "reason": {
          "const": "Generated by cargo-allow propose; requires human review."
        },
        "expires": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "claim_boundary_flag": {
      "type": "string",
      "enum": [
        "source_tree_inventory",
        "source_syntax_only",
        "cargo_metadata_not_invoked",
        "cargo_commands_not_invoked",
        "rustc_not_invoked",
        "clippy_not_invoked",
        "build_scripts_not_executed",
        "proc_macros_not_executed",
        "macro_expansion_not_analyzed",
        "macro_token_tree_contents_not_analyzed",
        "type_information_not_analyzed",
        "mir_not_analyzed",
        "build_output_not_analyzed",
        "control_flow_not_analyzed",
        "data_flow_not_analyzed",
        "repository_code_not_executed"
      ]
    },
    "scanner_limitation": {
      "type": "string",
      "enum": [
        "cargo_metadata_not_invoked",
        "cargo_commands_not_invoked",
        "rustc_not_invoked",
        "clippy_not_invoked",
        "build_scripts_not_executed",
        "proc_macros_not_executed",
        "macro_expansion_not_analyzed",
        "macro_token_tree_contents_not_analyzed",
        "type_information_not_analyzed",
        "mir_not_analyzed",
        "build_output_not_analyzed",
        "control_flow_not_analyzed",
        "data_flow_not_analyzed",
        "repository_code_not_executed"
      ]
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "scanner",
        "source"
      ],
      "properties": {
        "scope": {
          "const": "source_tree"
        },
        "scanner": {
          "const": "source_syntax"
        },
        "source": {
          "enum": [
            "git_tracked",
            "filesystem_fallback",
            "filesystem_include_untracked",
            "unknown"
          ]
        },
        "root": {
          "type": "string",
          "description": "Local source-tree root used for this proposal summary. This may be an absolute path."
        },
        "files_scanned": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of source-tree inventory files considered before scanner filtering, when collected."
        }
      }
    }
  }
}

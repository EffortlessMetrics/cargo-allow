{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://effortlessmetrics.dev/schemas/cargo-allow/propose.v1.schema.json",
  "title": "cargo-allow propose v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema_id",
    "tool",
    "command",
    "claim_boundary",
    "scanner_limitations",
    "inventory",
    "options",
    "summary",
    "mutation_receipt",
    "generated_entry_defaults"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "schema_id": {
      "const": "cargo-allow.propose.v1"
    },
    "tool": {
      "const": "cargo-allow"
    },
    "command": {
      "const": "propose"
    },
    "claim_boundary": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim_boundary_flag"
      }
    },
    "scanner_limitations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scanner_limitation"
      }
    },
    "inventory": {
      "$ref": "#/$defs/inventory"
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": [
            "string",
            "null"
          ]
        },
        "expires": {
          "type": "string"
        },
        "policy_output": {
          "type": [
            "string",
            "null"
          ],
          "description": "Path where proposed TOML policy was written, or null when policy output went to stdout."
        },
        "force": {
          "type": "boolean"
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "findings_scanned",
        "baseline_debt_entries_proposed"
      ],
      "properties": {
        "findings_scanned": {
          "type": "integer",
          "minimum": 0
        },
        "baseline_debt_entries_proposed": {
          "type": "integer",
          "minimum": 0
        },
        "unsafe_baseline_debt_entries_proposed": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of proposed baseline_debt entries for unsafe findings. Generated unsafe baseline entries still require real evidence and human review."
        },
        "truncated_new_findings": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of new findings not proposed because the --max limit was reached. Non-zero means the proposal is incomplete; rerun with --max 0 to see all."
        },
        "unreceiptable_new_findings": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of new findings deliberately not proposed because the policy's own requirements forbid receipting them. These findings are not suppressed: check --mode no-new still reports them as new. Raising --max will not propose them."
        },
        "unreceiptable_reason": {
          "type": [
            "string",
            "null"
          ],
          "description": "Which requirement forbade the skipped entries, or null when unreceiptable_new_findings is 0."
        }
      }
    },
    "follow_up_queues": {
      "type": "array",
      "description": "Optional follow-up worklist queues emitted when proposal generation creates temporary baseline debt.",
      "items": {
        "$ref": "#/$defs/follow_up_queue"
      }
    },
    "mutation_receipt": {
      "$ref": "#/$defs/mutation_receipt"
    },
    "generated_entry_defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "classification",
        "reason",
        "expires"
      ],
      "properties": {
        "owner": {
          "const": "unowned"
        },
        "classification": {
          "const": "baseline_debt"
        },
        "reason": {
          "const": "Generated by cargo-allow propose; requires human review."
        },
        "expires": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "mutation_receipt": {
      "type": "object",
      "additionalProperties": false,
      "description": "Shared provenance envelope for mutation commands (CARGO-ALLOW-SPEC-0008 Mutation Receipt Envelope, GOAL-0004 PR 5).",
      "required": [
        "schema_id",
        "operation",
        "tool_version",
        "repo_root",
        "config_source",
        "ledger_ids",
        "changed_allow_ids",
        "before_fingerprints",
        "after_fingerprints",
        "result",
        "next_commands",
        "claim_boundary"
      ],
      "properties": {
        "schema_id": { "const": "cargo-allow.mutation-receipt.v1" },
        "operation": { "const": "propose" },
        "tool_version": { "type": "string" },
        "repo_root": { "type": ["string", "null"] },
        "config_source": { "type": ["string", "null"] },
        "ledger_ids": { "type": "array", "items": { "type": "string" } },
        "changed_allow_ids": { "type": "array", "items": { "type": "string" } },
        "before_fingerprints": {
          "type": "array",
          "items": { "type": ["string", "null"], "pattern": "^sha256:v1:[0-9a-f]{64}$" }
        },
        "after_fingerprints": {
          "type": "array",
          "items": { "type": ["string", "null"], "pattern": "^sha256:v1:[0-9a-f]{64}$" }
        },
        "result": { "type": "string" },
        "next_commands": { "type": "array", "items": { "type": "string" } },
        "claim_boundary": { "type": "string" }
      }
    },
    "claim_boundary_flag": {
      "type": "string",
      "enum": [
        "source_tree_inventory",
        "source_syntax_only",
        "cargo_metadata_not_invoked",
        "cargo_commands_not_invoked",
        "rustc_not_invoked",
        "clippy_not_invoked",
        "build_scripts_not_executed",
        "proc_macros_not_executed",
        "macro_expansion_not_analyzed",
        "macro_token_tree_contents_not_analyzed",
        "type_information_not_analyzed",
        "mir_not_analyzed",
        "build_output_not_analyzed",
        "control_flow_not_analyzed",
        "data_flow_not_analyzed",
        "external_evidence_tools_not_invoked",
        "repository_code_not_executed",
        "source_text_in_identity_fields"
      ]
    },
    "scanner_limitation": {
      "type": "string",
      "enum": [
        "cargo_metadata_not_invoked",
        "cargo_commands_not_invoked",
        "rustc_not_invoked",
        "clippy_not_invoked",
        "build_scripts_not_executed",
        "proc_macros_not_executed",
        "macro_expansion_not_analyzed",
        "macro_token_tree_contents_not_analyzed",
        "type_information_not_analyzed",
        "mir_not_analyzed",
        "build_output_not_analyzed",
        "control_flow_not_analyzed",
        "data_flow_not_analyzed",
        "external_evidence_tools_not_invoked",
        "repository_code_not_executed"
      ]
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "scanner",
        "source"
      ],
      "properties": {
        "scope": {
          "const": "source_tree"
        },
        "scanner": {
          "const": "source_syntax"
        },
        "source": {
          "enum": [
            "git_tracked",
            "git_index_staged_candidate",
            "filesystem_fallback",
            "filesystem_include_untracked",
            "unknown"
          ]
        },
        "root": {
          "type": "string",
          "minLength": 1,
          "description": "Local source-tree root used for this proposal summary. This may be an absolute path."
        },
        "files_scanned": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of source-tree inventory files considered before scanner filtering, when collected."
        },
        "empty_git_tracked": {
          "type": "boolean",
          "description": "True when git inventory succeeded but reported no tracked files, such as a freshly initialized repo before git add."
        },
        "completeness": {
          "type": "string",
          "enum": ["complete", "scoped", "fallback", "partial"],
          "description": "Authoritative inventory coverage classification for this artifact."
        }
      }
    },
    "follow_up_queue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signal",
        "route_kind",
        "item_kind",
        "count",
        "command"
      ],
      "properties": {
        "signal": {
          "enum": [
            "baseline_debt_entries_proposed",
            "unsafe_baseline_debt_entries_proposed"
          ],
          "description": "Proposal summary signal routed by this follow-up queue."
        },
        "label": {
          "type": "string",
          "description": "Human-friendly queue label for display and agent logs."
        },
        "route_kind": {
          "enum": [
            "worklist_filter",
            "worklist_item_kind"
          ],
          "description": "Machine routing mode for the follow-up command."
        },
        "item_kind": {
          "enum": [
            "baseline_debt",
            "weak_evidence_reference"
          ],
          "description": "Stable cargo-allow worklist item kind associated with this follow-up queue."
        },
        "worklist_filter": {
          "enum": [
            "baseline_debt"
          ],
          "description": "Named worklist filter used by this row when route_kind is worklist_filter."
        },
        "count": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of proposed entries routed by this queue."
        },
        "command": {
          "type": "string",
          "description": "Suggested cargo-allow worklist command for this queue."
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://effortlessmetrics.dev/schemas/cargo-allow/add-plan-application.v1.schema.json",
  "title": "cargo-allow add-plan-application v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "schema_id", "tool", "tool_version", "command", "claim_boundary", "scanner_limitations", "inventory", "plan_digest", "repository_identity", "finding_digest", "target_ledger", "policy_before_digest", "policy_after_digest", "added_allow_id", "targeted_recheck", "full_check_argv"],
  "properties": {
    "schema_version": { "const": 1 },
    "schema_id": { "const": "cargo-allow.add-plan-application.v1" },
    "tool": { "const": "cargo-allow" },
    "tool_version": { "type": "string", "minLength": 1 },
    "command": { "const": "add" },
    "claim_boundary": { "type": "array", "items": { "$ref": "#/$defs/claim_boundary_flag" } },
    "scanner_limitations": { "type": "array", "items": { "$ref": "#/$defs/scanner_limitation" } },
    "inventory": { "$ref": "#/$defs/inventory" },
    "plan_digest": { "$ref": "#/$defs/sha256_v1" },
    "repository_identity": { "$ref": "#/$defs/sha256_v1" },
    "finding_digest": { "$ref": "#/$defs/sha256_v1" },
    "target_ledger": { "type": "string", "minLength": 1 },
    "policy_before_digest": { "$ref": "#/$defs/sha256_v1" },
    "policy_after_digest": { "$ref": "#/$defs/sha256_v1" },
    "added_allow_id": { "type": "string", "minLength": 1 },
    "targeted_recheck": {
      "anyOf": [
        { "enum": ["matched", "still_new", "no_outcome", "not_executed"] },
        { "type": "string", "pattern": "^unexpected:.+$" }
      ]
    },
    "full_check_argv": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
  },
  "$defs": {
    "claim_boundary_flag": { "type": "string", "enum": ["source_tree_inventory", "source_syntax_only", "cargo_metadata_not_invoked", "cargo_commands_not_invoked", "rustc_not_invoked", "clippy_not_invoked", "build_scripts_not_executed", "proc_macros_not_executed", "macro_expansion_not_analyzed", "macro_token_tree_contents_not_analyzed", "type_information_not_analyzed", "mir_not_analyzed", "build_output_not_analyzed", "control_flow_not_analyzed", "data_flow_not_analyzed", "external_evidence_tools_not_invoked", "repository_code_not_executed", "source_text_in_identity_fields", "proof_commands_not_executed", "targeted_recheck_not_executed", "full_repository_check_not_executed"] },
    "scanner_limitation": { "type": "string", "enum": ["cargo_metadata_not_invoked", "cargo_commands_not_invoked", "rustc_not_invoked", "clippy_not_invoked", "build_scripts_not_executed", "proc_macros_not_executed", "macro_expansion_not_analyzed", "macro_token_tree_contents_not_analyzed", "type_information_not_analyzed", "mir_not_analyzed", "build_output_not_analyzed", "control_flow_not_analyzed", "data_flow_not_analyzed", "external_evidence_tools_not_invoked", "repository_code_not_executed"] },
    "sha256_v1": { "type": "string", "pattern": "^sha256:v1:[0-9a-f]{64}$" },
    "inventory": { "type": "object", "additionalProperties": false, "required": ["scope", "scanner", "source"], "properties": { "scope": { "const": "source_tree" }, "scanner": { "const": "source_syntax" }, "source": { "enum": ["git_tracked", "git_index_staged_candidate", "filesystem_fallback", "filesystem_include_untracked", "unknown"] }, "root": { "type": "string", "minLength": 1 }, "files_scanned": { "type": "integer", "minimum": 0 }, "empty_git_tracked": { "type": "boolean" }, "completeness": { "enum": ["complete", "scoped", "fallback", "partial"] } } }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://effortlessmetrics.dev/schemas/cargo-allow/refresh.v1.schema.json",
  "title": "cargo-allow refresh v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema_id",
    "tool",
    "command",
    "claim_boundary",
    "scanner_limitations",
    "inventory",
    "mode",
    "summary",
    "previous_last_seen",
    "refreshed_last_seen",
    "matched_finding",
    "mutation_receipt"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "schema_id": {
      "const": "cargo-allow.refresh.v1"
    },
    "tool": {
      "const": "cargo-allow"
    },
    "command": {
      "const": "refresh"
    },
    "claim_boundary": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim_boundary_flag"
      }
    },
    "scanner_limitations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scanner_limitation"
      }
    },
    "inventory": {
      "$ref": "#/$defs/inventory"
    },
    "mode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dry_run",
        "write_requested",
        "explicit_dry_run",
        "written_path"
      ],
      "properties": {
        "dry_run": {
          "type": "boolean"
        },
        "write_requested": {
          "type": "boolean"
        },
        "explicit_dry_run": {
          "type": "boolean"
        },
        "written_path": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_id",
        "drift_message",
        "lifecycle_preserved"
      ],
      "properties": {
        "entry_id": {
          "type": "string"
        },
        "drift_message": {
          "type": "string"
        },
        "lifecycle_preserved": {
          "const": true,
          "description": "The current refresh command updates only the entry-level last_seen observation. It does not change lifecycle or authorization fields. A future lifecycle-changing refresh must introduce an explicitly versioned contract change rather than repurposing this field."
        },
        "operator_approved": {
          "type": "boolean"
        }
      }
    },
    "previous_last_seen": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "line",
        "column"
      ],
      "properties": {
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "refreshed_last_seen": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "line",
        "column"
      ],
      "properties": {
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "matched_finding": {
      "type": "string"
    },
    "mutation_receipt": {
      "$ref": "#/$defs/mutation_receipt"
    }
  },
  "$defs": {
    "claim_boundary_flag": {
      "type": "string",
      "enum": [
        "source_tree_inventory",
        "source_syntax_only",
        "cargo_metadata_not_invoked",
        "cargo_commands_not_invoked",
        "rustc_not_invoked",
        "clippy_not_invoked",
        "build_scripts_not_executed",
        "proc_macros_not_executed",
        "macro_expansion_not_analyzed",
        "macro_token_tree_contents_not_analyzed",
        "type_information_not_analyzed",
        "mir_not_analyzed",
        "build_output_not_analyzed",
        "control_flow_not_analyzed",
        "data_flow_not_analyzed",
        "external_evidence_tools_not_invoked",
        "repository_code_not_executed",
        "source_text_in_identity_fields"
      ]
    },
    "scanner_limitation": {
      "type": "string",
      "enum": [
        "cargo_metadata_not_invoked",
        "cargo_commands_not_invoked",
        "rustc_not_invoked",
        "clippy_not_invoked",
        "build_scripts_not_executed",
        "proc_macros_not_executed",
        "macro_expansion_not_analyzed",
        "macro_token_tree_contents_not_analyzed",
        "type_information_not_analyzed",
        "mir_not_analyzed",
        "build_output_not_analyzed",
        "control_flow_not_analyzed",
        "data_flow_not_analyzed",
        "external_evidence_tools_not_invoked",
        "repository_code_not_executed"
      ]
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "scanner",
        "source"
      ],
      "properties": {
        "scope": {
          "const": "source_tree"
        },
        "scanner": {
          "const": "source_syntax"
        },
        "source": {
          "enum": [
            "git_tracked",
            "git_index_staged_candidate",
            "filesystem_fallback",
            "filesystem_include_untracked",
            "unknown"
          ]
        },
        "root": {
          "type": "string",
          "minLength": 1,
          "description": "Local source-tree root used for this refresh artifact. This may be an absolute path."
        },
        "files_scanned": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of source-tree inventory files considered before scanner filtering, when collected."
        },
        "empty_git_tracked": {
          "type": "boolean",
          "description": "True when git inventory succeeded but reported no tracked files, such as a freshly initialized repo before git add."
        },
        "completeness": {
          "type": "string",
          "enum": ["complete", "scoped", "fallback", "partial"],
          "description": "Authoritative inventory coverage classification for this artifact."
        }
      }
    },
    "mutation_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "operation",
        "tool_version",
        "repo_root",
        "config_source",
        "ledger_ids",
        "changed_allow_ids",
        "before_fingerprints",
        "after_fingerprints",
        "result",
        "next_commands",
        "claim_boundary"
      ],
      "properties": {
        "schema_id": { "const": "cargo-allow.mutation-receipt.v1" },
        "operation": { "const": "refresh" },
        "tool_version": { "type": "string", "minLength": 1 },
        "repo_root": { "type": ["string", "null"] },
        "config_source": { "type": ["string", "null"] },
        "ledger_ids": { "type": "array", "items": { "type": "string" } },
        "changed_allow_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "before_fingerprints": {
          "type": "array",
          "minItems": 1,
          "items": { "type": ["string", "null"], "pattern": "^sha256:v1:[0-9a-f]{64}$" }
        },
        "after_fingerprints": {
          "type": "array",
          "minItems": 1,
          "items": { "type": ["string", "null"], "pattern": "^sha256:v1:[0-9a-f]{64}$" }
        },
        "result": { "enum": ["stdout", "written"] },
        "next_commands": { "type": "array", "items": { "type": "string" } },
        "claim_boundary": { "type": "string", "minLength": 1 }
      }
    }
  }
}

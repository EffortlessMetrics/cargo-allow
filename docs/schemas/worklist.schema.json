{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://effortlessmetrics.dev/schemas/cargo-allow/worklist.v1.schema.json",
  "title": "cargo-allow worklist v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema_id",
    "tool",
    "command",
    "claim_boundary",
    "inventory",
    "summary",
    "work_items"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "schema_id": {
      "const": "cargo-allow.worklist.v1"
    },
    "tool": {
      "const": "cargo-allow"
    },
    "command": {
      "const": "worklist"
    },
    "claim_boundary": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim_boundary_flag"
      },
      "contains": {
        "const": "source_tree_inventory"
      }
    },
    "scanner_limitations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scanner_limitation"
      },
      "description": "Explicit scanner and execution limitations for this source-tree worklist artifact.",
      "contains": {
        "const": "cargo_metadata_not_invoked"
      }
    },
    "inventory": {
      "$ref": "#/$defs/inventory"
    },
    "filters": {
      "$ref": "#/$defs/filters",
      "description": "Applied worklist filters. Absent in older v1 artifacts; null fields mean no filter was applied for that dimension."
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "work_items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/work_item"
      }
    }
  },
  "$defs": {
    "claim_boundary_flag": {
      "type": "string",
      "enum": [
        "source_tree_inventory",
        "source_syntax_only",
        "cargo_metadata_not_invoked",
        "cargo_commands_not_invoked",
        "rustc_not_invoked",
        "clippy_not_invoked",
        "build_scripts_not_executed",
        "proc_macros_not_executed",
        "macro_expansion_not_analyzed",
        "macro_token_tree_contents_not_analyzed",
        "type_information_not_analyzed",
        "mir_not_analyzed",
        "build_output_not_analyzed",
        "control_flow_not_analyzed",
        "data_flow_not_analyzed",
        "repository_code_not_executed"
      ]
    },
    "scanner_limitation": {
      "type": "string",
      "enum": [
        "cargo_metadata_not_invoked",
        "cargo_commands_not_invoked",
        "rustc_not_invoked",
        "clippy_not_invoked",
        "build_scripts_not_executed",
        "proc_macros_not_executed",
        "macro_expansion_not_analyzed",
        "macro_token_tree_contents_not_analyzed",
        "type_information_not_analyzed",
        "mir_not_analyzed",
        "build_output_not_analyzed",
        "control_flow_not_analyzed",
        "data_flow_not_analyzed",
        "repository_code_not_executed"
      ]
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "scanner", "source"],
      "properties": {
        "scope": {
          "const": "source_tree"
        },
        "scanner": {
          "const": "source_syntax"
        },
        "source": {
          "enum": [
            "unknown",
            "git_tracked",
            "filesystem_fallback",
            "filesystem_include_untracked"
          ]
        },
        "root": {
          "type": "string",
          "minLength": 1,
          "description": "Local source-tree root used for this worklist. This may be an absolute path in local artifacts."
        },
        "files_scanned": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of source-tree inventory files considered before scanner filtering, when a full inventory was collected."
        }
      }
    },
    "filters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "risk", "difficulty"],
      "properties": {
        "kind": {
          "type": ["string", "null"],
          "description": "Applied --kind filter, or null when the worklist includes all governed kinds."
        },
        "item_kind": {
          "type": ["string", "null"],
          "description": "Applied --item-kind filter, or null when all work item queue kinds are included."
        },
        "owner": {
          "type": ["string", "null"],
          "description": "Applied --owner filter, or null when all policy owners are included."
        },
        "classification": {
          "type": ["string", "null"],
          "description": "Applied --classification filter, or null when all policy classifications are included."
        },
        "risk": {
          "type": ["string", "null"],
          "enum": ["low", "medium", "high", null],
          "description": "Applied --risk filter, or null when all risk levels are included."
        },
        "difficulty": {
          "type": ["string", "null"],
          "enum": ["small", "medium", null],
          "description": "Applied --difficulty filter, or null when all difficulty levels are included."
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work_items",
        "high",
        "medium",
        "low",
        "small_difficulty",
        "medium_difficulty"
      ],
      "properties": {
        "work_items": {
          "type": "integer",
          "minimum": 0
        },
        "high": {
          "type": "integer",
          "minimum": 0
        },
        "medium": {
          "type": "integer",
          "minimum": 0
        },
        "low": {
          "type": "integer",
          "minimum": 0
        },
        "small_difficulty": {
          "type": "integer",
          "minimum": 0,
          "description": "Count of work items estimated as small difficulty."
        },
        "medium_difficulty": {
          "type": "integer",
          "minimum": 0,
          "description": "Count of work items estimated as medium difficulty."
        }
      }
    },
    "work_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "risk",
        "difficulty",
        "status",
        "allow_id",
        "finding_index",
        "path",
        "source_package",
        "message",
        "suggested_actions",
        "proof_commands"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^work-[a-z0-9-]+-[0-9]{4}$"
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "exception_kind": {
          "type": ["string", "null"],
          "enum": [
            "panic",
            "unsafe",
            "lint_exception",
            "non_rust_file",
            "generated_code",
            "policy_exception",
            null
          ],
          "description": "Governed source exception surface behind the work item, when known."
        },
        "family": {
          "type": ["string", "null"],
          "description": "More specific scanner or policy family behind the work item, when known."
        },
        "owner": {
          "type": ["string", "null"],
          "description": "Policy owner for the related allow entry, when the work item is tied to policy."
        },
        "classification": {
          "type": ["string", "null"],
          "description": "Policy classification for the related allow entry, when available."
        },
        "reason": {
          "type": ["string", "null"],
          "description": "Policy reason for the related allow entry, when available."
        },
        "created": {
          "type": ["string", "null"],
          "description": "Policy creation date for the related allow entry, when available."
        },
        "review_after": {
          "type": ["string", "null"],
          "description": "Policy review-after date for the related allow entry, when available."
        },
        "expires": {
          "type": ["string", "null"],
          "description": "Policy expiry date for the related allow entry, when available."
        },
        "evidence_count": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "Number of evidence references on the related allow entry, when available."
        },
        "risk": {
          "enum": ["high", "medium", "low"]
        },
        "difficulty": {
          "enum": ["small", "medium"]
        },
        "status": {
          "enum": [
            "matched",
            "new",
            "stale",
            "expired",
            "review_due",
            "ambiguous",
            "invalid_selector",
            "missing_required_field",
            "evidence_missing",
            "baseline_debt"
          ]
        },
        "allow_id": {
          "type": ["string", "null"]
        },
        "finding_index": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "path": {
          "type": ["string", "null"]
        },
        "source_package": {
          "type": ["string", "null"],
          "description": "Explicit source-tree package context when provided by a scanner; not Cargo metadata or build proof."
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "suggested_actions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "proof_commands": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^cargo-allow "
          }
        }
      }
    }
  }
}

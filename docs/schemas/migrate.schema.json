{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://effortlessmetrics.dev/schemas/cargo-allow/migrate.v1.schema.json",
  "title": "cargo-allow migrate v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema_id",
    "tool",
    "command",
    "claim_boundary",
    "scanner_limitations",
    "inventory",
    "input",
    "output",
    "summary",
    "closeout",
    "mutation_receipt",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "schema_id": {
      "const": "cargo-allow.migrate.v1"
    },
    "tool": {
      "const": "cargo-allow"
    },
    "command": {
      "const": "migrate"
    },
    "claim_boundary": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim_boundary_flag"
      }
    },
    "scanner_limitations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scanner_limitation"
      }
    },
    "inventory": {
      "$ref": "#/$defs/inventory"
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path"
      ],
      "properties": {
        "kind": {
          "enum": [
            "from",
            "repo_policy"
          ]
        },
        "path": {
          "type": "string"
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "force"
      ],
      "properties": {
        "path": {
          "type": "string",
          "description": "Path where canonical TOML policy was written."
        },
        "force": {
          "type": "boolean"
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allow_entries",
        "baseline_debt",
        "unsafe_entries",
        "lint_exception_entries",
        "entries_with_evidence"
      ],
      "properties": {
        "allow_entries": {
          "type": "integer",
          "minimum": 0
        },
        "baseline_debt": {
          "type": "integer",
          "minimum": 0
        },
        "unsafe_entries": {
          "type": "integer",
          "minimum": 0
        },
        "lint_exception_entries": {
          "type": "integer",
          "minimum": 0
        },
        "entries_with_evidence": {
          "type": "integer",
          "minimum": 0
        },
        "evidence_entries": {
          "type": "integer",
          "minimum": 0,
          "description": "Total evidence values present in the migrated canonical policy, across all allow entries."
        },
        "entries_with_links": {
          "type": "integer",
          "minimum": 0,
          "description": "Total migrated allow entries that carry at least one canonical traceability link."
        },
        "link_entries": {
          "type": "integer",
          "minimum": 0,
          "description": "Total canonical traceability link values present in the migrated policy, across all allow entries."
        },
        "broken_evidence_links": {
          "type": "integer",
          "minimum": 0
        },
        "unsafe_broken_evidence_links": {
          "type": "integer",
          "minimum": 0
        },
        "weak_evidence_references": {
          "type": "integer",
          "minimum": 0
        },
        "unsafe_weak_evidence_references": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "evidence_repair_queues": {
      "type": "array",
      "description": "Optional worklist queue routing emitted when migrated policy has broken local evidence links or weak evidence references.",
      "items": {
        "$ref": "#/$defs/evidence_repair_queue"
      }
    },
    "follow_up_queues": {
      "type": "array",
      "description": "Optional follow-up worklist queues emitted when migration leaves generated baseline debt to close out.",
      "items": {
        "$ref": "#/$defs/follow_up_queue"
      }
    },
    "closeout": {
      "$ref": "#/$defs/closeout"
    },
    "mutation_receipt": {
      "$ref": "#/$defs/mutation_receipt"
    },
    "notes": {
      "type": "string"
    }
  },
  "$defs": {
    "mutation_receipt": {
      "type": "object",
      "additionalProperties": false,
      "description": "Shared provenance envelope for migrate (CARGO-ALLOW-SPEC-0008 Mutation Receipt Envelope, GOAL-0004 PR 5). Provenance and changed-entry metadata only; migration semantics remain in the command-specific summary and closeout fields.",
      "required": [
        "schema_id",
        "operation",
        "tool_version",
        "repo_root",
        "config_source",
        "ledger_ids",
        "changed_allow_ids",
        "before_fingerprints",
        "after_fingerprints",
        "result",
        "next_commands",
        "claim_boundary"
      ],
      "properties": {
        "schema_id": { "const": "cargo-allow.mutation-receipt.v1" },
        "operation": { "const": "migrate" },
        "tool_version": { "type": "string", "minLength": 1 },
        "repo_root": { "type": ["string", "null"] },
        "config_source": { "type": ["string", "null"] },
        "ledger_ids": { "type": "array", "items": { "type": "string" } },
        "changed_allow_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "before_fingerprints": {
          "type": "array",
          "items": { "type": ["string", "null"], "pattern": "^sha256:v1:[0-9a-f]{64}$" }
        },
        "after_fingerprints": {
          "type": "array",
          "items": { "type": ["string", "null"], "pattern": "^sha256:v1:[0-9a-f]{64}$" }
        },
        "result": { "const": "written" },
        "next_commands": { "type": "array", "items": { "type": "string" } },
        "claim_boundary": { "type": "string", "minLength": 1 }
      }
    },
    "closeout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preserved",
        "baseline_debt",
        "evidence_debt",
        "next_queues",
        "legacy_retirement"
      ],
      "properties": {
        "preserved": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "allow_entries",
            "reviewed_entries",
            "entries_with_evidence",
            "evidence_entries",
            "entries_with_links",
            "link_entries"
          ],
          "properties": {
            "allow_entries": {
              "type": "integer",
              "minimum": 0
            },
            "reviewed_entries": {
              "type": "integer",
              "minimum": 0
            },
            "entries_with_evidence": {
              "type": "integer",
              "minimum": 0
            },
            "evidence_entries": {
              "type": "integer",
              "minimum": 0
            },
            "entries_with_links": {
              "type": "integer",
              "minimum": 0
            },
            "link_entries": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "baseline_debt": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "entries"
          ],
          "properties": {
            "entries": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "evidence_debt": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "broken_evidence_links": {
              "type": "integer",
              "minimum": 0
            },
            "unsafe_broken_evidence_links": {
              "type": "integer",
              "minimum": 0
            },
            "weak_evidence_references": {
              "type": "integer",
              "minimum": 0
            },
            "unsafe_weak_evidence_references": {
              "type": "integer",
              "minimum": 0
            },
            "missing_evidence_entries": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "next_queues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/closeout_queue"
          }
        },
        "legacy_retirement": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ready",
            "blockers",
            "sources"
          ],
          "properties": {
            "ready": {
              "type": "boolean"
            },
            "blockers": {
              "type": "array",
              "items": {
                "enum": [
                  "baseline_debt",
                  "broken_evidence_link",
                  "missing_evidence",
                  "weak_evidence_reference"
                ]
              }
            },
            "sources": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/legacy_retirement_source"
              }
            }
          }
        }
      }
    },
    "closeout_queue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "signal",
        "route_kind",
        "item_kind",
        "count",
        "command"
      ],
      "properties": {
        "phase": {
          "type": "integer",
          "minimum": 1
        },
        "signal": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "route_kind": {
          "enum": [
            "worklist_item_kind",
            "check_mode"
          ]
        },
        "item_kind": {
          "type": "string"
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "command": {
          "type": "string"
        },
        "unsafe_command": {
          "type": "string"
        }
      }
    },
    "legacy_retirement_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file_name",
        "compat_kind",
        "status"
      ],
      "properties": {
        "file_name": {
          "type": "string"
        },
        "compat_kind": {
          "type": "string"
        },
        "status": {
          "enum": [
            "ready",
            "blocked"
          ]
        }
      }
    },
    "claim_boundary_flag": {
      "type": "string",
      "enum": [
        "source_tree_inventory",
        "source_syntax_only",
        "cargo_metadata_not_invoked",
        "cargo_commands_not_invoked",
        "rustc_not_invoked",
        "clippy_not_invoked",
        "build_scripts_not_executed",
        "proc_macros_not_executed",
        "macro_expansion_not_analyzed",
        "macro_token_tree_contents_not_analyzed",
        "type_information_not_analyzed",
        "mir_not_analyzed",
        "build_output_not_analyzed",
        "control_flow_not_analyzed",
        "data_flow_not_analyzed",
        "external_evidence_tools_not_invoked",
        "repository_code_not_executed",
        "source_text_in_identity_fields"
      ]
    },
    "scanner_limitation": {
      "type": "string",
      "enum": [
        "cargo_metadata_not_invoked",
        "cargo_commands_not_invoked",
        "rustc_not_invoked",
        "clippy_not_invoked",
        "build_scripts_not_executed",
        "proc_macros_not_executed",
        "macro_expansion_not_analyzed",
        "macro_token_tree_contents_not_analyzed",
        "type_information_not_analyzed",
        "mir_not_analyzed",
        "build_output_not_analyzed",
        "control_flow_not_analyzed",
        "data_flow_not_analyzed",
        "external_evidence_tools_not_invoked",
        "repository_code_not_executed"
      ]
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "scanner",
        "source"
      ],
      "properties": {
        "scope": {
          "const": "source_tree"
        },
        "scanner": {
          "const": "policy_migration"
        },
        "source": {
          "enum": [
            "git_tracked",
            "git_index_staged_candidate",
            "filesystem_fallback",
            "filesystem_include_untracked",
            "unknown"
          ]
        },
        "root": {
          "type": "string",
          "minLength": 1,
          "description": "Local source-tree root used for repo-policy migration, when available."
        },
        "files_scanned": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of source-tree inventory files considered during repo-policy migration, when collected."
        },
        "empty_git_tracked": {
          "type": "boolean",
          "description": "True when git inventory succeeded but reported no tracked files, such as a freshly initialized repo before git add."
        },
        "completeness": {
          "type": "string",
          "enum": ["complete", "scoped", "fallback", "partial"],
          "description": "Authoritative inventory coverage classification for this artifact."
        }
      }
    },
    "follow_up_queue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signal",
        "route_kind",
        "item_kind",
        "count",
        "command"
      ],
      "properties": {
        "signal": {
          "enum": [
            "baseline_debt"
          ],
          "description": "Migration summary signal routed by this follow-up queue."
        },
        "label": {
          "type": "string",
          "description": "Human-friendly queue label for display and agent logs."
        },
        "route_kind": {
          "enum": [
            "worklist_item_kind"
          ],
          "description": "Machine routing mode for the follow-up command."
        },
        "item_kind": {
          "enum": [
            "baseline_debt"
          ],
          "description": "Stable cargo-allow worklist item kind associated with this follow-up queue."
        },
        "count": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of migrated baseline-debt entries routed by this queue."
        },
        "command": {
          "type": "string",
          "description": "Suggested cargo-allow worklist command for this queue."
        }
      }
    },
    "evidence_repair_queue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_kind",
        "count",
        "unsafe_count",
        "command"
      ],
      "properties": {
        "signal": {
          "enum": [
            "broken_evidence_links",
            "weak_evidence_references"
          ],
          "description": "Evidence-health migration signal routed by this queue."
        },
        "label": {
          "type": "string",
          "description": "Human-friendly queue label for display and agent logs."
        },
        "route_kind": {
          "enum": [
            "worklist_item_kind"
          ],
          "description": "Machine routing mode for the follow-up command."
        },
        "item_kind": {
          "enum": [
            "broken_evidence_link",
            "weak_evidence_reference"
          ],
          "description": "Stable cargo-allow worklist item kind for the repair queue."
        },
        "count": {
          "type": "integer",
          "minimum": 0,
          "description": "Total migrated references routed to this repair queue."
        },
        "unsafe_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Migrated unsafe references routed to this repair queue."
        },
        "command": {
          "type": "string",
          "description": "Suggested cargo-allow worklist command for this queue."
        },
        "unsafe_command": {
          "type": "string",
          "description": "Optional unsafe-scoped cargo-allow worklist command when unsafe_count is non-zero."
        }
      }
    }
  }
}

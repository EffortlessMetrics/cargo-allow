{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EffortlessMetrics/cargo-allow/blob/main/docs/schemas/isolated-install-receipt-v2.schema.json",
  "title": "cargo-allow IsolatedInstallPayloadV2",
  "description": "Typed receipt for the isolated local-registry install of the exact cargo-allow candidate. Portable identities only; it does not authorize publication and retains no private paths.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id", "schema_version", "candidate_artifact_digest", "repository_commit",
    "repository_tree", "cargo_lock_digest", "registry_index_digest",
    "external_cache_identity", "source_checkout_denied", "install_root_identity",
    "cargo_home_identity", "installed_executable_digest", "installed_version_output",
    "platform", "toolchain", "package_rows", "graph_comparison", "limitations",
    "claim_boundary"
  ],
  "properties": {
    "schema_id": { "const": "cargo-allow.isolated-install.v2" },
    "schema_version": { "const": 2 },
    "candidate_artifact_digest": { "$ref": "#/$defs/digest" },
    "repository_commit": { "type": "string", "minLength": 1 },
    "repository_tree": { "type": "string", "minLength": 1 },
    "cargo_lock_digest": { "$ref": "#/$defs/digest" },
    "registry_index_digest": { "$ref": "#/$defs/digest" },
    "external_cache_identity": { "type": "string", "minLength": 1 },
    "source_checkout_denied": { "const": true },
    "install_root_identity": { "$ref": "#/$defs/digest" },
    "cargo_home_identity": { "$ref": "#/$defs/digest" },
    "installed_executable_digest": { "$ref": "#/$defs/digest" },
    "installed_version_output": { "type": "string", "minLength": 1 },
    "platform": { "type": "string", "minLength": 1 },
    "toolchain": { "type": "string", "minLength": 1 },
    "package_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/row" }
    },
    "graph_comparison": { "$ref": "#/$defs/graph" },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "claim_boundary": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package_name", "package_version", "crate_digest", "index_checksum"],
      "properties": {
        "package_name": { "type": "string", "minLength": 1 },
        "package_version": { "type": "string", "minLength": 1 },
        "crate_digest": { "$ref": "#/$defs/digest" },
        "index_checksum": { "$ref": "#/$defs/digest" },
        "resolved_version": { "type": "string", "minLength": 1 }
      }
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_packages", "matched_packages"],
      "properties": {
        "expected_packages": { "type": "integer", "minimum": 1 },
        "matched_packages": { "type": "integer", "minimum": 0 },
        "unexpected_packages": { "type": "array", "items": { "type": "string" } },
        "missing_packages": { "type": "array", "items": { "type": "string" } },
        "version_mismatches": { "type": "array", "items": { "type": "string" } },
        "path_sources": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}

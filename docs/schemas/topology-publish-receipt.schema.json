{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EffortlessMetrics/cargo-allow/blob/main/docs/schemas/topology-publish-receipt.schema.json",
  "title": "cargo-allow topology publish receipt",
  "description": "The exact V2 topology candidate consumed by release-manifest generation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "mode", "publish", "topology_id", "topology_sha256", "cargo_lock_sha256", "commit", "tree", "rows", "complete", "incident_state"],
  "properties": {
    "schema_id": { "const": "cargo-allow.topology-publish-receipt.v1" },
    "schema_version": { "const": 1 },
    "mode": { "enum": ["namespace", "cargo-allow", "all"] },
    "publish": { "type": "boolean" },
    "authorization": { "type": "string", "maxLength": 200 },
    "topology_id": { "type": "string", "minLength": 1 },
    "topology_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "cargo_lock_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "commit": { "type": "string", "minLength": 1 },
    "tree": { "type": "string", "minLength": 1 },
    "complete": { "type": "boolean" },
    "incident_state": { "enum": ["none", "partial", "release_incident"] },
    "first_irreversible_row": { "type": ["integer", "null"], "minimum": 1 },
    "shared_registry_preflight_complete": { "type": "boolean" },
    "shared_registry_preflight": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["logical_id", "name", "version", "release_order", "local_checksum", "registry_checksum", "state"],
        "properties": {
          "logical_id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "release_order": { "type": "integer", "minimum": 1 },
          "local_checksum": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "registry_checksum": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
          "state": { "enum": ["missing", "already_published_exact", "checksum_conflict"] }
        },
        "oneOf": [
          {
            "properties": {
              "state": { "const": "missing" },
              "registry_checksum": { "type": "null" }
            }
          },
          {
            "properties": {
              "state": { "enum": ["already_published_exact", "checksum_conflict"] },
              "registry_checksum": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
            }
          }
        ]
      }
    },
    "recovery_receipt": { "type": "string", "minLength": 1 },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["logical_id", "name", "version", "family", "release_order", "crate", "local_checksum", "state"],
        "properties": {
          "logical_id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "family": { "type": "string", "minLength": 1 },
          "release_order": { "type": "integer", "minimum": 1 },
          "crate": { "type": "string", "minLength": 1 },
          "local_checksum": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "registry_checksum": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
          "state": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}

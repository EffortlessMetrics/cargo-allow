{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://effortlessmetrics.dev/schemas/cargo-allow/report.v1.schema.json",
  "title": "cargo-allow report v1",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "required": ["diff"]
      },
      "then": {
        "additionalProperties": false,
        "properties": {
          "command": {
            "const": "diff"
          }
        }
      }
    }
  ],
  "required": [
    "schema_version",
    "schema_id",
    "tool",
    "command",
    "status",
    "failed",
    "claim_boundary",
    "scanner_limitations",
    "inventory",
    "summary",
    "outcomes",
    "findings"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "schema_id": {
      "const": "cargo-allow.report.v1"
    },
    "tool": {
      "const": "cargo-allow"
    },
    "command": {
      "enum": ["audit", "check", "diff"],
      "description": "Command that produced this report artifact. The shared report schema is emitted by audit, check, and diff."
    },
    "status": {
      "enum": ["passed", "failed"]
    },
    "failed": {
      "type": "boolean"
    },
    "claim_boundary": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim_boundary_flag"
      },
      "examples": [
        [
          "source_tree_inventory",
          "source_syntax_only",
          "cargo_metadata_not_invoked",
          "cargo_commands_not_invoked",
          "repository_code_not_executed"
        ]
      ],
      "contains": {
        "const": "source_tree_inventory"
      }
    },
    "scanner_limitations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scanner_limitation"
      },
      "examples": [
        [
          "cargo_metadata_not_invoked",
          "cargo_commands_not_invoked",
          "rustc_not_invoked",
          "clippy_not_invoked",
          "build_scripts_not_executed",
          "proc_macros_not_executed",
          "macro_expansion_not_analyzed",
          "macro_token_tree_contents_not_analyzed"
        ]
      ],
      "allOf": [
        {
          "contains": {
            "const": "macro_expansion_not_analyzed"
          }
        },
        {
          "contains": {
            "const": "macro_token_tree_contents_not_analyzed"
          }
        }
      ]
    },
    "inventory": {
      "$ref": "#/$defs/inventory"
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "trend": {
      "$ref": "#/$defs/trend"
    },
    "outcomes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/outcome"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "diff": {
      "$ref": "#/$defs/diff",
      "description": "Optional structured PR posture data emitted by cargo-allow diff."
    }
  },
  "$defs": {
    "claim_boundary_flag": {
      "type": "string",
      "enum": [
        "source_tree_inventory",
        "source_syntax_only",
        "cargo_metadata_not_invoked",
        "cargo_commands_not_invoked",
        "rustc_not_invoked",
        "clippy_not_invoked",
        "build_scripts_not_executed",
        "proc_macros_not_executed",
        "macro_expansion_not_analyzed",
        "macro_token_tree_contents_not_analyzed",
        "type_information_not_analyzed",
        "mir_not_analyzed",
        "build_output_not_analyzed",
        "control_flow_not_analyzed",
        "data_flow_not_analyzed",
        "repository_code_not_executed"
      ]
    },
    "scanner_limitation": {
      "type": "string",
      "enum": [
        "cargo_metadata_not_invoked",
        "cargo_commands_not_invoked",
        "rustc_not_invoked",
        "clippy_not_invoked",
        "build_scripts_not_executed",
        "proc_macros_not_executed",
        "macro_expansion_not_analyzed",
        "macro_token_tree_contents_not_analyzed",
        "type_information_not_analyzed",
        "mir_not_analyzed",
        "build_output_not_analyzed",
        "control_flow_not_analyzed",
        "data_flow_not_analyzed",
        "repository_code_not_executed"
      ]
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "scanner", "source"],
      "properties": {
        "scope": {
          "const": "source_tree"
        },
        "scanner": {
          "const": "source_syntax"
        },
        "source": {
          "enum": [
            "unknown",
            "git_tracked",
            "filesystem_fallback",
            "filesystem_include_untracked"
          ]
        },
        "root": {
          "type": "string",
          "minLength": 1,
          "description": "Local source-tree root used for this scan. This may be an absolute path in local artifacts."
        },
        "files_scanned": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of source-tree inventory files considered before scanner filtering, when a full inventory was collected."
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "findings",
        "outcomes",
        "matched",
        "new",
        "expired",
        "review_due",
        "stale",
        "ambiguous",
        "invalid_selector",
        "missing_required_field",
        "evidence_missing",
        "baseline_debt"
      ],
      "properties": {
        "findings": {
          "type": "integer",
          "minimum": 0
        },
        "outcomes": {
          "type": "integer",
          "minimum": 0
        },
        "matched": {
          "type": "integer",
          "minimum": 0
        },
        "new": {
          "type": "integer",
          "minimum": 0
        },
        "expired": {
          "type": "integer",
          "minimum": 0
        },
        "review_due": {
          "type": "integer",
          "minimum": 0
        },
        "stale": {
          "type": "integer",
          "minimum": 0
        },
        "ambiguous": {
          "type": "integer",
          "minimum": 0
        },
        "invalid_selector": {
          "type": "integer",
          "minimum": 0
        },
        "missing_required_field": {
          "type": "integer",
          "minimum": 0
        },
        "evidence_missing": {
          "type": "integer",
          "minimum": 0
        },
        "baseline_debt": {
          "type": "integer",
          "minimum": 0,
          "description": "Outcome-status count for baseline debt outcomes. Policy-level baseline debt inventory may also be reported under summary.policy_baseline_debt and trend.baseline_debt when available."
        },
        "policy_baseline_debt": {
          "type": "integer",
          "minimum": 0,
          "description": "Optional policy-level count of generated baseline_debt entries when it exceeds baseline_debt outcomes."
        },
        "policy_missing_evidence": {
          "type": "integer",
          "minimum": 0,
          "description": "Optional policy-level count of allow entries with no evidence references when it exceeds evidence_missing outcomes."
        },
        "broken_evidence_links": {
          "type": "integer",
          "minimum": 0,
          "description": "Optional count of missing or invalid local evidence references found while auditing policy evidence. These are source-tree evidence link problems, not executed proof failures."
        },
        "weak_evidence_references": {
          "type": "integer",
          "minimum": 0,
          "description": "Optional count of unstructured or unknown-prefix evidence references. These evidence strings are retained as traceability but are not recognized as typed evidence by cargo-allow."
        }
      }
    },
    "trend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_items",
        "new",
        "expired",
        "review_due",
        "stale",
        "ambiguous",
        "invalid_selector",
        "missing_required_field",
        "evidence_missing",
        "baseline_debt"
      ],
      "properties": {
        "review_items": {
          "type": "integer",
          "minimum": 0,
          "description": "Total review-oriented items, including policy-level baseline debt inventory when available."
        },
        "new": {
          "type": "integer",
          "minimum": 0
        },
        "expired": {
          "type": "integer",
          "minimum": 0
        },
        "review_due": {
          "type": "integer",
          "minimum": 0
        },
        "stale": {
          "type": "integer",
          "minimum": 0
        },
        "ambiguous": {
          "type": "integer",
          "minimum": 0
        },
        "invalid_selector": {
          "type": "integer",
          "minimum": 0
        },
        "missing_required_field": {
          "type": "integer",
          "minimum": 0
        },
        "evidence_missing": {
          "type": "integer",
          "minimum": 0
        },
        "baseline_debt": {
          "type": "integer",
          "minimum": 0,
          "description": "Policy-level count of generated baseline_debt entries when available; otherwise the baseline_debt outcome count. Prefer summary.policy_baseline_debt for explicit policy-level debt when present."
        },
        "policy_missing_evidence": {
          "type": "integer",
          "minimum": 0,
          "description": "Optional policy-level count of allow entries with no evidence references included in review item totals when available."
        },
        "broken_evidence_links": {
          "type": "integer",
          "minimum": 0,
          "description": "Optional count of missing or invalid local evidence references included in review item totals when available."
        },
        "weak_evidence_references": {
          "type": "integer",
          "minimum": 0,
          "description": "Optional count of unstructured or unknown-prefix evidence references included in review item totals when available."
        }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "allow_id",
        "finding_index",
        "score",
        "message"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/match_status"
        },
        "allow_id": {
          "type": ["string", "null"]
        },
        "finding_index": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "score": {
          "type": "integer",
          "minimum": 0
        },
        "message": {
          "type": "string"
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "family",
        "path",
        "line",
        "container",
        "ast_kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "panic",
            "unsafe",
            "lint_exception",
            "non_rust_file",
            "generated_code",
            "policy_exception"
          ]
        },
        "family": {
          "type": ["string", "null"]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "container": {
          "type": ["string", "null"]
        },
        "source_package": {
          "type": ["string", "null"],
          "description": "Optional source-derived package context from scanned repository files; not Cargo metadata or build proof."
        },
        "ast_kind": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "diff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "net_posture",
        "reviewer_action",
        "summary",
        "finding_changes",
        "policy_changes"
      ],
      "properties": {
        "net_posture": {
          "enum": ["worse", "review-required", "improved", "unchanged"]
        },
        "reviewer_action": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "$ref": "#/$defs/diff_summary"
        },
        "finding_changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding_posture_change"
          }
        },
        "policy_changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/policy_change"
          }
        }
      }
    },
    "diff_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current_failures",
        "new_findings",
        "removed_findings",
        "policy_failures",
        "policy_review_items",
        "policy_improvements"
      ],
      "properties": {
        "current_failures": {
          "type": "integer",
          "minimum": 0
        },
        "new_findings": {
          "type": "integer",
          "minimum": 0
        },
        "removed_findings": {
          "type": "integer",
          "minimum": 0
        },
        "policy_failures": {
          "type": "integer",
          "minimum": 0
        },
        "policy_review_items": {
          "type": "integer",
          "minimum": 0
        },
        "policy_improvements": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "finding_posture_change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["change", "key", "kind", "family", "path"],
      "properties": {
        "change": {
          "enum": ["new", "removed"]
        },
        "key": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "panic",
            "unsafe",
            "lint_exception",
            "non_rust_file",
            "generated_code",
            "policy_exception"
          ]
        },
        "family": {
          "type": ["string", "null"]
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "policy_change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "allow_id", "kind", "message"],
      "properties": {
        "severity": {
          "enum": ["improvement", "review", "fail"]
        },
        "allow_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "added_allow",
            "removed_allow",
            "baseline_debt_added",
            "baseline_debt_introduced",
            "baseline_debt_normalized",
            "kind_changed",
            "family_changed",
            "scope_broadened",
            "scope_changed",
            "scope_narrowed",
            "selector_changed",
            "selector_precision_decreased",
            "selector_precision_increased",
            "created_added",
            "created_changed",
            "created_removed",
            "expiry_extended",
            "expiry_shortened",
            "review_after_extended",
            "review_after_shortened",
            "evidence_added",
            "evidence_removed",
            "link_added",
            "link_removed",
            "owner_added",
            "owner_changed",
            "owner_removed",
            "owner_unassigned",
            "policy_owner_added",
            "policy_owner_changed",
            "policy_owner_removed",
            "policy_owner_unassigned",
            "policy_status_changed",
            "policy_status_weakened",
            "policy_status_tightened",
            "reason_added",
            "reason_changed",
            "reason_removed",
            "requirement_loosened",
            "requirement_tightened",
            "workspace_ignored_added",
            "workspace_ignored_removed",
            "workspace_generated_added",
            "workspace_generated_removed",
            "classification_added",
            "classification_changed",
            "classification_removed",
            "occurrence_limit_tightened",
            "occurrence_limit_loosened"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "selector_precision": {
          "$ref": "#/$defs/selector_precision_change",
          "description": "Optional structured selector precision delta for selector_precision_decreased and selector_precision_increased policy changes."
        },
        "scope": {
          "$ref": "#/$defs/scope_change",
          "description": "Optional structured source-tree scope delta for scope_broadened, scope_narrowed, and scope_changed policy changes."
        }
      }
    },
    "scope_change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "before", "after"],
      "properties": {
        "field": {
          "$ref": "#/$defs/scope_change_field",
          "description": "Scope carrier that changed, or effective when the scope moved between carriers."
        },
        "before": {
          "type": ["string", "null"],
          "description": "Normalized source-tree scope before the policy change when available."
        },
        "after": {
          "type": ["string", "null"],
          "description": "Normalized source-tree scope after the policy change when available."
        }
      }
    },
    "scope_change_field": {
      "enum": ["path", "glob", "selector.glob", "effective"]
    },
    "selector_precision_change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before", "after", "removed_fields", "added_fields"],
      "properties": {
        "before": {
          "type": "integer",
          "minimum": 0,
          "description": "Selector precision score before the policy change."
        },
        "after": {
          "type": "integer",
          "minimum": 0,
          "description": "Selector precision score after the policy change."
        },
        "removed_fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/selector_precision_field"
          },
          "description": "Selector fields that were present before the change and absent after it."
        },
        "added_fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/selector_precision_field"
          },
          "description": "Selector fields that were absent before the change and present after it."
        }
      }
    },
    "selector_precision_field": {
      "enum": [
        "path",
        "glob",
        "family",
        "ast_kind",
        "container",
        "callee",
        "macro_name",
        "lint",
        "symbol",
        "receiver_fingerprint",
        "target_fingerprint",
        "normalized_snippet_hash",
        "occurrence_limit"
      ]
    },
    "match_status": {
      "enum": [
        "matched",
        "new",
        "stale",
        "expired",
        "review_due",
        "ambiguous",
        "invalid_selector",
        "missing_required_field",
        "evidence_missing",
        "baseline_debt"
      ]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://effortlessmetrics.dev/schemas/cargo-allow/report.v1.schema.json",
  "title": "cargo-allow report v1",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "required": ["diff"]
      },
      "then": {
        "properties": {
          "command": {
            "const": "diff"
          }
        }
      }
    },
    {
      "if": {
        "required": ["audit_remediation_roadmap"]
      },
      "then": {
        "properties": {
          "command": {
            "const": "audit"
          }
        }
      }
    }
  ],
  "required": [
    "schema_version",
    "schema_id",
    "tool",
    "command",
    "status",
    "failed",
    "claim_boundary",
    "scanner_limitations",
    "inventory",
    "summary",
    "outcomes",
    "findings"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "schema_id": {
      "const": "cargo-allow.report.v1"
    },
    "tool": {
      "const": "cargo-allow"
    },
    "command": {
      "enum": ["audit", "check", "diff"],
      "description": "Command that produced this report artifact. The shared report schema is emitted by audit, check, and diff."
    },
    "status": {
      "enum": ["passed", "failed"]
    },
    "failed": {
      "type": "boolean"
    },
    "claim_boundary": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim_boundary_flag"
      },
      "examples": [
        [
          "source_tree_inventory",
          "source_syntax_only",
          "cargo_metadata_not_invoked",
          "cargo_commands_not_invoked",
          "repository_code_not_executed"
        ]
      ],
      "contains": {
        "const": "source_tree_inventory"
      }
    },
    "scanner_limitations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scanner_limitation"
      },
      "examples": [
        [
          "cargo_metadata_not_invoked",
          "cargo_commands_not_invoked",
          "rustc_not_invoked",
          "clippy_not_invoked",
          "build_scripts_not_executed",
          "proc_macros_not_executed",
          "macro_expansion_not_analyzed",
          "macro_token_tree_contents_not_analyzed"
        ]
      ],
      "allOf": [
        {
          "contains": {
            "const": "macro_expansion_not_analyzed"
          }
        },
        {
          "contains": {
            "const": "macro_token_tree_contents_not_analyzed"
          }
        }
      ]
    },
    "inventory": {
      "$ref": "#/$defs/inventory"
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "trend": {
      "$ref": "#/$defs/trend"
    },
    "audit_remediation_roadmap": {
      "type": "array",
      "description": "Optional audit-only remediation roadmap emitted when audit reports have review or repair signals that can be routed to a follow-up cargo-allow command.",
      "items": {
        "$ref": "#/$defs/audit_remediation_item"
      }
    },
    "evidence_repair_queues": {
      "type": "array",
      "description": "Optional evidence-health repair queues emitted when report summary or trend counts include broken local evidence links, missing evidence, or weak evidence references.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["signal", "count", "command"],
        "properties": {
          "signal": {
            "enum": [
              "broken_evidence_links",
              "missing_evidence",
              "weak_evidence_references",
              "occurrence_headroom"
            ],
            "description": "Evidence-health signal routed by this queue."
          },
          "label": {
            "type": "string",
            "description": "Human-friendly queue label for display and agent logs."
          },
          "route_kind": {
            "enum": [
              "worklist_item_kind",
              "worklist_filter"
            ],
            "description": "Machine routing mode for the follow-up command."
          },
          "item_kind": {
            "enum": [
              "broken_evidence_link",
              "missing_evidence",
              "weak_evidence_reference",
              "occurrence_headroom"
            ],
            "description": "Stable cargo-allow worklist item kind routed by this queue when available."
          },
          "worklist_filter": {
            "enum": [
              "broken_evidence",
              "missing_evidence",
              "weak_evidence"
            ],
            "description": "Named worklist filter used by this row when route_kind is worklist_filter."
          },
          "count": {
            "type": "integer",
            "minimum": 0,
            "description": "Number of report evidence-health items routed by this queue."
          },
          "command": {
            "type": "string",
            "description": "Suggested cargo-allow worklist command for this queue."
          }
        }
      }
    },
    "source_inventory": {
      "$ref": "#/$defs/source_inventory",
      "description": "Optional aggregate inventory of source exception findings by governed kind and kind.family label. Emitted when findings are present so automation does not need to re-aggregate the findings array."
    },
    "outcomes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/outcome"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "diff": {
      "$ref": "#/$defs/diff",
      "description": "Optional structured PR posture data emitted by cargo-allow diff."
    }
  },
  "$defs": {
    "claim_boundary_flag": {
      "type": "string",
      "enum": [
        "source_tree_inventory",
        "source_syntax_only",
        "cargo_metadata_not_invoked",
        "cargo_commands_not_invoked",
        "rustc_not_invoked",
        "clippy_not_invoked",
        "build_scripts_not_executed",
        "proc_macros_not_executed",
        "macro_expansion_not_analyzed",
        "macro_token_tree_contents_not_analyzed",
        "type_information_not_analyzed",
        "mir_not_analyzed",
        "build_output_not_analyzed",
        "control_flow_not_analyzed",
        "data_flow_not_analyzed",
        "external_evidence_tools_not_invoked",
        "repository_code_not_executed",
        "source_text_in_identity_fields"
      ]
    },
    "scanner_limitation": {
      "type": "string",
      "enum": [
        "cargo_metadata_not_invoked",
        "cargo_commands_not_invoked",
        "rustc_not_invoked",
        "clippy_not_invoked",
        "build_scripts_not_executed",
        "proc_macros_not_executed",
        "macro_expansion_not_analyzed",
        "macro_token_tree_contents_not_analyzed",
        "type_information_not_analyzed",
        "mir_not_analyzed",
        "build_output_not_analyzed",
        "control_flow_not_analyzed",
        "data_flow_not_analyzed",
        "external_evidence_tools_not_invoked",
        "repository_code_not_executed"
      ]
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "scanner", "source"],
      "properties": {
        "scope": {
          "const": "source_tree"
        },
        "scanner": {
          "const": "source_syntax"
        },
        "source": {
          "enum": [
            "unknown",
            "git_tracked",
            "git_index_staged_candidate",
            "filesystem_fallback",
            "filesystem_include_untracked"
          ]
        },
        "root": {
          "type": "string",
          "minLength": 1,
          "description": "Local source-tree root used for this scan. This may be an absolute path in local artifacts."
        },
        "files_scanned": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of source-tree inventory files considered before scanner filtering, when a full inventory was collected."
        },
        "empty_git_tracked": {
          "type": "boolean",
          "description": "True when git inventory succeeded but reported no tracked files, such as a freshly initialized repo before git add."
        },
        "completeness": {
          "type": "string",
          "enum": [
            "complete",
            "scoped",
            "fallback",
            "partial"
          ],
          "description": "Authoritative inventory coverage classification for this artifact."
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "findings",
        "outcomes",
        "matched",
        "new",
        "expired",
        "review_due",
        "location_drift",
        "stale",
        "ambiguous",
        "invalid_selector",
        "missing_required_field",
        "evidence_missing",
        "baseline_debt"
      ],
      "properties": {
        "findings": {
          "type": "integer",
          "minimum": 0
        },
        "outcomes": {
          "type": "integer",
          "minimum": 0
        },
        "matched": {
          "type": "integer",
          "minimum": 0
        },
        "new": {
          "type": "integer",
          "minimum": 0
        },
        "expired": {
          "type": "integer",
          "minimum": 0
        },
        "review_due": {
          "type": "integer",
          "minimum": 0
        },
        "location_drift": {
          "type": "integer",
          "minimum": 0
        },
        "stale": {
          "type": "integer",
          "minimum": 0
        },
        "ambiguous": {
          "type": "integer",
          "minimum": 0
        },
        "invalid_selector": {
          "type": "integer",
          "minimum": 0
        },
        "missing_required_field": {
          "type": "integer",
          "minimum": 0
        },
        "evidence_missing": {
          "type": "integer",
          "minimum": 0
        },
        "baseline_debt": {
          "type": "integer",
          "minimum": 0,
          "description": "Outcome-status count for baseline debt outcomes. Policy-level baseline debt inventory may also be reported under summary.policy_baseline_debt and trend.baseline_debt when available."
        },
        "policy_baseline_debt": {
          "type": "integer",
          "minimum": 0,
          "description": "Optional policy-level count of generated baseline_debt entries when it exceeds baseline_debt outcomes."
        },
        "policy_missing_evidence": {
          "type": "integer",
          "minimum": 0,
          "description": "Optional policy-level count of allow entries with no evidence references when it exceeds evidence_missing outcomes."
        },
        "broken_evidence_links": {
          "type": "integer",
          "minimum": 0,
          "description": "Optional count of missing or invalid local evidence or link references found while auditing policy evidence. These are source-tree evidence/link problems, not executed proof failures."
        },
        "weak_evidence_references": {
          "type": "integer",
          "minimum": 0,
          "description": "Optional count of unstructured or unknown-prefix evidence or link references. These strings are retained as traceability but are not recognized as typed evidence by cargo-allow."
        }
      }
    },
    "trend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_items",
        "new",
        "expired",
        "review_due",
        "location_drift",
        "stale",
        "ambiguous",
        "invalid_selector",
        "missing_required_field",
        "evidence_missing",
        "baseline_debt"
      ],
      "properties": {
        "review_items": {
          "type": "integer",
          "minimum": 0,
          "description": "Total review-oriented items, including policy-level baseline debt inventory when available."
        },
        "new": {
          "type": "integer",
          "minimum": 0
        },
        "expired": {
          "type": "integer",
          "minimum": 0
        },
        "review_due": {
          "type": "integer",
          "minimum": 0
        },
        "location_drift": {
          "type": "integer",
          "minimum": 0
        },
        "stale": {
          "type": "integer",
          "minimum": 0
        },
        "ambiguous": {
          "type": "integer",
          "minimum": 0
        },
        "invalid_selector": {
          "type": "integer",
          "minimum": 0
        },
        "missing_required_field": {
          "type": "integer",
          "minimum": 0
        },
        "evidence_missing": {
          "type": "integer",
          "minimum": 0
        },
        "baseline_debt": {
          "type": "integer",
          "minimum": 0,
          "description": "Policy-level count of generated baseline_debt entries when available; otherwise the baseline_debt outcome count. Prefer summary.policy_baseline_debt for explicit policy-level debt when present."
        },
        "policy_missing_evidence": {
          "type": "integer",
          "minimum": 0,
          "description": "Optional policy-level count of allow entries with no evidence references included in review item totals when available."
        },
        "broken_evidence_links": {
          "type": "integer",
          "minimum": 0,
          "description": "Optional count of missing or invalid local evidence or link references included in review item totals when available."
        },
        "weak_evidence_references": {
          "type": "integer",
          "minimum": 0,
          "description": "Optional count of unstructured or unknown-prefix evidence or link references included in review item totals when available."
        },
        "occurrence_headroom": {
          "type": "integer",
          "minimum": 0,
          "description": "Optional count of matched allow entries whose occurrence_limit exceeds the current matched count and can be ratcheted down."
        },
        "mirror_divergence": {
          "type": "integer",
          "minimum": 0,
          "description": "Optional count of canonical versus mirror ledger divergences during active drain windows."
        }
      }
    },
    "audit_remediation_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signal", "count", "command"],
      "properties": {
        "signal": {
          "enum": [
            "new_unreceipted",
            "expired",
            "review_due",
            "stale",
            "ambiguous",
            "invalid_selector",
            "missing_required_field",
            "missing_evidence",
            "broken_evidence_links",
            "weak_evidence_references",
            "baseline_debt",
            "occurrence_headroom"
          ],
          "description": "Audit remediation signal routed by this roadmap row."
        },
        "label": {
          "type": "string",
          "description": "Human-friendly roadmap label for display and agent logs."
        },
        "route_kind": {
          "enum": [
            "worklist_status",
            "worklist_item_kind",
            "worklist_filter",
            "prune_stale"
          ],
          "description": "Machine routing mode for the follow-up command."
        },
        "item_kind": {
          "enum": [
            "new_unreceipted_finding",
            "expired_allow",
            "review_due",
            "stale_allow",
            "ambiguous_selector",
            "invalid_selector",
            "missing_required_field",
            "missing_evidence",
            "broken_evidence_link",
            "weak_evidence_reference",
            "baseline_debt",
            "occurrence_headroom",
            "mirror_divergence"
          ],
          "description": "Stable cargo-allow worklist item kind associated with this row when applicable."
        },
        "worklist_status": {
          "enum": [
            "new",
            "expired",
            "review_due",
            "ambiguous",
            "invalid_selector",
            "missing_required_field"
          ],
          "description": "Worklist --status value used by this row when route_kind is worklist_status."
        },
        "worklist_filter": {
          "enum": [
            "missing_evidence",
            "baseline_debt"
          ],
          "description": "Named worklist filter used by this row when route_kind is worklist_filter."
        },
        "count": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of audit items routed by this roadmap row."
        },
        "command": {
          "type": "string",
          "description": "Suggested cargo-allow command for this audit remediation row."
        }
      }
    },
    "source_inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["findings", "by_kind", "by_family"],
      "properties": {
        "findings": {
          "type": "integer",
          "minimum": 0,
          "description": "Total number of syntax-visible source exception findings included in this report."
        },
        "by_kind": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_inventory_kind_row"
          }
        },
        "by_family": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_inventory_family_row"
          }
        }
      }
    },
    "source_inventory_kind_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "total", "matched", "new", "review_items"],
      "properties": {
        "kind": {
          "$ref": "#/$defs/governed_source_exception_kind"
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "matched": {
          "type": "integer",
          "minimum": 0
        },
        "new": {
          "type": "integer",
          "minimum": 0
        },
        "review_items": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "source_inventory_family_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "family",
        "label",
        "total",
        "matched",
        "new",
        "review_items"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/governed_source_exception_kind"
        },
        "family": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "description": "Human-friendly kind.family label used by text and Markdown reports."
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "matched": {
          "type": "integer",
          "minimum": 0
        },
        "new": {
          "type": "integer",
          "minimum": 0
        },
        "review_items": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "allow_id",
        "finding_index",
        "score",
        "message"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/match_status"
        },
        "allow_id": {
          "type": ["string", "null"]
        },
        "candidate_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Structured candidate allow-entry IDs considered while resolving the finding. Ambiguous rows contain all tied candidates; an empty array means no policy candidates were considered."
        },
        "finding_index": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "score": {
          "type": "integer",
          "minimum": 0
        },
        "message": {
          "type": "string"
        }
      }
    },
    "governed_source_exception_kind": {
      "enum": [
        "panic",
        "unsafe",
        "lint_exception",
        "non_rust_file",
        "generated_code",
        "policy_exception"
      ]
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path",
        "line",
        "container",
        "ast_kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "panic",
            "unsafe",
            "lint_exception",
            "non_rust_file",
            "generated_code",
            "policy_exception"
          ]
        },
        "family": {
          "type": "string",
          "description": "Scanner-provided finding family; omitted when unavailable."
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "container": {
          "type": ["string", "null"]
        },
        "source_package": {
          "type": "string",
          "description": "Scanner-provided source package context; omitted when unavailable and not Cargo metadata or build proof."
        },
        "ast_kind": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "structural_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language",
        "crate_name",
        "module",
        "container",
        "ast_kind",
        "symbol",
        "callee",
        "macro_name",
        "lint",
        "receiver_fingerprint",
        "target_fingerprint",
        "normalized_snippet_hash",
        "line_hint",
        "column_hint"
      ],
      "properties": {
        "language": {
          "type": "string"
        },
        "crate_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "module": {
          "type": [
            "string",
            "null"
          ]
        },
        "container": {
          "type": [
            "string",
            "null"
          ]
        },
        "ast_kind": {
          "type": "string"
        },
        "symbol": {
          "type": [
            "string",
            "null"
          ]
        },
        "callee": {
          "type": [
            "string",
            "null"
          ]
        },
        "macro_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "lint": {
          "type": [
            "string",
            "null"
          ]
        },
        "receiver_fingerprint": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_fingerprint": {
          "type": [
            "string",
            "null"
          ]
        },
        "normalized_snippet_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "line_hint": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "description": "Optional one-based source line hint for review/navigation only; excluded from stable identity."
        },
        "column_hint": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "description": "Optional one-based source character-column hint for review/navigation only; excluded from stable identity."
        }
      }
    },
    "diff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "net_posture",
        "reviewer_action",
        "summary",
        "finding_changes",
        "policy_changes"
      ],
      "properties": {
        "net_posture": {
          "enum": ["worse", "review-required", "improved", "unchanged"]
        },
        "reviewer_action": {
          "type": "string",
          "minLength": 1
        },
        "movement": {
          "$ref": "#/$defs/diff_movement_counts"
        },
        "posture_delta": {
          "$ref": "#/$defs/diff_posture_delta_counts"
        },
        "summary": {
          "$ref": "#/$defs/diff_summary"
        },
        "finding_changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding_posture_change"
          }
        },
        "policy_changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/policy_change"
          }
        }
      }
    },
    "diff_movement_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["introduced", "retained", "removed"],
      "properties": {
        "introduced": { "type": "integer", "minimum": 0 },
        "retained": { "type": "integer", "minimum": 0 },
        "removed": { "type": "integer", "minimum": 0 }
      }
    },
    "diff_posture_delta_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["improved", "worsened", "review_required", "unchanged"],
      "properties": {
        "improved": { "type": "integer", "minimum": 0 },
        "worsened": { "type": "integer", "minimum": 0 },
        "review_required": { "type": "integer", "minimum": 0 },
        "unchanged": { "type": "integer", "minimum": 0 }
      }
    },
    "diff_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current_failures",
        "new_findings",
        "removed_findings",
        "policy_failures",
        "policy_review_items",
        "policy_improvements"
      ],
      "properties": {
        "current_failures": {
          "type": "integer",
          "minimum": 0
        },
        "broken_evidence_links": {
          "type": "integer",
          "minimum": 0

    "finding_posture_change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["change", "movement", "posture_delta", "changed_in_diff", "key", "kind", "family", "path"],
      "properties": {
        "change": {
          "enum": ["new", "removed"]
        },
        "movement": {
          "enum": ["introduced", "retained", "removed"]
        },
        "posture_delta": {
          "enum": ["improved", "worsened", "review_required", "unchanged"]
        },
        "changed_in_diff": {
          "type": "boolean"
        },
        "subject": {
          "type": ["string", "null"]
        },
        "allow_id": {
          "type": ["string", "null"]
        },
        "ledger_id": {
          "type": ["string", "null"]
        },
        "lane": {
          "type": ["string", "null"]
        },
        "key": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "panic",
            "unsafe",
            "lint_exception",
            "non_rust_file",
            "generated_code",
            "policy_exception"
          ]
        },
        "family": {
          "type": ["string", "null"]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": "integer",
          "minimum": 1,
          "description": "Optional one-based source line for review/navigation only; excluded from stable finding identity."
        },
        "column": {
          "type": "integer",
          "minimum": 1,
          "description": "Optional one-based source character column for review/navigation only; excluded from stable finding identity."
        },
        "source_package": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "identity": {
          "$ref": "#/$defs/structural_identity",
          "description": "Optional structural identity context for the source finding; line_hint and column_hint remain review/navigation hints, not stable identity."
        }
      }
    },
    "policy_change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "movement", "posture_delta", "changed_in_diff", "allow_id", "kind", "message"],
      "properties": {
        "severity": {
          "enum": ["improvement", "review", "fail"]
        },
        "movement": {
          "enum": ["introduced", "retained", "removed"]
        },
        "posture_delta": {
          "enum": ["improved", "worsened", "review_required", "unchanged"]
        },
        "changed_in_diff": {
          "type": "boolean"
        },
        "subject": {
          "type": ["string", "null"]
        },
        "allow_id": {
          "type": "string",
          "minLength": 1
        },
        "ledger_id": {
          "type": ["string", "null"]
        },
        "lane": {
          "type": ["string", "null"]
        },
        "kind": {
          "enum": [
            "added_allow",
            "removed_allow",
            "baseline_debt_added",
            "baseline_debt_introduced",
            "baseline_debt_normalized",
            "kind_changed",
            "family_changed",
            "scope_broadened",
            "scope_changed",
            "scope_narrowed",
            "selector_changed",
            "selector_precision_decreased",
            "selector_precision_increased",
            "created_added",
            "created_changed",
            "created_removed",
            "expiry_extended",
            "expiry_shortened",
            "review_after_extended",
            "review_after_shortened",
            "evidence_added",
            "evidence_removed",
            "link_added",
            "link_removed",
            "owner_added",
            "owner_changed",
            "owner_removed",
            "owner_unassigned",
            "policy_owner_added",
            "policy_owner_changed",
            "policy_owner_removed",
            "policy_owner_unassigned",
            "policy_status_changed",
            "policy_status_weakened",
            "policy_status_tightened",
            "reason_added",
            "reason_changed",
            "reason_removed",
            "requirement_loosened",
            "requirement_tightened",
            "workspace_ignored_added",
            "workspace_ignored_removed",
            "workspace_generated_added",
            "workspace_generated_removed",
            "classification_added",
            "classification_changed",
            "classification_removed",
            "occurrence_limit_tightened",
            "occurrence_limit_loosened"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "exception_identity": {
          "$ref": "#/$defs/exception_identity_change",
          "description": "Optional structured governed exception identity delta for kind_changed and family_changed policy changes."
        },
        "selector_identity": {
          "$ref": "#/$defs/selector_identity_change",
          "description": "Optional structured selector identity delta for selector_changed policy changes."
        },
        "selector_precision": {
          "$ref": "#/$defs/selector_precision_change",
          "description": "Optional structured selector precision delta for selector_precision_decreased and selector_precision_increased policy changes."
        },
        "scope": {
          "$ref": "#/$defs/scope_change",
          "description": "Optional structured source-tree scope delta for scope_broadened, scope_narrowed, and scope_changed policy changes."
        },
        "occurrence_limit": {
          "$ref": "#/$defs/occurrence_limit_change",
          "description": "Optional structured occurrence-limit delta for occurrence_limit_tightened and occurrence_limit_loosened policy changes."
        },
        "lifecycle": {
          "$ref": "#/$defs/lifecycle_change",
          "description": "Optional structured lifecycle delta for created, expiry, and review_after policy changes."
        },
        "evidence": {
          "$ref": "#/$defs/evidence_change",
          "description": "Optional structured evidence/link delta for evidence_added, evidence_removed, link_added, and link_removed policy changes."
        },
        "metadata": {
          "$ref": "#/$defs/metadata_change",
          "description": "Optional structured owner/reason/classification delta for metadata and baseline_debt classification policy changes."
        },
        "requirement": {
          "$ref": "#/$defs/requirement_change",
          "description": "Optional structured requirement delta for requirement_loosened and requirement_tightened policy changes."
        },
        "policy_status": {
          "$ref": "#/$defs/policy_status_change",
          "description": "Optional structured top-level policy status delta for policy_status_weakened, policy_status_tightened, and policy_status_changed policy changes."
        }
      }
    },
    "exception_identity_change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "before", "after"],
      "properties": {
        "field": {
          "$ref": "#/$defs/exception_identity_change_field",
          "description": "Governed exception identity field that changed."
        },
        "before": {
          "type": ["string", "null"],
          "description": "Governed exception identity value before the policy change when available."
        },
        "after": {
          "type": ["string", "null"],
          "description": "Governed exception identity value after the policy change when available."
        }
      }
    },
    "exception_identity_change_field": {
      "enum": ["kind", "family"]
    },
    "evidence_change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "removed", "added"],
      "properties": {
        "field": {
          "$ref": "#/$defs/evidence_change_field",
          "description": "Policy traceability collection that changed."
        },
        "removed": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Evidence or link values removed by the policy change."
        },
        "added": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Evidence or link values added by the policy change."
        }
      }
    },
    "evidence_change_field": {
      "enum": ["evidence", "links"]
    },
    "metadata_change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "before", "after"],
      "properties": {
        "field": {
          "$ref": "#/$defs/metadata_change_field",
          "description": "Policy metadata field that changed."
        },
        "before": {
          "type": ["string", "null"],
          "description": "Policy metadata value before the policy change when available."
        },
        "after": {
          "type": ["string", "null"],
          "description": "Policy metadata value after the policy change when available."
        }
      }
    },
    "metadata_change_field": {
      "enum": ["owner", "reason", "classification"]
    },
    "requirement_change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "before", "after"],
      "properties": {
        "field": {
          "$ref": "#/$defs/requirement_change_field",
          "description": "Policy requirement field that changed."
        },
        "before": {
          "type": "boolean",
          "description": "Requirement value before the policy change."
        },
        "after": {
          "type": "boolean",
          "description": "Requirement value after the policy change."
        }
      }
    },
    "requirement_change_field": {
      "enum": [
        "owner_required",
        "reason_required",
        "classification_required",
        "evidence_required",
        "expires_or_review_after_required",
        "allow_bare_allow_attributes",
        "lint_policy_id_required",
        "stale_entries_fail",
        "unsafe.evidence_required",
        "unsafe.safety_comment_required"
      ]
    },
    "policy_status_change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before", "after"],
      "properties": {
        "before": {
          "type": ["string", "null"],
          "description": "Policy status value before the policy change when available."
        },
        "after": {
          "type": ["string", "null"],
          "description": "Policy status value after the policy change when available."
        }
      }
    },
    "lifecycle_change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "before", "after"],
      "properties": {
        "field": {
          "$ref": "#/$defs/lifecycle_change_field",
          "description": "Lifecycle field that changed."
        },
        "before": {
          "type": ["string", "null"],
          "description": "Lifecycle value before the policy change when available."
        },
        "after": {
          "type": ["string", "null"],
          "description": "Lifecycle value after the policy change when available."
        }
      }
    },
    "lifecycle_change_field": {
      "enum": ["created", "expires", "review_after"]
    },
    "occurrence_limit_change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before", "after"],
      "properties": {
        "before": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "Allowed occurrence count before the policy change, or null when unset."
        },
        "after": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "Allowed occurrence count after the policy change, or null when unset."
        }
      }
    },
    "scope_change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "before", "after"],
      "properties": {
        "field": {
          "$ref": "#/$defs/scope_change_field",
          "description": "Scope carrier that changed, or effective when the scope moved between carriers."
        },
        "before": {
          "type": ["string", "null"],
          "description": "Normalized source-tree scope before the policy change when available."
        },
        "after": {
          "type": ["string", "null"],
          "description": "Normalized source-tree scope after the policy change when available."
        }
      }
    },
    "scope_change_field": {
      "enum": ["path", "glob", "selector.glob", "effective"]
    },
    "selector_identity_change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["changed_fields"],
      "properties": {
        "changed_fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/selector_identity_change_field"
          },
          "description": "Structural selector fields whose normalized values changed without changing selector precision."
        }
      }
    },
    "selector_identity_change_field": {
      "enum": [
        "ast_kind",
        "container",
        "callee",
        "macro_name",
        "lint",
        "symbol",
        "receiver_fingerprint",
        "target_fingerprint",
        "normalized_snippet_hash"
      ]
    },
    "selector_precision_change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before", "after", "removed_fields", "added_fields"],
      "properties": {
        "before": {
          "type": "integer",
          "minimum": 0,
          "description": "Selector precision score before the policy change."
        },
        "after": {
          "type": "integer",
          "minimum": 0,
          "description": "Selector precision score after the policy change."
        },
        "removed_fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/selector_precision_field"
          },
          "description": "Selector fields that were present before the change and absent after it."
        },
        "added_fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/selector_precision_field"
          },
          "description": "Selector fields that were absent before the change and present after it."
        }
      }
    },
    "selector_precision_field": {
      "enum": [
        "path",
        "glob",
        "family",
        "ast_kind",
        "container",
        "callee",
        "macro_name",
        "lint",
        "symbol",
        "receiver_fingerprint",
        "target_fingerprint",
        "normalized_snippet_hash",
        "occurrence_limit"
      ]
    },
    "match_status": {
      "enum": [
        "matched",
        "new",
        "stale",
        "expired",
        "review_due",
        "location_drift",
        "ambiguous",
        "invalid_selector",
        "missing_required_field",
        "evidence_missing",
        "baseline_debt"
      ]
    }
  }

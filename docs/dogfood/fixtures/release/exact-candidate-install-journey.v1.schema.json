{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://effortlessmetrics.dev/schemas/cargo-allow/exact-candidate-install-journey.v1.schema.json",
  "title": "cargo-allow ExactCandidateInstallJourney v1",
  "description": "Receipt binding the canonical exact-candidate package-set proof to an isolated installed cargo-allow first-hour journey. Not a cargo-allow CLI product artifact.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema_id",
    "tool",
    "result",
    "claim_boundary",
    "candidate",
    "provenance",
    "install",
    "journey",
    "negative_controls",
    "cleanup",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "schema_id": {
      "const": "cargo-allow.exact-candidate-install-journey.v1"
    },
    "tool": { "const": "cargo-allow" },
    "result": {
      "type": "string",
      "enum": [
        "Passed",
        "CandidatePackageInvalid",
        "JourneyInvalid",
        "CheckoutIsolated",
        "SiblingMismatch",
        "ArtifactInvalid",
        "CleanupFailed",
        "InstrumentFailure",
        "TimedOut",
        "Cancelled"
      ]
    },
    "claim_boundary": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspace_version",
        "git_head",
        "crate_set_schema_id",
        "crate_count"
      ],
      "properties": {
        "workspace_version": { "type": "string", "minLength": 1 },
        "git_head": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "crate_set_schema_id": {
          "const": "cargo-allow.candidate-crate-set.v1"
        },
        "crate_count": { "type": "integer", "minimum": 1 }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_set_schema_id",
        "journey_schema_id",
        "package_set_receipt_sha256",
        "journey_receipt_sha256",
        "candidate_fixture_sha256",
        "candidate_topology_sha256",
        "installed_binary_sha256",
        "crate_order"
      ],
      "properties": {
        "candidate_topology_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "installed_binary_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "package_set_schema_id": {
          "const": "cargo-allow.exact-candidate-package-set.v1"
        },
        "journey_schema_id": {
          "const": "cargo-allow.source-candidate-smoke-receipt.v1"
        },
        "package_set_receipt_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "journey_receipt_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "candidate_fixture_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "crate_order": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "install": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "version_output",
        "source_checkout_denied",
        "observed_source_fallback_paths_hidden",
        "path_redacted"
      ],
      "properties": {
        "method": {
          "const": "cargo_install_path_extracted_with_local_registry"
        },
        "version_output": { "type": "string", "minLength": 1 },
        "source_checkout_denied": { "const": true },
        "observed_source_fallback_paths_hidden": { "const": true },
        "path_redacted": { "const": true }
      }
    },
    "journey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_step",
        "repair_or_rollback_step",
        "artifact_schema_ids",
        "steps_expected",
        "steps_executed"
      ],
      "properties": {
        "finding_step": { "const": "audit_with_finding" },
        "repair_or_rollback_step": {
          "const": "policy_rollback_after_prune"
        },
        "artifact_schema_ids": {
          "type": "array",
          "minItems": 6,
          "items": { "type": "string", "minLength": 1 }
        },
        "steps_expected": {
          "type": "array",
          "const": [
            "version",
            "doctor_no_policy",
            "audit_with_finding",
            "bootstrap_propose_write",
            "check_no_new_pass",
            "list_explain_worklist",
            "refresh_location_drift_preview_write",
            "diff_against_exact_base",
            "prune_stale_preview_write",
            "final_check_no_new",
            "policy_rollback_after_prune",
            "second_finding_why_plan_add",
            "targeted_recheck_after_add",
            "list_wide_projection",
            "clean_repo_init_audit_check"
          ],
          "minItems": 15,
          "items": { "type": "string", "minLength": 1 }
        },
        "steps_executed": {
          "type": "array",
          "minItems": 15,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "exit_code"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "exit_code": { "const": 0 },
              "artifact_schema_id": { "type": ["string", "null"] }
            }
          }
        }
      }
    },
    "negative_controls": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "result_class", "passed"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "result_class": { "type": "string", "minLength": 1 },
          "passed": { "const": true },
          "detail": { "type": "string" }
        }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "temporary_consumer_removed",
        "temporary_config_removed",
        "journey_artifacts_removed",
        "durable_exact_candidate_install_preserved"
      ],
      "properties": {
        "temporary_consumer_removed": { "const": true },
        "temporary_config_removed": { "const": true },
        "journey_artifacts_removed": { "const": true },
        "durable_exact_candidate_install_preserved": { "const": true }
      }
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}

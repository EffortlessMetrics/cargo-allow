{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://effortlessmetrics.dev/schemas/cargo-allow/exact-upgrade-rollback-journey.v1.schema.json",
  "title": "cargo-allow ExactUpgradeRollbackJourney v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema_id",
    "tool",
    "result",
    "upgrade_verdict",
    "rollback_verdict",
    "claim_boundary",
    "from",
    "candidate",
    "rollback",
    "repository",
    "fixtures",
    "surface_dispositions",
    "mutation_journey",
    "steps",
    "negative_controls",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "schema_id": { "const": "cargo-allow.exact-upgrade-rollback-journey.v1" },
    "tool": { "const": "cargo-allow" },
    "result": {
      "enum": ["Passed", "UpgradeBlocked", "RollbackBlocked", "InstrumentFailure"]
    },
    "upgrade_verdict": {
      "enum": ["SupportedUpgrade", "MigrationRequired", "UpgradeBlocked", "Partial"]
    },
    "rollback_verdict": {
      "enum": ["RollbackSupported", "RollbackRequiresRestore", "RollbackBlocked", "InstrumentFailure"]
    },
    "claim_boundary": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "from": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "binary_sha256", "install_root_id"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "binary_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "install_root_id": { "type": "string", "minLength": 1 }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "binary_sha256", "package_set_receipt_sha256", "git_head"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "binary_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "package_set_receipt_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "git_head": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "binary_sha256",
        "install_root_id",
        "restored_preimage",
        "owned_restore_only",
        "preimage_policy_sha256",
        "restored_policy_sha256",
        "restored_modified_files",
        "removed_owned_files",
        "preserved_unrelated_files",
        "semantic_parity_restored"
      ],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "binary_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "install_root_id": { "type": "string", "minLength": 1 },
        "restored_preimage": { "type": "boolean" },
        "owned_restore_only": { "type": "boolean" },
        "preimage_policy_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "restored_policy_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "restored_modified_files": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "removed_owned_files": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "preserved_unrelated_files": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 1 }
        },
        "semantic_parity_restored": { "type": "boolean" }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixture_sha256",
        "unrelated_file_preserved",
        "unrelated_output_root_file_preserved",
        "source_checkout_not_used_as_binary",
        "optional_profiles_absent"
      ],
      "properties": {
        "fixture_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "unrelated_file_preserved": { "type": "boolean" },
        "unrelated_output_root_file_preserved": { "type": "boolean" },
        "source_checkout_not_used_as_binary": { "type": "boolean" },
        "optional_profiles_absent": { "type": "boolean" }
      }
    },
    "fixtures": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "policy_sha256",
          "pre_upgrade_allow_ids",
          "post_rollback_allow_ids",
          "baseline_debt_ids",
          "location_drift_ids",
          "stale_ids",
          "optional_profiles_absent",
          "unrelated_controls"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "policy_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "pre_upgrade_allow_ids": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "post_rollback_allow_ids": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "baseline_debt_ids": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "location_drift_ids": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "stale_ids": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "optional_profiles_absent": { "type": "boolean" },
          "unrelated_controls": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "pre_sha256",
                "post_candidate_sha256",
                "post_rollback_sha256",
                "preserved"
              ],
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "pre_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                "post_candidate_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                "post_rollback_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                "preserved": { "type": "boolean" }
              }
            }
          }
        }
      }
    },
    "surface_dispositions": {
      "type": "array",
      "minItems": 13,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["surface", "category", "disposition", "evidence_step_ids", "notes"],
        "properties": {
          "surface": { "type": "string", "minLength": 1 },
          "category": { "enum": ["policy", "command", "artifact", "mutation", "diff"] },
          "disposition": {
            "enum": [
              "ReadUnchanged",
              "ReadWithCompatibleProjection",
              "ExplicitMigrationRequired",
              "TransactionInputRejectedAsStale",
              "UnsupportedGeneration",
              "RemovedWithGuidance"
            ]
          },
          "evidence_step_ids": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "notes": { "type": "string", "minLength": 1 }
        }
      }
    },
    "mutation_journey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pre_policy_sha256",
        "post_readonly_policy_sha256",
        "post_mutation_policy_sha256",
        "refresh",
        "prune",
        "migrate",
        "stale_plan_rejection",
        "owned_write_set"
      ],
      "properties": {
        "pre_policy_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "post_readonly_policy_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "post_mutation_policy_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "refresh": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "target_allow_id",
            "preview_unchanged_policy",
            "preview_apply_agree",
            "mutation_receipt_schema_id",
            "mutation_result"
          ],
          "properties": {
            "target_allow_id": { "type": "string", "minLength": 1 },
            "preview_unchanged_policy": { "type": "boolean" },
            "preview_apply_agree": { "type": "boolean" },
            "mutation_receipt_schema_id": { "const": "cargo-allow.refresh.v1" },
            "mutation_result": { "const": "written" }
          }
        },
        "prune": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "removed_allow_ids",
            "preview_unchanged_policy",
            "preview_apply_agree",
            "mutation_receipt_schema_id",
            "mutation_result"
          ],
          "properties": {
            "removed_allow_ids": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "preview_unchanged_policy": { "type": "boolean" },
            "preview_apply_agree": { "type": "boolean" },
            "mutation_receipt_schema_id": { "const": "cargo-allow.prune.v1" },
            "mutation_result": { "const": "written" }
          }
        },
        "migrate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "output_path",
            "output_sha256",
            "summary_schema_id",
            "preserved_allow_ids",
            "validated_with_check"
          ],
          "properties": {
            "output_path": { "type": "string", "minLength": 1 },
            "output_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "summary_schema_id": { "type": "string", "minLength": 1 },
            "preserved_allow_ids": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "validated_with_check": { "type": "boolean" }
          }
        },
        "stale_plan_rejection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "plan_path",
            "rejected_nonzero",
            "policy_unchanged",
            "disposition"
          ],
          "properties": {
            "plan_path": { "type": "string", "minLength": 1 },
            "rejected_nonzero": { "type": "boolean" },
            "policy_unchanged": { "type": "boolean" },
            "disposition": { "const": "TransactionInputRejectedAsStale" }
          }
        },
        "owned_write_set": {
          "type": "object",
          "additionalProperties": false,
          "required": ["modified_files", "created_owned_files"],
          "properties": {
            "modified_files": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "created_owned_files": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["leg", "id", "exit_code"],
        "properties": {
          "leg": { "enum": ["from", "candidate", "rollback"] },
          "id": { "type": "string", "minLength": 1 },
          "exit_code": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "negative_controls": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "result_class", "passed"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "result_class": { "type": "string", "minLength": 1 },
          "passed": { "type": "boolean" }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
